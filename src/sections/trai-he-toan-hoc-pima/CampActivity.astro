---
/*
  CampActivity: "Định hướng học thuật, phát triển toàn diện" on a light lime band, then the
  three camp activities (photo, title, text) from camp-activities.ts. Used by
  trai-he-toan-hoc-pima (old `section_camp-activity`). Its heading and lead repeat
  CampIntro's, as on the old page (content work, spec #15). Fades up on scroll.
*/
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { fluidWidths } from "../../lib/image-widths";
import { campActivities } from "./camp-activities";
---

<Section name="camp-activity" spacing="large" tone="surface" animate>
  <div class="intro">
    <div class="text">
      <h2>Định hướng học thuật, phát triển toàn diện</h2>
      <p class="lead">
        Trại hè PiMA là chương trình trại hè hàng năm về Toán học và ứng dụng, diễn ra trong 2 tuần dưới hình thức học
        tập và sinh hoạt tập trung. Chương trình hỗ trợ toàn bộ chi phí học tập và sinh hoạt, dành cho học sinh THPT
        trên toàn quốc ứng tuyển tham gia, với mục tiêu:
      </p>
    </div>
  </div>
  <div class="activities">
    {
      campActivities.map((a) => (
        <div>
          <div class="photo">
            <Image
              src={a.image}
              alt={a.alt}
              widths={fluidWidths(a.image)}
              sizes="(max-width: 767px) 90vw, (max-width: 991px) 28vw, 299px"
              class="photo-img"
            />
          </div>
          <h3 class="activity-title">{a.title}</h3>
          <p>{a.text}</p>
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* The text takes two of three columns. */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto;
    grid-auto-columns: 1fr;
    gap: 16px;
  }

  .text {
    grid-column: span 2;
  }

  .lead {
    margin-bottom: 1rem;
    color: var(--color-text);
    text-align: left;
  }

  /* padding-top: the old spacer between the intro and the activities. */
  .activities {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto;
    grid-auto-columns: 1fr;
    gap: 4rem;
    align-items: start;
    padding-top: 2rem;
  }

  .photo {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .photo-img {
    box-sizing: border-box;
    object-fit: cover;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: clip;
  }

  .activity-title {
    font-size: var(--font-size-heading-style-h6);
    font-weight: var(--font-weight-heading-style);
    line-height: var(--line-height-heading-style-h6);
  }

  @media screen and (max-width: 991px) {
    .activities {
      column-gap: 2rem;
      padding-top: 1.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .activities {
      grid-template-columns: 1fr;
      row-gap: 3rem;
      padding-top: 1.25rem;
    }
  }

  @media screen and (max-width: 479px) {
    .intro {
      display: block;
    }
  }
</style>
