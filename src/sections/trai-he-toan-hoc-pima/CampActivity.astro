---
/*
  CampActivity: "Các hoạt động chính" on a light lime band, a lead-in from the impact report
  (ch. 05.1), then the three camp activities (photo, title, text) from camp-activities.ts.
  Used by trai-he-toan-hoc-pima (old `section_camp-activity`).
*/
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { fluidWidths } from "../../lib/image-widths";
import { campActivities } from "./camp-activities";
---

<Section name="camp-activity" spacing="large" tone="surface">
  <div class="intro">
    <div class="text">
      <h2>Các hoạt động chính</h2>
      <p class="lead">
        Trại hè PiMA gồm ba hoạt động chính: các buổi học về Toán cao cấp, mô hình ứng dụng và lập trình, các buổi tọa
        đàm với diễn giả khách mời, và hoạt động làm dự án nghiên cứu theo nhóm.
      </p>
    </div>
  </div>
  <div class="activities">
    {
      campActivities.map((a) => (
        <div>
          <div class="photo">
            <Image
              src={a.image}
              alt={a.alt}
              widths={fluidWidths(a.image)}
              sizes="(max-width: 767px) 90vw, (max-width: 991px) 28vw, 299px"
              class="photo-img"
            />
          </div>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* The text takes two of three columns. */
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto;
    grid-auto-columns: 1fr;
    gap: var(--space-4);
  }

  .text {
    grid-column: span 2;
  }

  .lead {
    margin-bottom: var(--space-4);
    color: var(--color-text);
    text-align: left;
  }

  /* padding-top: the old spacer between the intro and the activities. */
  .activities {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto;
    grid-auto-columns: 1fr;
    gap: var(--space-16);
    align-items: start;
    padding-top: var(--space-8);
  }

  .photo {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .photo-img {
    box-sizing: border-box;
    object-fit: cover;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: clip;
  }

  @media screen and (max-width: 991px) {
    .activities {
      column-gap: var(--space-8);
      padding-top: var(--space-6);
    }
  }

  @media screen and (max-width: 767px) {
    .activities {
      grid-template-columns: 1fr;
      row-gap: var(--space-12);
      padding-top: var(--space-5);
    }
  }

  @media screen and (max-width: 479px) {
    .intro {
      display: block;
    }
  }
</style>
