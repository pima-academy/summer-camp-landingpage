---
/*
  CampHistory: "Hành trình học thuật qua các mùa trại", a sticky intro next to a stack of
  sticky cards, one per camp year of the camp archive (src/sections/camp-archive/years/),
  newest first. Each card's "Xem chi tiết" links that year's camp archive page, and stretches
  over the whole card, so a click anywhere on it opens that page. Used by
  trai-he-toan-hoc-pima (old `section_camp-history`). Fades up on scroll.
*/
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
import { campYears } from "../camp-archive/camp-years";

const newestFirst = [...campYears].reverse();
---

<Section name="camp-history" id="cac-mua-trai" spacing="large" animate>
  <div class="layout">
    <div class="intro">
      <div class="crumb">
        <Kicker flush>Các chủ đề trại hè</Kicker>
      </div>
      <h2>Hành trình học thuật qua các mùa trại</h2>
      <p class="lead">
        Mỗi trại hè PiMA mang một chủ đề riêng, xoay quanh các lĩnh vực Toán học hiện đại và ứng dụng thực tiễn. Từ tối
        ưu hóa, học máy đến khoa học dữ liệu và sinh học tính toán, chương trình giúp học sinh khám phá chiều sâu của Toán
        học và các hướng nghiên cứu liên ngành.
      </p>
    </div>
    <div>
      {
        newestFirst.map((y) => (
          <div class="camp" data-tone="white">
            <h3 class="year">{y.year}</h3>
            <p>
              {y.topic.vi} - {y.topic.en}
            </p>
            <a href={`/trai-he-toan-hoc-pima/${y.year}/`} class="more">
              Xem chi tiết &gt;
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    grid-auto-columns: 1fr;
    column-gap: var(--space-20);
    row-gap: var(--space-16);
    align-items: start;
  }

  /* The intro stays in view while the cards scroll past (desktop and tablet). */
  .intro {
    position: sticky;
    top: 30%;
  }

  .crumb {
    margin-bottom: var(--space-2);
  }

  .lead {
    margin-bottom: var(--space-4);
    color: var(--color-text);
    text-align: left;
  }

  /* Sticky cards: each one stops under the previous as the column scrolls. */
  .camp {
    position: sticky;
    top: 30%;
    margin-bottom: var(--space-8);
    padding: var(--space-1) var(--space-8) var(--space-4);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius);
  }

  .camp:last-child {
    top: 36%;
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .year {
    margin-bottom: var(--space-2);
    color: var(--color-text-accent);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-body);
    font-variant-numeric: tabular-nums;
  }

  .more {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  /* The link covers its card (positioned: sticky), so the whole card is the target. */
  .more::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .camp:hover .more {
    color: var(--color-link-hover);
  }

  @media screen and (max-width: 991px) {
    .layout {
      column-gap: var(--space-12);
    }
  }

  @media screen and (max-width: 767px) {
    .layout {
      grid-template-columns: 1fr;
      row-gap: var(--space-12);
    }

    .intro {
      position: static;
    }
  }
</style>
