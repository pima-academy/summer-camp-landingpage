---
// Hero: the 2024 camp's title band (breadcrumb and h1 at the bottom of a 28rem dark-green
// band). Used by chi-tiet-trai-he (old `section_camp-detail_hero`).
import BrandName from "../../components/BrandName.astro";
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
---

<Section name="hero" spacing="none" tone="dark-green" class="hero">
  <div class="bottom">
    <div class="inner">
      <div class="lead">
        <div class="crumb"><Kicker flush><BrandName /> academy &gt; chương trình &gt; trại hè 2024</Kicker></div>
        <h1 class="title">Quy hoạch Tuyến tính- Linear Programming</h1>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Fixed-height band; the content sits on its bottom edge, positioned against the band, so
     Section's gutter does not move it. */
  .hero {
    position: relative;
    height: 28rem;
  }

  .bottom {
    position: absolute;
    inset: auto 0% 0%;
    padding: var(--space-8);
  }

  /* Section's width="medium" column (layout tokens), as a 3-column grid. */
  .inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-auto-columns: 1fr;
    gap: var(--space-4);
    align-items: center;
    width: 100%;
    max-width: var(--width-medium);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--gutter-medium);
    padding-right: var(--gutter-medium);
  }

  .lead {
    grid-column: span 2;
  }

  .crumb {
    margin-bottom: var(--space-4);
    text-align: left;
  }

  .title {
    color: var(--color-text-heading);
  }

  @media screen and (max-width: 991px) {
    .bottom {
      padding: var(--space-6);
    }
  }

  @media screen and (max-width: 767px) {
    .bottom {
      padding: var(--space-5);
    }
  }
</style>
