---
// Hero: the 2024 camp's title band (breadcrumb and h1 at the bottom of a 28rem green band
// under a dark overlay). Used by chi-tiet-trai-he (old `section_camp-detail_hero`).
import BrandName from "../../components/BrandName.astro";
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
---

<Section name="hero" spacing="none" tone="dark-green" class="hero">
  <div class="bottom">
    <div class="inner">
      <div class="lead">
        <div class="crumb"><Kicker flush><BrandName /> academy &gt; chương trình &gt; trại hè 2024</Kicker></div>
        <h1 class="title">Quy hoạch Tuyến tính- Linear Programming</h1>
      </div>
    </div>
  </div>
  <div class="backdrop">
    <div class="overlay"></div>
  </div>
</Section>

<style>
  /* Fixed-height band; the content sits on its bottom edge, over the backdrop. Both are
     positioned against the band, so Section's gutter does not move them. */
  .hero {
    position: relative;
    height: 28rem;
  }

  .bottom {
    position: absolute;
    inset: auto 0% 0%;
    padding: 2rem;
  }

  /* The width="medium" column, as a 3-column grid. */
  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-auto-columns: 1fr;
    gap: 16px;
    align-items: center;
    width: 100%;
    max-width: 64rem;
    margin-left: auto;
    margin-right: auto;
  }

  .lead {
    grid-column: span 2;
  }

  .crumb {
    margin-bottom: 1rem;
    text-align: left;
  }

  .title {
    color: var(--color-text-heading);
  }

  .backdrop {
    position: absolute;
    inset: 0%;
    z-index: 0;
    background-color: var(--color-background-accent);
  }

  .overlay {
    position: absolute;
    inset: 0%;
    z-index: 1;
    background-color: var(--color-video-overlay);
  }

  @media screen and (max-width: 991px) {
    .bottom {
      padding: 1.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .bottom {
      padding: 1.25rem;
    }

    .inner {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  @media screen and (max-width: 479px) {
    .inner {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
