---
// Gallery: "Hình ảnh trại hè", a two-up slider of placeholder photos (a content gap: the page
// wraps it in ContentGap; each photo's lightbox link is a gap of its own). Used by
// chi-tiet-trai-he (old `section_camp-detail_certificates`).
import { Image } from "astro:assets";
import ContentGap from "../../components/ContentGap.astro";
import Section from "../../components/Section.astro";
import Slider from "../../components/Slider.astro";
import { fluidWidths } from "../../lib/image-widths";
import placeholder from "../../assets/images/6191a88a1c0e39463c2bf022-placeholder-image.svg";

// Photo = slide width minus 2 x 1rem (0.75rem below 768) padding; the mask is
// 50% of the 64rem column from 768 px up, 100% below.
const photoSizes = "(max-width: 767px) calc(100vw - 24px), (max-width: 1024px) calc(50vw - 32px), 480px";
const slides = Array.from({ length: 6 });
---

<Section name="gallery" spacing="medium">
  <h2 class="title">Hình ảnh trại hè</h2>
  <Slider layout="half" label="Hình ảnh trại hè">
    {
      slides.map(() => (
        <div>
          <ContentGap name="chi-tiet-trai-he: certificate lightbox" inline>
            <a href="#" class="photo-link">
              <div class="photo">
                <Image src={placeholder} alt="" widths={fluidWidths(placeholder)} sizes={photoSizes} class="photo-img" />
              </div>
            </a>
            <Fragment slot="fallback">
              <div class="photo-link">
                <div class="photo">
                  <Image src={placeholder} alt="" widths={fluidWidths(placeholder)} sizes={photoSizes} class="photo-img" />
                </div>
              </div>
            </Fragment>
          </ContentGap>
        </div>
      ))
    }
  </Slider>
</Section>

<style>
  .title {
    text-align: center;
  }

  .photo-link {
    display: inline-block;
    width: 100%;
    max-width: 100%;
  }

  .photo {
    width: 100%;
    overflow: hidden;
  }

  .photo-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>
