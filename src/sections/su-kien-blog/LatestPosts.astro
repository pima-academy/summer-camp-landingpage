---
/*
  LatestPosts: "Bài viết mới nhất" on the gap page /su-kien-blog/
  (src/gap-pages/su-kien-blog.astro). A template for one post card in a three-column
  list (image, tag, title, summary; all empty and `hidden`, as the old site's empty
  CMS bindings were) and the empty-list box "No items found.". Replaces the old
  `section_blog5` / `blog5_*` / `collection-list-wrapper-2` markup.
*/
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import placeholder from "../../assets/images/placeholder-image-landscape.svg";
---

<Section name="latest-posts" spacing="medium" animate>
  <h2 class="title">Bài viết mới nhất</h2>
  <div class="list">
    <div role="list" class="cards">
      <div role="listitem" class="cell">
        <div class="post-card">
          <a href="#" class="card-link">
            <div class="media">
              <Image src={placeholder} alt="" class="cover" hidden />
              <div class="tag" hidden></div>
            </div>
            <h3 class="card-title" hidden></h3>
            <div class="summary" hidden></div>
          </a>
        </div>
      </div>
    </div>
    <div class="empty">
      <div>No items found.</div>
    </div>
  </div>
</Section>

<style>
  .title {
    text-align: left;
  }

  .list {
    padding-top: var(--space-8);
  }

  .cards {
    display: flow-root;
  }

  .cell {
    position: relative;
    float: left;
    width: 33.33333333%;
    min-height: 1px;
    margin-bottom: var(--space-4);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }

  .post-card {
    max-height: 21rem;
    margin-bottom: var(--space-8);
  }

  .card-link {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }

  .media {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-2);
    overflow: clip;
  }

  .cover {
    width: 100%;
    max-width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .tag {
    display: inline-flex;
    position: absolute;
    inset: 2% auto auto 5%;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 2px solid transparent;
    border-radius: var(--radius);
    background-color: var(--color-background-pale-lime);
    color: var(--color-text);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-tag);
    text-transform: uppercase;
  }

  .card-title {
    margin-bottom: var(--space-1);
    color: var(--color-text);
  }

  .summary {
    overflow: hidden;
    color: var(--color-text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* An empty Webflow CMS list, kept from the old site; dev only like the whole gap page. */
  .empty {
    padding: var(--space-3);
    background-color: var(--color-background-empty-list);
  }

  @media screen and (max-width: 991px) {
    .list {
      padding-top: var(--space-6);
    }
  }

  @media screen and (max-width: 767px) {
    .list {
      padding-top: var(--space-5);
    }

    .cell {
      width: 100%;
    }
  }

  /* Empty CMS bindings (old `w-dyn-bind-empty`); after the rules above so it wins. */
  [hidden] {
    display: none;
  }
</style>
