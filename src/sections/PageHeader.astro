---
// PageHeader: the page's opening on a surface band, in the grammar of the Về chúng tôi and
// Liên hệ openings: the "PiMA academy > chương trình" breadcrumb kicker over the page title,
// an h1 in display type (display-2, never below the h1 size). Used by khoa-hoc and
// trai-he-toan-hoc-pima (old `section_camp-header`). Besides the title,
// trai-he-toan-hoc-pima asks for the camp years, linked under the title (CampYearNav).
import BrandName from "../components/BrandName.astro";
import CampYearNav from "../components/CampYearNav.astro";
import Kicker from "../components/Kicker.astro";
import Section from "../components/Section.astro";

interface Props {
  /** The page title (the <h1>). */
  title: string;
  /** Link every camp year under the title (the camp overview page). */
  campYears?: boolean;
}

const { title, campYears } = Astro.props;
---

<Section name="page-header" spacing="none" tone="surface">
  <div class="inner">
    <Kicker flush><BrandName /> academy &gt; chương trình</Kicker>
    <h1 class="title">{title}</h1>
    {
      campYears && (
        <div class="years">
          <CampYearNav />
        </div>
      )
    }
  </div>
</Section>

<style>
  /* The top padding clears the fixed nav, as in the Về chúng tôi opening. */
  .inner {
    padding-top: var(--space-32);
    padding-bottom: var(--space-16);
  }

  /* Display type, not the h1 role: the page's one big moment (docs/brand.md, Display). */
  .title {
    margin: var(--space-4) 0 0;
    color: var(--color-text-heading);
    font-size: max(var(--font-size-h1), var(--font-size-display-2));
    font-weight: var(--font-weight-black);
    letter-spacing: var(--letter-spacing-display);
    line-height: var(--line-height-display);
  }

  .years {
    margin-top: var(--space-10);
  }

  @media screen and (max-width: 991px) {
    .inner {
      padding-top: var(--space-28);
      padding-bottom: var(--space-12);
    }

    .years {
      margin-top: var(--space-8);
    }
  }

  @media screen and (max-width: 767px) {
    .inner {
      padding-top: var(--space-24);
    }

    .years {
      margin-top: var(--space-6);
    }
  }
</style>
