---
// Page title header with the "PiMA academy > chương trình" breadcrumb (old
// `section_camp-header`, on khoa-hoc and trai-he-toan-hoc-pima; only the title differs).
// Fades up on scroll.
import BrandName from "../components/BrandName.astro";

interface Props {
  /** The page title (the <h1>). */
  title: string;
}

const { title } = Astro.props;
---

<header data-animate="fade-up" class="section_camp-header">
  <div class="padding-global">
    <div class="container-medium">
      <div class="padding-section-large">
        <div class="header45_component">
          <div class="max-width-large">
            <div class="margin-bottom margin-xsmall">
              <div class="text-style-tagline text-block-7"><BrandName /> academy &gt; chương trình</div>
            </div>
            <div class="margin-bottom margin-small">
              <h1 class="heading-style-h1">{title}</h1>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Defect fix: at <= 767 px `.padding-section-large` drops to 4rem (64 px), so the breadcrumb
     sat under the 72 px fixed nav. Keep the tablet top padding (6rem) here: the breadcrumb
     clears the nav by 24 px, as it does at 768-991 px. */
  @media screen and (max-width: 767px) {
    .padding-section-large {
      padding-top: 6rem;
    }
  }
</style>
