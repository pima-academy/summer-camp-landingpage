---
// PageHeader: the page title band with the "PiMA academy > chương trình" breadcrumb. Used by
// khoa-hoc and trai-he-toan-hoc-pima (old `section_camp-header`); only the title differs.
// Fades up on scroll.
import BrandName from "../components/BrandName.astro";
import Kicker from "../components/Kicker.astro";
import Section from "../components/Section.astro";

interface Props {
  /** The page title (the <h1>). */
  title: string;
}

const { title } = Astro.props;
---

<Section name="page-header" spacing="none" tone="surface" animate>
  <div class="inner">
    <div class="crumb">
      <Kicker flush><BrandName /> academy &gt; chương trình</Kicker>
    </div>
    <h1 class="title">{title}</h1>
  </div>
</Section>

<style>
  /* Section's spacing="large", except at ≤ 767 px (see below). */
  .inner {
    position: relative;
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  .crumb {
    margin-bottom: 0.5rem;
  }

  .title {
    color: var(--color-text-heading);
  }

  @media screen and (max-width: 991px) {
    .inner {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }
  }

  /* Defect fix: the old 4rem top padding at ≤ 767 px put the breadcrumb under the 72 px
     fixed nav. Keep the tablet top padding (6rem) here: the breadcrumb clears the nav by
     24 px, as it does at 768-991 px. */
  @media screen and (max-width: 767px) {
    .inner {
      padding-bottom: 4rem;
    }
  }
</style>
