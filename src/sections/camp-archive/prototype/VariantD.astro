---
// PROTOTYPE variant D, "Giáo trình": the year read as a mathematics textbook. Every year opens
// the same way: a title page (topic in display type, a colophon with the counts and sessions),
// then the cover as a 12:5 plate. Preface and programme follow when the year has them. Lectures
// are the book's table of contents, numbered because they are a sequence, with dotted leaders
// running to their files. Each project topic is a problem facing its solutions, the group
// reports. Photos are plates at the back.
// Used by /prototype/trai-he-toan-hoc-pima/[year]/ only.
import { Image } from "astro:assets";
import BrandName from "../../../components/BrandName.astro";
import Icon from "../../../components/Icon.astro";
import Section from "../../../components/Section.astro";
import { campusCount, iconFor, sectionPhotos, type CampYear, type DocItem } from "./data";

interface Props { y: CampYear }
const { y } = Astro.props;
const multiCampus = campusCount(y) > 1;
const groups = y.projects?.reduce((n, p) => n + p.groups.length, 0) ?? 0;
const campers = y.projects?.reduce((n, p) => n + p.groups.reduce((m, g) => m + g.campers.length, 0), 0) ?? 0;
const summary = [
  y.lectures?.length && `${y.lectures.length} bài giảng`,
  y.projects?.length && `${y.projects.length} đề tài dự án`,
  groups && `${groups} báo cáo nhóm của ${campers} trại sinh`,
].filter(Boolean);
const summaryText = summary.length > 1 ? `${summary.slice(0, -1).join(", ")} và ${summary.at(-1)}.` : `${summary[0]}.`;
const author = (a: { name: string; affiliation?: string }) => (a.affiliation ? `${a.name} (${a.affiliation})` : a.name);
const shortDocs: { title: string; items?: DocItem[] }[] = [
  { title: "Đề tuyển sinh", items: y.entranceExam },
];
const laterDocs: { title: string; items?: DocItem[] }[] = [
  { title: "Bài tập", items: y.exercises },
  { title: "Tài liệu đọc thêm", items: y.reading },
];
---

<Section name="variant-d-spread" width="large" spacing="none">
  <div class="titlepage">
    <p class="press">Trại hè Toán học và Ứng dụng <BrandName /> {y.year}</p>
    <div class="title-block">
      <h1 class="display">{y.topic.vi}</h1>
      <p class="en">{y.topic.en}</p>
    </div>
    <div class="colophon">
      <p>{summaryText}</p>
      {
        y.sessions && (
          <dl class="sessions">
            {y.sessions.map((s) => (
              <div>
                <dt>{s.campus}</dt>
                <dd>{s.dates}<br />{s.venue}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
  {
    y.cover && (
      <figure class="plate-cover">
        <Image src={y.cover} alt={`Trại sinh và ban tổ chức Trại hè PiMA ${y.year}`} widths={[800, 1200, 1600, 2000, 2880]} sizes="(max-width: 1440px) 90vw, 1280px" class="plate-cover-img" loading="eager" />
      </figure>
    )
  }
</Section>

{
  (y.description || y.programme) && (
    <Section name="variant-d-preface" width="large" spacing="medium">
      <div class="preface">
        {y.description && (
          <div>
            <h2>Lời giới thiệu</h2>
            {y.description.map((p) => <p class="prose">{p}</p>)}
          </div>
        )}
        {y.programme && (
          <div class="page-lime" data-tone="pale-lime">
            <h2 class="page-title">Nội dung chương trình</h2>
            <ol class="programme">{y.programme.map((p) => <li>{p}</li>)}</ol>
          </div>
        )}
      </div>
    </Section>
  )
}

{
  y.team && (
    <Section name="variant-d-credits" width="small" spacing="small">
      <div class="credits">
        {y.team.map((t) => (
          <div>
            <h2 class="credit-role">{t.name}</h2>
            {t.members.map((m) => (
              <p class="credit">
                {m.photo && <Image src={m.photo} alt="" width={96} height={96} class="credit-img" />}
                <span>
                  <strong>{m.name}</strong>
                  <br />
                  <span class="muted">{m.affiliation}</span>
                </span>
              </p>
            ))}
          </div>
        ))}
      </div>
    </Section>
  )
}

<Section name="variant-d-contents" width="large" spacing="medium" class="contents">
  {
    shortDocs.filter((b) => b.items?.length).map((b) => (
      <div class="toc-part">
        <h2>{b.title}</h2>
        <ul class="toc">
          {b.items!.map((it) => (
            <li class="entry">
              <span class="entry-title">{it.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="files">
                {it.files.map((f) => <a href={f.url} target="_blank" rel="noopener">{f.label}</a>)}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  {
    y.lectures && (
      <div class="toc-part">
        <h2>Bài giảng</h2>
        <ol class="toc numbered">
          {y.lectures.map((l, i) => (
            <li class="entry">
              <span class="num">{i + 1}</span>
              <span class="entry-title">
                {l.title}
                {l.fromYear && <span class="muted"> (từ trại hè {l.fromYear})</span>}
              </span>
              <span class="leader" aria-hidden="true" />
              <span class="files">
                {l.files.map((f) => <a href={f.url} target="_blank" rel="noopener" aria-label={`${f.label}, ${l.title}`}>{f.label}</a>)}
              </span>
              {l.authors.length > 0 && <span class="byline">{l.authors.map(author).join(", ")}</span>}
            </li>
          ))}
        </ol>
      </div>
    )
  }
  {
    laterDocs.filter((b) => b.items?.length).map((b) => (
      <div class="toc-part">
        <h2>{b.title}</h2>
        <ul class="toc">
          {b.items!.map((it) => (
            <li class="entry">
              <span class="entry-title">{it.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="files">
                {it.files.map((f) => <a href={f.url} target="_blank" rel="noopener">{f.label}</a>)}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</Section>

{
  y.projects && (
    <Section name="variant-d-problems" width="large" spacing="medium" tone="surface">
      <h2 class="problems-title">Dự án nhóm</h2>
      {y.projects.map((p) => (
        <article class="problem">
          <div class="statement">
            <h3>{p.title}</h3>
            {p.description && <p class="statement-text">{p.description}</p>}
            {p.brief && (
              <a href={p.brief.url} target="_blank" rel="noopener" class="brief">
                <Icon name="file-text" size="16" /> Đọc đề bài
              </a>
            )}
          </div>
          <div class="solutions">
            {p.groups.length === 0 ? (
              <p class="muted">Đề tài này không có báo cáo nhóm.</p>
            ) : (
              p.groups.map((g) => (
                <div class="solution">
                  <p class="solution-head">
                    <strong>{g.reportTitle ?? p.title}</strong>
                    {multiCampus && g.campus && <span class="campus">{g.campus}</span>}
                  </p>
                  <ul class="campers">
                    {g.campers.map((c) => (
                      <li>
                        {c.name} <span class="muted">{c.school}</span>
                      </li>
                    ))}
                  </ul>
                  {g.mentors.length > 0 && <p class="muted small">Mentor {g.mentors.map((m) => m.name).join(", ")}</p>}
                  <p class="sol-files">
                    {g.files.map((f) => (
                      <a href={f.url} target="_blank" rel="noopener">
                        <Icon name={iconFor[f.label]} size="16" />
                        {f.label === "PDF" ? "Báo cáo" : f.label}
                      </a>
                    ))}
                  </p>
                </div>
              ))
            )}
          </div>
        </article>
      ))}
    </Section>
  )
}

{
  y.gallery && (
    <Section name="variant-d-plates" width="large" spacing="medium">
      <h2>Hình ảnh</h2>
      {y.gallery.map((s) => {
        const list = sectionPhotos(y.year, s.folder).slice(0, 5);
        return (
          <section class="plate">
            <div class="plate-caption">
              <h3 class="plate-name">{s.name}</h3>
              <p class="muted small">{s.total} ảnh</p>
              <a href="#" class="small plate-all">Xem cả album</a>
            </div>
            <div class="plate-grid">
              {list.map((ph, k) => (
                <a href={ph.src} class:list={["plate-ph", { lead: k === 0 }]}>
                  <Image src={ph} alt="" widths={[400, 800, 1200]} sizes={k === 0 ? "(max-width: 767px) 90vw, 40vw" : "(max-width: 767px) 45vw, 20vw"} class="plate-img" />
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </Section>
  )
}

<style>
  .muted {
    color: var(--color-text-muted);
  }
  .small {
    font-size: var(--font-size-small);
  }

  /* The title page, then the plate. */
  .titlepage {
    display: grid;
    grid-template-columns: 8fr 4fr;
    column-gap: var(--space-12);
    row-gap: var(--space-8);
    align-items: end;
    padding-top: var(--space-28);
    padding-bottom: var(--space-12);
  }
  .press {
    grid-column: 1 / -1;
    font-weight: var(--font-weight-bold);
    padding-top: var(--space-4);
    border-top: var(--space-1) solid var(--color-background-accent);
  }
  .display {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    font-weight: var(--font-weight-black);
    text-wrap: balance;
  }
  .en {
    margin-top: var(--space-4);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    color: var(--color-text-muted);
  }
  .colophon {
    display: grid;
    gap: var(--space-4);
    font-size: var(--font-size-small);
  }
  .sessions {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .sessions dt {
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text-heading);
  }
  .sessions dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .plate-cover {
    margin: 0 0 var(--space-16);
    position: relative;
    aspect-ratio: 12 / 5;
  }
  .plate-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .preface {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-12);
    align-items: start;
  }
  .page-lime {
    padding: var(--space-10);
    border-radius: var(--radius);
  }
  .page-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .programme {
    margin: var(--space-6) 0 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }
  .programme li::marker {
    font-weight: var(--font-weight-black);
    color: var(--color-text-heading);
  }

  .prose {
    margin-top: var(--space-4);
    max-width: 40rem;
  }
  .credits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .credit-role {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }
  .credit {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-4);
    font-size: var(--font-size-small);
  }
  .credit-img {
    width: var(--space-12);
    height: var(--space-12);
    object-fit: cover;
    flex-shrink: 0;
  }

  /* The table of contents: on the page's left edge, at a reading measure. */
  .contents :global(.column) > * {
    max-width: 60rem;
  }
  .toc-part + .toc-part {
    margin-top: var(--space-16);
  }
  .toc {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
  }
  .entry {
    display: grid;
    grid-template-columns: auto minmax(var(--space-8), 1fr) auto;
    column-gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
  }
  .numbered .entry {
    grid-template-columns: var(--space-10) auto minmax(var(--space-8), 1fr) auto;
  }
  .num {
    font-weight: var(--font-weight-black);
    color: var(--color-text-heading);
    font-variant-numeric: tabular-nums;
  }
  .entry-title {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .leader {
    border-bottom: 2px dotted var(--color-border-field);
    transform: translateY(calc(-1 * var(--space-1)));
  }
  .files {
    display: flex;
    gap: var(--space-3);
  }
  .files a {
    font-weight: var(--font-weight-extrabold);
    color: var(--color-link);
  }
  .byline {
    grid-column: 1 / -1;
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
  .numbered .byline {
    grid-column: 2 / -1;
  }

  /* Problems and their solutions. */
  .problems-title {
    margin-bottom: var(--space-8);
  }
  .problem {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-12);
    padding: var(--space-10) 0;
    border-top: 1px solid var(--color-border-field);
  }
  .statement h3 {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    color: var(--color-text-heading);
  }
  .statement-text {
    margin-top: var(--space-4);
  }
  .brief,
  .sol-files a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-link);
  }
  .brief {
    margin-top: var(--space-4);
  }
  .solutions {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .solution {
    padding-left: var(--space-6);
    border-left: var(--space-1) solid var(--color-background-accent);
  }
  .solution-head {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .campus {
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-heading);
  }
  .campers {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
    display: grid;
    gap: var(--space-1);
  }
  .campers .muted {
    font-size: var(--font-size-small);
  }
  .sol-files {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--font-size-small);
  }

  /* Plates. */
  .plate {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: var(--space-8);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
  }
  .plate:first-of-type {
    margin-top: var(--space-8);
  }
  .plate-name {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }
  .plate-all {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: var(--font-weight-bold);
    color: var(--color-link);
  }
  .plate-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    aspect-ratio: 3 / 1.2;
  }
  .plate-ph {
    position: relative;
    display: block;
    min-height: 0;
  }
  .plate-ph.lead {
    grid-row: span 2;
  }
  .plate-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 991px) {
    .titlepage,
    .preface {
      grid-template-columns: 1fr;
    }
    .problem {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .plate {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
  @media screen and (max-width: 767px) {
    .titlepage {
      padding-top: var(--space-24);
    }
    .plate-cover {
      aspect-ratio: 4 / 3;
    }
    .page-lime {
      padding: var(--space-6);
    }
    .sessions,
    .credits {
      grid-template-columns: 1fr;
    }
    .entry,
    .numbered .entry {
      grid-template-columns: var(--space-8) 1fr;
      row-gap: var(--space-1);
    }
    .entry:not(.numbered .entry) {
      grid-template-columns: 1fr auto;
    }
    .leader {
      display: none;
    }
    .entry-title {
      font-size: var(--font-size-body);
    }
    .numbered .files,
    .numbered .byline {
      grid-column: 2;
    }
    .numbered .files {
      order: 1;
    }
    .plate-grid {
      aspect-ratio: 3 / 2;
    }
  }
</style>

<style>
  :global([data-proto] img) {
    overflow: clip;
  }
</style>
