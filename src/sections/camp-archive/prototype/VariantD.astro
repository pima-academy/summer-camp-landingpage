---
// PROTOTYPE variant D, "Giáo trình": the year read as a mathematics textbook. Every year opens
// the same way: a dark-green book cover, one viewport tall on desktop, holding the cover photo,
// the season, the topic, the camp dates (a calendar block per session) and the counts sentence
// with its numbers set large. Preface and programme follow when the year has them. Lectures
// are the book's table of contents, numbered because they are a sequence, with dotted leaders
// running to their files. Each project topic is a problem facing its solutions, the group
// reports. Photos are plates at the back.
// Used by /prototype/trai-he-toan-hoc-pima/[year]/ only.
import { Image } from "astro:assets";
import BrandName from "../../../components/BrandName.astro";
import Icon from "../../../components/Icon.astro";
import Section from "../../../components/Section.astro";
import { campusCount, iconFor, sectionPhotos, type CampYear, type DocItem } from "./data";

interface Props { y: CampYear }
const { y } = Astro.props;
const multiCampus = campusCount(y) > 1;
const groups = y.projects?.reduce((n, p) => n + p.groups.length, 0) ?? 0;
const campers = y.projects?.reduce((n, p) => n + p.groups.reduce((m, g) => m + g.campers.length, 0), 0) ?? 0;
const summary = [
  y.lectures?.length && `${y.lectures.length} bài giảng`,
  y.projects?.length && `${y.projects.length} đề tài dự án`,
  groups && `${groups} báo cáo nhóm của ${campers} trại sinh`,
].filter(Boolean);
const summaryText = summary.length > 1 ? `${summary.slice(0, -1).join(", ")} và ${summary.at(-1)}.` : `${summary[0]}.`;
// The counts sentence, with each number marked so the hero can set it large.
const counts = {
  lectures: y.lectures?.length ?? 0,
  topics: y.projects?.length ?? 0,
  groups,
  campers,
};
// A session's dates as a calendar block: "02–09" over "tháng 8 năm 2025" within one month,
// "29/07–09/08" over "năm 2019" across two.
const dateParts = (start: string, end: string) => {
  const [sy, sm, sd] = start.split("-");
  const [, em, ed] = end.split("-");
  return sm === em
    ? { days: `${sd}–${ed}`, rest: `tháng ${Number(sm)} năm ${sy}` }
    : { days: `${sd}/${sm}–${ed}/${em}`, rest: `năm ${sy}` };
};
const author = (a: { name: string; affiliation?: string }) => (a.affiliation ? `${a.name} (${a.affiliation})` : a.name);
const shortDocs: { title: string; items?: DocItem[] }[] = [
  { title: "Đề tuyển sinh", items: y.entranceExam },
];
const laterDocs: { title: string; items?: DocItem[] }[] = [
  { title: "Bài tập", items: y.exercises },
  { title: "Tài liệu đọc thêm", items: y.reading },
];
---

<Section name="variant-d-cover" width="large" spacing="none">
  <div class="bookcover" data-tone="dark-green">
    {
      y.cover && (
        <div class="bc-photo">
          <Image src={y.cover} alt={`Trại sinh và ban tổ chức Trại hè PiMA ${y.year}`} widths={[800, 1200, 1600, 2000, 2880]} sizes="(max-width: 1440px) 86vw, 1200px" class="bc-img" loading="eager" />
        </div>
      )
    }
    <div class="bc-text">
      <p class="bc-season">
        <span>Trại hè Toán học và Ứng dụng <BrandName /></span>
        <span class="bc-year">{y.year}</span>
      </p>
      <div class="bc-title">
        <h1 class="bc-display">{y.topic.vi}</h1>
        <p class="bc-en">{y.topic.en}</p>
      </div>
      {
        y.sessions && (
          <dl class="bc-dates">
            {y.sessions.map((s) => {
              const d = dateParts(s.start, s.end);
              return (
                <div class="bc-date">
                  <dt>{s.campus ?? "Thời gian"}</dt>
                  <dd>
                    <span class="bc-days">{d.days}</span>
                    <span class="bc-month">{d.rest}</span>
                    {s.venue && <span class="bc-venue">{s.venue}</span>}
                  </dd>
                </div>
              );
            })}
          </dl>
        )
      }
      <p class="bc-counts">
        {counts.lectures > 0 && <><b>{counts.lectures}</b> bài giảng{counts.topics ? ", " : ""}</>}
        {counts.topics > 0 && <><b>{counts.topics}</b> đề tài dự án </>}
        {counts.groups > 0 && <>và <b>{counts.groups}</b> báo cáo nhóm của <b>{counts.campers}</b> trại sinh</>}.
      </p>
    </div>
  </div>
</Section>

{
  (y.description || y.programme) && (
    <Section name="variant-d-preface" width="large" spacing="medium">
      <div class="preface">
        {y.description && (
          <div>
            <h2>Lời giới thiệu</h2>
            {y.description.map((p) => <p class="prose">{p}</p>)}
          </div>
        )}
        {y.programme && (
          <div class="page-lime" data-tone="pale-lime">
            <h2 class="page-title">Nội dung chương trình</h2>
            <ol class="programme">{y.programme.map((p) => <li>{p}</li>)}</ol>
          </div>
        )}
      </div>
    </Section>
  )
}

{
  y.team && (
    <Section name="variant-d-credits" width="small" spacing="small">
      <div class="credits">
        {y.team.map((t) => (
          <div>
            <h2 class="credit-role">{t.name}</h2>
            {t.members.map((m) => (
              <p class="credit">
                {m.photo && <Image src={m.photo} alt="" width={96} height={96} class="credit-img" />}
                <span>
                  <strong>{m.name}</strong>
                  <br />
                  <span class="muted">{m.affiliation}</span>
                </span>
              </p>
            ))}
          </div>
        ))}
      </div>
    </Section>
  )
}

<Section name="variant-d-contents" width="large" spacing="medium" class="contents">
  {
    shortDocs.filter((b) => b.items?.length).map((b) => (
      <div class="toc-part">
        <h2>{b.title}</h2>
        <ul class="toc">
          {b.items!.map((it) => (
            <li class="entry">
              <span class="entry-title">{it.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="files">
                {it.files.map((f) => <a href={f.url} target="_blank" rel="noopener">{f.label}</a>)}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  {
    y.lectures && (
      <div class="toc-part">
        <h2>Bài giảng</h2>
        <ol class="toc numbered">
          {y.lectures.map((l, i) => (
            <li class="entry">
              <span class="num">{i + 1}</span>
              <span class="entry-title">
                {l.title}
                {l.fromYear && <span class="muted"> (từ trại hè {l.fromYear})</span>}
              </span>
              <span class="leader" aria-hidden="true" />
              <span class="files">
                {l.files.map((f) => <a href={f.url} target="_blank" rel="noopener" aria-label={`${f.label}, ${l.title}`}>{f.label}</a>)}
              </span>
              {l.authors.length > 0 && <span class="byline">{l.authors.map(author).join(", ")}</span>}
            </li>
          ))}
        </ol>
      </div>
    )
  }
  {
    laterDocs.filter((b) => b.items?.length).map((b) => (
      <div class="toc-part">
        <h2>{b.title}</h2>
        <ul class="toc">
          {b.items!.map((it) => (
            <li class="entry">
              <span class="entry-title">{it.title}</span>
              <span class="leader" aria-hidden="true" />
              <span class="files">
                {it.files.map((f) => <a href={f.url} target="_blank" rel="noopener">{f.label}</a>)}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</Section>

{
  y.projects && (
    <Section name="variant-d-problems" width="large" spacing="medium" tone="surface">
      <h2 class="problems-title">Dự án nhóm</h2>
      {y.projects.map((p) => (
        <article class="problem">
          <div class="statement">
            <h3>{p.title}</h3>
            {p.description && <p class="statement-text">{p.description}</p>}
            {p.brief && (
              <a href={p.brief.url} target="_blank" rel="noopener" class="brief">
                <Icon name="file-text" size="16" /> Đọc đề bài
              </a>
            )}
          </div>
          <div class="solutions">
            {p.groups.length === 0 ? (
              <p class="muted">Đề tài này không có báo cáo nhóm.</p>
            ) : (
              p.groups.map((g) => (
                <div class="solution">
                  <p class="solution-head">
                    <strong>{g.reportTitle ?? p.title}</strong>
                    {multiCampus && g.campus && <span class="campus">{g.campus}</span>}
                  </p>
                  <ul class="campers">
                    {g.campers.map((c) => (
                      <li>
                        {c.name} <span class="muted">{c.school}</span>
                      </li>
                    ))}
                  </ul>
                  {g.mentors.length > 0 && <p class="muted small">Mentor {g.mentors.map((m) => m.name).join(", ")}</p>}
                  <p class="sol-files">
                    {g.files.map((f) => (
                      <a href={f.url} target="_blank" rel="noopener">
                        <Icon name={iconFor[f.label]} size="16" />
                        {f.label === "PDF" ? "Báo cáo" : f.label}
                      </a>
                    ))}
                  </p>
                </div>
              ))
            )}
          </div>
        </article>
      ))}
    </Section>
  )
}

{
  y.gallery && (
    <Section name="variant-d-plates" width="large" spacing="medium">
      <h2>Hình ảnh</h2>
      {y.gallery.map((s) => {
        const list = sectionPhotos(y.year, s.folder).slice(0, 5);
        return (
          <section class="plate">
            <div class="plate-caption">
              <h3 class="plate-name">{s.name}</h3>
              <p class="muted small">{s.total} ảnh</p>
              <a href="#" class="small plate-all">Xem cả album</a>
            </div>
            <div class="plate-grid">
              {list.map((ph, k) => (
                <a href={ph.src} class:list={["plate-ph", { lead: k === 0 }]}>
                  <Image src={ph} alt="" widths={[400, 800, 1200]} sizes={k === 0 ? "(max-width: 767px) 90vw, 40vw" : "(max-width: 767px) 45vw, 20vw"} class="plate-img" />
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </Section>
  )
}

<style>
  .muted {
    color: var(--color-text-muted);
  }
  .small {
    font-size: var(--font-size-small);
  }

  /* The book cover: one dark-green frame, a viewport tall on desktop, holding the cover photo,
     the season, the topic, the camp dates and the counts. */
  .bookcover {
    margin-top: var(--space-20);
    margin-bottom: var(--space-16);
    padding: var(--space-6);
    border-radius: var(--radius);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-8);
    height: calc(100svh - var(--space-24));
    min-height: 40rem;
    max-height: 60rem;
  }
  .bc-photo {
    position: relative;
    min-height: 0;
  }
  .bc-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .bc-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "season season"
      "title dates"
      "counts counts";
    column-gap: var(--space-12);
    row-gap: var(--space-5);
    align-items: end;
    padding: 0 var(--space-4) var(--space-4);
  }
  .bc-season {
    grid-area: season;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-text-accent);
    color: var(--color-text-accent);
    font-weight: var(--font-weight-bold);
  }
  .bc-year {
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }
  .bc-title {
    grid-area: title;
  }
  .bc-display {
    color: var(--color-text);
    font-size: var(--font-size-display-2);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    font-weight: var(--font-weight-black);
    text-wrap: balance;
  }
  .bc-en {
    margin-top: var(--space-2);
    color: var(--color-text-accent);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-semibold);
  }
  .bc-dates {
    grid-area: dates;
    display: flex;
    gap: var(--space-8);
    margin: 0;
  }
  .bc-date {
    padding-left: var(--space-4);
    border-left: var(--space-1) solid var(--color-background-accent);
  }
  .bc-date dt {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-extrabold);
  }
  .bc-date dd {
    margin: 0;
    display: grid;
  }
  .bc-days {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }
  .bc-month,
  .bc-venue {
    font-size: var(--font-size-small);
  }
  .bc-venue {
    color: var(--color-text-muted);
    max-width: 16rem;
  }
  .bc-counts {
    grid-area: counts;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-text-accent);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .bc-counts b {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }

  .preface {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-12);
    align-items: start;
  }
  .page-lime {
    padding: var(--space-10);
    border-radius: var(--radius);
  }
  .page-title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .programme {
    margin: var(--space-6) 0 0;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }
  .programme li::marker {
    font-weight: var(--font-weight-black);
    color: var(--color-text-heading);
  }

  .prose {
    margin-top: var(--space-4);
    max-width: 40rem;
  }
  .credits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .credit-role {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }
  .credit {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-4);
    font-size: var(--font-size-small);
  }
  .credit-img {
    width: var(--space-12);
    height: var(--space-12);
    object-fit: cover;
    flex-shrink: 0;
  }

  /* The table of contents: on the page's left edge, at a reading measure. */
  .contents :global(.column) > * {
    max-width: 60rem;
  }
  .toc-part + .toc-part {
    margin-top: var(--space-16);
  }
  .toc {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0;
  }
  .entry {
    display: grid;
    grid-template-columns: auto minmax(var(--space-8), 1fr) auto;
    column-gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
  }
  .numbered .entry {
    grid-template-columns: var(--space-10) auto minmax(var(--space-8), 1fr) auto;
  }
  .num {
    font-weight: var(--font-weight-black);
    color: var(--color-text-heading);
    font-variant-numeric: tabular-nums;
  }
  .entry-title {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .leader {
    border-bottom: 2px dotted var(--color-border-field);
    transform: translateY(calc(-1 * var(--space-1)));
  }
  .files {
    display: flex;
    gap: var(--space-3);
  }
  .files a {
    font-weight: var(--font-weight-extrabold);
    color: var(--color-link);
  }
  .byline {
    grid-column: 1 / -1;
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
  .numbered .byline {
    grid-column: 2 / -1;
  }

  /* Problems and their solutions. */
  .problems-title {
    margin-bottom: var(--space-8);
  }
  .problem {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-12);
    padding: var(--space-10) 0;
    border-top: 1px solid var(--color-border-field);
  }
  .statement h3 {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    color: var(--color-text-heading);
  }
  .statement-text {
    margin-top: var(--space-4);
  }
  .brief,
  .sol-files a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-link);
  }
  .brief {
    margin-top: var(--space-4);
  }
  .solutions {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .solution {
    padding-left: var(--space-6);
    border-left: var(--space-1) solid var(--color-background-accent);
  }
  .solution-head {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .campus {
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-heading);
  }
  .campers {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
    display: grid;
    gap: var(--space-1);
  }
  .campers .muted {
    font-size: var(--font-size-small);
  }
  .sol-files {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--font-size-small);
  }

  /* Plates. */
  .plate {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: var(--space-8);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
  }
  .plate:first-of-type {
    margin-top: var(--space-8);
  }
  .plate-name {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }
  .plate-all {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: var(--font-weight-bold);
    color: var(--color-link);
  }
  .plate-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    aspect-ratio: 3 / 1.2;
  }
  .plate-ph {
    position: relative;
    display: block;
    min-height: 0;
  }
  .plate-ph.lead {
    grid-row: span 2;
  }
  .plate-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 991px) {
    .preface {
      grid-template-columns: 1fr;
    }
    .bookcover {
      height: auto;
      max-height: none;
      min-height: 0;
      grid-template-rows: auto auto;
    }
    .bc-photo {
      aspect-ratio: 12 / 5;
    }
    .bc-text {
      grid-template-columns: 1fr;
      grid-template-areas: "season" "title" "dates" "counts";
    }
    .problem {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .plate {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
  @media screen and (max-width: 767px) {
    .bookcover {
      margin-top: var(--space-20);
      padding: var(--space-3);
      gap: var(--space-5);
    }
    .bc-photo {
      aspect-ratio: 4 / 3;
    }
    .bc-text {
      padding: 0 var(--space-2) var(--space-2);
    }
    .bc-dates {
      flex-direction: column;
      gap: var(--space-4);
    }
    .page-lime {
      padding: var(--space-6);
    }
    .sessions,
    .credits {
      grid-template-columns: 1fr;
    }
    .entry,
    .numbered .entry {
      grid-template-columns: var(--space-8) 1fr;
      row-gap: var(--space-1);
    }
    .entry:not(.numbered .entry) {
      grid-template-columns: 1fr auto;
    }
    .leader {
      display: none;
    }
    .entry-title {
      font-size: var(--font-size-body);
    }
    .numbered .files,
    .numbered .byline {
      grid-column: 2;
    }
    .numbered .files {
      order: 1;
    }
    .plate-grid {
      aspect-ratio: 3 / 2;
    }
  }
</style>

<style>
  :global([data-proto] img) {
    overflow: clip;
  }
</style>
