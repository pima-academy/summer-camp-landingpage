---
// Cover: the hero of the camp archive page, a book cover (design D of #89). A dark-green
// frame holding the cover photo, the season line with the year, the topic in display type with
// its English under it, one calendar block per session and the counts sentence with its numbers
// set large. Missing data drops out; the structure is the same every year.
// The photo is never cropped: it keeps its own aspect ratio, at every size. On desktop the frame
// fits the viewport: the season line runs across the top, the counts across the foot, and
// between them the photo, shrunk whole to the height left, with the topic and the dates centred
// beside it. Where the topic and the dates need more than that height (a short viewport), the
// frame grows to hold them rather than run them into the counts. A wide photo (2:1 or wider: 2019, 2023, 2026) runs instead across the top with the
// text under it when the viewport is 850 px tall or more, where that shows it larger. Below
// 992 px the photo is always on top, at the frame's width.
// A year held at several campuses (2025) has one cover per campus, all shown at once, each with
// its own date block under it. On desktop the covers sit side by side in the photo's place, the
// topic beside them, and each cover is held under the height the viewport leaves, so the frame
// still fits it. Below 992 px they run across the top at the frame's width, stacking below 768 px.
// A click on a cover opens it in a Lightbox, with the other campus's cover one step away.
// Above the frame, the row of every camp year (CampYearNav) with this one current: the frame's
// viewport fit leaves room for its one line.
// Used by trai-he-toan-hoc-pima/[year].
import { Image } from "astro:assets";
import BrandName from "../../components/BrandName.astro";
import CampYearNav from "../../components/CampYearNav.astro";
import Lightbox from "../../components/Lightbox.astro";
import Section from "../../components/Section.astro";
import { calendarDates, countsSentence, coversOf, type CampYear, type Session } from "./camp-archive";

interface Props {
  camp: CampYear;
}

const { camp } = Astro.props;
const covers = coversOf(camp);
/** Several campuses: one cover per campus, side by side, each with its date block. */
const multi = covers.length > 1;
/** A session's date block: campus (or "Thời gian"), day range, month and year, venue. */
const blockOf = (s: Session) => ({
  label: s.campus ?? "Thời gian",
  dates: s.start && s.end ? calendarDates(s.start, s.end) : undefined,
  venue: s.venue,
});
const blocks = (camp.sessions ?? []).map(blockOf);
const counts = countsSentence(camp);
/** The single cover's aspect ratio, which the frame takes. */
const ratio = covers[0].image.width / covers[0].image.height;
/** A single cover 2:1 or wider, on top of the text on a tall desktop viewport. */
const wide = !multi && ratio >= 2;
const altOf = (c: (typeof covers)[number]) =>
  c.campus ? `Trại sinh và ban tổ chức Trại hè PiMA ${camp.year} tại ${c.campus}` : `Trại sinh và ban tổ chức Trại hè PiMA ${camp.year}`;
---

<Section name="cover" width="large" spacing="none">
  <div class="years">
    <CampYearNav current={camp.year} />
  </div>
  <div class:list={["bookcover", { wide, multi }]} data-tone="dark-green">
    {
      multi ? (
        <div class="campuses">
          {covers.map((c, k) => {
            const s = camp.sessions?.find((x) => x.campus === c.campus);
            const b = s && blockOf(s);
            return (
              <figure class="campus" style={`--cover-ratio: ${c.image.width / c.image.height}`}>
                <button type="button" class="zoom" data-lightbox-open="cover" data-index={k} aria-label={`Phóng to ảnh: ${altOf(c)}`}>
                  <Image
                    src={c.image}
                    alt=""
                    widths={[600, 800, 1200, 1600, 2000]}
                    sizes="(max-width: 767px) 92vw, (max-width: 991px) 46vw, 600px"
                    quality={90}
                    class="img"
                    loading="eager"
                  />
                </button>
                <figcaption>
                  <dl class="dates">
                    <div class="date">
                      <dt>{b?.label ?? c.campus}</dt>
                      <dd>
                        {b?.dates && <span class="days">{b.dates.days}</span>}
                        {b?.dates && <span class="month">{b.dates.rest}</span>}
                        {b?.venue && <span class="venue">{b.venue}</span>}
                      </dd>
                    </div>
                  </dl>
                </figcaption>
              </figure>
            );
          })}
        </div>
      ) : (
        <div class="photo" style={`--cover-ratio: ${ratio}`}>
          <div class="fit">
            <button type="button" class="pic zoom" data-lightbox-open="cover" aria-label={`Phóng to ảnh: ${altOf(covers[0])}`}>
              {/* Desktop: 60 % of the frame's width beside the text, all of it for a wide photo on top. */}
              <Image
                src={covers[0].image}
                alt=""
                widths={[800, 1200, 1600, 2000, 2400, 2880]}
                sizes={wide ? "(max-width: 991px) 92vw, 1232px" : "(max-width: 991px) 92vw, 800px"}
                quality={90}
                class="img"
                loading="eager"
              />
            </button>
          </div>
        </div>
      )
    }
    <div class="text">
      <p class="season">
        <span>Trại hè Toán học và Ứng dụng <BrandName /></span>
        <span class="year">{camp.year}</span>
      </p>
      <div class="lead">
      <div class="title">
        <h1 class="display">{camp.topic.vi}</h1>
        <p class="en">{camp.topic.en}</p>
      </div>
      {
        !multi && blocks.length > 0 && (
          <dl class:list={["dates", { several: blocks.length > 1 }]}>
            {blocks.map((b) => (
              <div class="date">
                <dt>{b.label}</dt>
                <dd>
                  {b.dates && <span class="days">{b.dates.days}</span>}
                  {b.dates && <span class="month">{b.dates.rest}</span>}
                  {b.venue && <span class="venue">{b.venue}</span>}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
      </div>
      {
        counts.length > 0 && (
          <p class="counts">{counts.map((piece) => (typeof piece === "number" ? <b>{piece}</b> : piece))}</p>
        )
      }
    </div>
    <Lightbox id="cover" label={`Trại hè PiMA ${camp.year}`} photos={covers.map((c) => ({ src: c.image, alt: altOf(c), caption: c.campus && `Trại hè PiMA ${camp.year} tại ${c.campus}` }))} />
  </div>
</Section>

<style>
  /* The year row (CampYearNav), under the fixed nav. */
  .years {
    margin-top: var(--space-24);
  }

  /* The book cover: one dark-green frame, as tall as its photo and text need. --year-nav-room is
     what the year row adds above it, compared with a frame right under the nav: the row's one
     line at >= 992 px (a year link's line, padding and rule), the gap under it and the extra top
     room. The viewport fit below takes it off. */
  .bookcover {
    --year-nav-room: calc(
      var(--font-size-body) * var(--line-height-body) + 2 * var(--space-1) + var(--border-width-rule-accent) + var(--space-4) +
        var(--space-4)
    );
    margin-top: var(--space-4);
    margin-bottom: var(--space-16);
    padding: var(--space-6);
    border-radius: var(--radius);
    display: grid;
    grid-template-areas: "photo" "text";
    gap: var(--space-8);
  }
  /* The photo's cell asks, through an empty box of the photo's aspect ratio, for the photo's
     height at the cell's width, held under what the viewport leaves (see the layouts below). The
     photo is the largest box of its own aspect ratio that fits the cell (so object-fit: cover
     cuts nothing), centred in it. */
  .photo {
    grid-area: photo;
    position: relative;
    min-height: 0;
    overflow: clip;
  }
  .photo::before {
    content: "";
    display: block;
    aspect-ratio: var(--cover-ratio);
  }
  .fit {
    position: absolute;
    inset: 0;
    container-type: size;
    display: grid;
    place-items: center;
  }
  .pic {
    position: relative;
    width: min(100cqw, 100cqh * var(--cover-ratio));
    aspect-ratio: var(--cover-ratio);
  }
  /* A cover is a button that opens the lightbox at it. */
  .zoom {
    display: block;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: zoom-in;
  }
  .img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Several campuses: the covers side by side, each whole at its column's width, with its date
     block under it. */
  .campuses {
    grid-area: photo;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .campus {
    margin: 0;
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }
  .campus .img {
    position: static;
    display: block;
    height: auto;
  }
  .campus .venue {
    max-width: none;
  }

  .text {
    grid-area: text;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "season season"
      "title dates"
      "counts counts";
    column-gap: var(--space-12);
    row-gap: var(--space-5);
    align-items: end;
    padding: 0 var(--space-4) var(--space-4);
  }
  /* The topic and the dates: two cells of the text's grid, or beside the photo one column. */
  .lead {
    display: contents;
  }
  .season {
    grid-area: season;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-text-accent);
    color: var(--color-text-accent);
    font-weight: var(--font-weight-bold);
  }
  .year {
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }
  .title {
    grid-area: title;
  }
  /* Display type: the topic is the page's h1, but not a heading to the eye. */
  .display {
    color: var(--color-text);
    font-size: var(--font-size-display-2);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-display);
    font-weight: var(--font-weight-black);
    text-wrap: balance;
  }
  .en {
    margin-top: var(--space-2);
    color: var(--color-text-accent);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-semibold);
  }
  /* A date range stays on one line; two campuses' blocks stack when the column is too narrow. */
  .dates {
    grid-area: dates;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: 0;
  }
  .date {
    padding-left: var(--space-4);
    border-left: var(--border-width-rule-accent) solid var(--color-border-rule-accent);
  }
  .date dt {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-extrabold);
  }
  .date dd {
    margin: 0;
    display: grid;
  }
  .days {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Several campuses: smaller ranges in blocks sharing the row, so they stay side by side
     beside the photo; the venue wraps to the block's width. */
  .several .date {
    flex: 1 1 0;
  }
  .several .venue {
    max-width: none;
  }
  .several .days {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .month,
  .venue {
    font-size: var(--font-size-small);
  }
  .venue {
    color: var(--color-text-muted);
    max-width: 16rem;
  }
  .counts {
    grid-area: counts;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-text-accent);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }
  .counts b {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }

  /* Above, the photo on top of the text (a wide photo on a tall viewport, every photo under
     992 px). On desktop the photo sits beside the text: the season line runs across the top and
     the counts across the foot; between them the photo, and the topic with the dates centred
     beside it. The photo asks for no more than the viewport leaves once the frame's padding,
     gaps, season line and one line of counts (each a <p> with its margin and a 1 px rule) are
     taken; the row is as tall as the photo or the
     text, whichever is taller, so the text never runs into the counts (a short viewport then
     scrolls the frame). */
  .bookcover {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    grid-template-areas:
      "season season"
      "photo lead"
      "counts counts";
  }
  .bookcover {
    --photo-room: calc(
      100svh - var(--space-24) - var(--year-nav-room) - 2 * var(--space-6) - 2 * var(--space-8) - var(--font-size-body) * var(--line-height-body) -
        3 * var(--space-3) - var(--space-4) - var(--font-size-h3) * var(--line-height-h3) - 2px
    );
  }
  .bookcover .photo::before {
    max-height: var(--photo-room);
  }
  .bookcover .text {
    display: contents;
  }
  .bookcover .lead {
    grid-area: lead;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
  }

  /* Several campuses on desktop: the covers take more of the row, side by side; each is as wide
     as its column, or narrower so that it and its date block (campus, days, month, one line of
     venue) fit the photo's room. */
  .multi {
    grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
  }
  .multi .campus .img {
    width: min(
      100%,
      (
          var(--photo-room) - var(--space-4) - var(--font-size-body) * var(--line-height-body) - var(--font-size-h2) * var(--line-height-h2) - 2 *
            var(--font-size-small) * var(--line-height-body)
        ) * var(--cover-ratio)
    );
  }

  /* breakpoint-exception: a wide photo is larger on top of the text once the viewport is tall
     enough; the width breakpoints below still put every photo on top under 992 px. The frame
     fits the viewport: the text keeps its height and the photo's row gets what is left. */
  @media screen and (min-height: 850px) {
    .wide {
      grid-template-columns: none;
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: "photo" "text";
      max-height: calc(100svh - var(--space-24) - var(--year-nav-room));
    }
    .wide .photo::before {
      max-height: none;
    }
    .wide .text {
      display: grid;
    }
    .wide .lead {
      display: contents;
    }
  }

  @media screen and (max-width: 991px) {
    .bookcover {
      max-height: none;
      grid-template-columns: none;
      grid-template-rows: none;
      grid-template-areas: "photo" "text";
    }
    .bookcover .photo::before {
      max-height: none;
    }
    .multi .campus .img {
      width: 100%;
    }
    .bookcover .text {
      display: grid;
    }
    .bookcover .lead {
      display: contents;
    }
    .text {
      grid-template-columns: 1fr;
      grid-template-areas: "season" "title" "dates" "counts";
    }
  }
  @media screen and (max-width: 767px) {
    .bookcover {
      padding: var(--space-3);
      gap: var(--space-5);
    }
    .text {
      padding: 0 var(--space-2) var(--space-2);
    }
    .dates {
      flex-direction: column;
      gap: var(--space-4);
    }
    .campuses {
      grid-auto-flow: row;
      gap: var(--space-6);
    }
  }
</style>
