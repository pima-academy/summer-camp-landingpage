---
// Plates: the camp archive page's photos, as plates at the back of a book (design D of #89).
// One plate per album: its name and photo count, "Xem cả album", and one large and four small
// photos. A click on a photo opens the album's Lightbox at it, "Xem cả album" at its first photo;
// the lightbox steps through every photo of the album, not only the five shown. The album's Drive
// folder (`album` in the year's data) holds the originals and is not linked. The year's video,
// when it has one, follows as a last plate. Renders nothing without either.
// Used by trai-he-toan-hoc-pima/[year].
import { Image } from "astro:assets";
import Lightbox from "../../components/Lightbox.astro";
import Section from "../../components/Section.astro";
import type { CampYear } from "./camp-archive";
import type { Album } from "./camp-years";

interface Props {
  camp: CampYear;
  /** The year's gallery sections with their photos (camp-years.ts). */
  albums: Album[];
}

const { camp, albums } = Astro.props;
const shown = albums.filter((a) => a.photos.length > 0);
const title = shown.length && camp.video ? "Hình ảnh và video" : camp.video ? "Video" : "Hình ảnh";
/** Every photo of an album shares its alt text. */
const altOf = (a: Album) => (a.name ? `${a.name}, Trại hè PiMA ${camp.year}` : `Trại hè PiMA ${camp.year}`);
---

{
  (shown.length > 0 || camp.video) && (
    <Section name="plates" width="large" spacing="medium">
      <h2>{title}</h2>
      {shown.map((a, i) => (
        <section class="plate">
          <div>
            {a.name && <h3 class="name">{a.name}</h3>}
            <p class="count">{a.photos.length} ảnh</p>
            <button type="button" class="all" data-lightbox-open={`album-${i + 1}`}>
              Xem cả album
            </button>
          </div>
          <div class="grid">
            {a.photos.slice(0, 5).map((photo, k) => (
              <button
                type="button"
                class:list={["cell", { lead: k === 0 }]}
                data-lightbox-open={`album-${i + 1}`}
                data-index={k}
                aria-label={`Phóng to ảnh ${k + 1} / ${a.photos.length}: ${altOf(a)}`}
              >
                <Image
                  src={photo}
                  alt=""
                  widths={[400, 800, 1200]}
                  sizes={k === 0 ? "(max-width: 767px) 90vw, 40vw" : "(max-width: 767px) 45vw, 20vw"}
                  class="img"
                />
              </button>
            ))}
          </div>
          <Lightbox id={`album-${i + 1}`} label={a.name ?? `Trại hè PiMA ${camp.year}`} photos={a.photos.map((src) => ({ src, alt: altOf(a) }))} />
        </section>
      ))}
      {camp.video && (
        <section class="plate">
          <div>
            <h3 class="name">Video</h3>
          </div>
          <iframe
            class="video"
            src={`https://www.youtube-nocookie.com/embed/${camp.video.youtubeId}`}
            title={`Video Trại hè PiMA ${camp.year}`}
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </section>
      )}
    </Section>
  )
}

<style>
  .plate {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: var(--space-8);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
  }
  .plate:first-of-type {
    margin-top: var(--space-8);
  }
  /* An album's name: an h3 set as a body-size label. */
  .name {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }
  .count {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  /* "Xem cả album": a button set as a link. */
  .all {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    color: var(--color-link);
  }
  .all:hover {
    color: var(--color-link-hover);
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    aspect-ratio: 3 / 1.2;
  }
  /* A photo is a button that opens the lightbox at it. */
  .cell {
    position: relative;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: zoom-in;
  }
  .cell.lead {
    grid-row: span 2;
  }
  .img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius);
  }

  @media screen and (max-width: 991px) {
    .plate {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
  @media screen and (max-width: 767px) {
    .grid {
      aspect-ratio: 3 / 2;
    }
  }
</style>
