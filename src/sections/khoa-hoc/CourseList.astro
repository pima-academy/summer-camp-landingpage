---
// CourseList: the "Danh sách các khóa học" list of course cards, as the old Webflow CMS
// list rendered it with no course data (one empty card and "No items found."). Used by
// khoa-hoc only (old `section_programs-overview` with a `w-dyn-list`), inside a content
// gap, so it only shows in `npm run dev`. Fades up on scroll.
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import placeholder from "../../assets/images/placeholder-image-landscape.svg";
---

<Section name="course-list" spacing="none" animate id="programs">
  <div class="inner">
    <h2 class="title">Danh sách các khóa học</h2>
    <div class="list">
      <div role="list" class="cards">
        <div role="listitem" class="item">
          <a href="#" class="card-link">
            <div class="cover"><Image src={placeholder} alt="" class="unbound" /></div>
          </a>
          <div class="name-row">
            <h3 class="unbound"></h3>
            <div class="arrow">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" viewBox="0 0 24 24">
                <path fill="currentColor" d="m11.293 17.293l1.414 1.414L19.414 12l-6.707-6.707l-1.414 1.414L15.586 11H6v2h9.586z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
      <div class="empty">
        <div>No items found.</div>
      </div>
    </div>
  </div>
</Section>

<style>
  .inner {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .title {
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
    font-size: var(--font-size-heading-style-h3);
    font-weight: var(--font-weight-heading-style);
    line-height: var(--line-height-heading-style-h3);
    text-align: center;
  }

  .list {
    width: 100%;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
    padding-top: 2rem;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .item {
    padding-left: 10px;
    padding-right: 10px;
  }

  .card-link {
    display: block;
    max-width: 100%;
  }

  .cover {
    border-radius: var(--radius-panel);
    overflow: clip;
  }

  /* CMS fields with no data (old `w-dyn-bind-empty`): the cover image and the course name. */
  .unbound {
    display: none;
  }

  .name-row {
    display: flex;
    gap: 4px;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 40px;
  }

  .arrow {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-icon-decorative);
  }

  .empty {
    padding: 10px;
    background-color: var(--color-background-empty-list);
  }

  @media screen and (max-width: 991px) {
    .list {
      padding-top: 1.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .list {
      padding-top: 1.25rem;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
