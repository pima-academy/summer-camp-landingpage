---
// PROTOTYPE A · Một khung (throwaway, #126; dev only). The whole page is one dark-green band,
// the page's bold moment, as the home hero: the heading and every channel as ruled rows on the
// left, the form in a white card on the right, so writing an email and leaving a message sit
// side by side in one screen at 1440 px. At ≤ 991 px the card follows the channels.
// The same block, with an h2, could become the shared ContactSection (one version, map #118).
import BrandName from "../../../components/BrandName.astro";
import Icon from "../../../components/Icon.astro";
import Kicker from "../../../components/Kicker.astro";
import Section from "../../../components/Section.astro";
import ProtoForm from "./ProtoForm.astro";
import { address, channels, email, form, page } from "./data";
---

<Section name="contact" tone="dark-green" width="large" spacing="large">
  <div class="grid">
    <div class="intro">
      <Kicker flush><BrandName /> academy &gt; liên hệ</Kicker>
      <h1>{page.title}</h1>
      <p class="lead">{page.lead}</p>
      <ul class="rows">
        <li>
          <Icon name="mail-filled" size="40" circle />
          <div>
            <div class="label">{email.label}</div>
            <a class="value" href={email.href}>{email.value}</a>
          </div>
        </li>
        {
          channels.map((c) => (
            <li>
              <Icon name={c.icon} size="40" circle />
              <div>
                <div class="label">{c.label}</div>
                <a class="value" href={c.href}>
                  {c.value}
                </a>
              </div>
            </li>
          ))
        }
        <li>
          <Icon name="map-pin-filled" size="40" circle />
          <div>
            <div class="label">{address.label}</div>
            <div class="value">{address.value}</div>
          </div>
        </li>
      </ul>
    </div>
    <div class="card" data-tone="white">
      <h2>{form.title}</h2>
      <p class="note">{form.note}</p>
      <ProtoForm id="a" />
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: var(--space-16);
  }
  h1 {
    margin: var(--space-4) 0 var(--space-6);
    font-size: max(var(--font-size-h1), var(--font-size-display-2));
    font-weight: var(--font-weight-black);
    letter-spacing: var(--letter-spacing-display);
    line-height: var(--line-height-display);
  }
  .lead {
    max-width: 30rem;
    margin: 0 0 var(--space-10);
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border-accent);
  }
  .rows li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-accent);
  }
  .label {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .value {
    font-weight: var(--font-weight-bold);
    overflow-wrap: anywhere;
  }
  a.value {
    color: var(--color-text);
    text-decoration-color: var(--color-text-accent);
    text-underline-offset: 0.2em;
  }
  a.value:hover {
    color: var(--color-text-accent);
  }
  .card {
    padding: var(--space-10);
    border-radius: var(--radius);
  }
  .card h2 {
    margin: 0 0 var(--space-2);
  }
  .note {
    margin: 0 0 var(--space-8);
    color: var(--color-text-muted);
  }
  @media screen and (max-width: 991px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
  @media screen and (max-width: 767px) {
    .card {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
