---
// SocialLinks: "Kết nối với chúng tôi qua" card with the Facebook, LinkedIn and Youtube
// pills, links from site.ts. Used by lien-he only (old `section-contact-social`). Fades up
// on scroll.
import Section from "../../components/Section.astro";
import { social } from "../../data/site";
---

<Section name="social-links" spacing="none" animate>
  <div class="frame">
    <div class="box">
      <h2 class="heading">Kết nối với chúng tôi qua</h2>
      <div class="links">
        <a href={social.facebook.href} class="pill">
          <span class="glyph facebook">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" viewBox="0 0 24 24">
              <path d="M13.397 20.997v-8.196h2.765l.411-3.209h-3.176V7.548c0-.926.258-1.56 1.587-1.56h1.684V3.127A22.336 22.336 0 0 0 14.201 3c-2.444 0-4.122 1.492-4.122 4.231v2.355H7.332v3.209h2.753v8.202h3.312z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="text">Facebook</span>
        </a>
        <a href={social.linkedin.href} class="pill">
          <span class="glyph linkedin">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" viewBox="0 0 24 24">
              <circle cx="4.983" cy="5.009" r="2.188" fill="currentColor"></circle>
              <path d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118c1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783c-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="text">LinkedIn</span>
        </a>
        <a href={social.youtube.href} class="pill">
          <span class="glyph youtube">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" viewBox="0 0 24 24">
              <path d="M21.593 7.203a2.506 2.506 0 0 0-1.762-1.766C18.265 5.007 12 5 12 5s-6.264-.007-7.831.404a2.56 2.56 0 0 0-1.766 1.778c-.413 1.566-.417 4.814-.417 4.814s-.004 3.264.406 4.814c.23.857.905 1.534 1.763 1.765c1.582.43 7.83.437 7.83.437s6.265.007 7.831-.403a2.515 2.515 0 0 0 1.767-1.763c.414-1.565.417-4.812.417-4.812s.02-3.265-.407-4.831zM9.996 15.005l.005-6l5.207 3.005l-5.212 2.995z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="text">Youtube</span>
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  /* The old band (1rem) plus the old card frame (1rem 4rem 2rem). */
  .frame {
    padding: 2rem 4rem 3rem;
  }

  .box {
    padding: 2rem 4rem 3rem;
    border-radius: var(--radius-panel);
    background-color: var(--color-background-surface);
  }

  /* h2 sized as an h4; 1rem below (the old spacer). */
  .heading {
    margin-bottom: calc(0.35em + 1rem);
    font-size: var(--font-size-heading-style-h4);
    font-weight: var(--font-weight-heading-style);
    line-height: var(--line-height-heading-style-h4);
    text-align: center;
  }

  .links {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 110px;
    padding-bottom: 1rem;
  }

  .pill {
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
    gap: 8px;
    max-width: 100%;
    min-height: 44px;
    padding-left: 20px;
    padding-right: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill-form);
    background-color: transparent;
    color: var(--color-text-muted);
  }

  .pill:hover {
    color: var(--color-text);
  }

  .glyph {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 2rem;
    height: 2rem;
  }

  .facebook {
    min-width: 2px;
    min-height: 2px;
    color: var(--color-icon-decorative);
  }

  .linkedin {
    color: var(--color-icon-decorative);
  }

  .youtube {
    color: var(--color-icon-decorative);
  }

  .text {
    text-decoration: none;
  }

  @media screen and (max-width: 767px) {
    .frame {
      padding-bottom: 4rem;
    }
  }

  @media screen and (max-width: 479px) {
    .frame {
      padding-left: 0;
      padding-right: 0;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .facebook {
      min-width: 2rem;
      min-height: 2rem;
    }
  }

  /* Defect fix: from 480 to 991 px the three pills did not fit the card's 3-column grid with
     its 110 px gaps, so "Youtube" overflowed the card (and the page scrolled sideways at
     480–899 px). Here the pills keep their size and wrap, spaced evenly, with the 20 px gap
     the mobile layout uses. Just above 480 px the card is too narrow even for one pill, so
     its side padding shrinks there (still 4rem from ~560 px up, so no visible change
     elsewhere). Mobile (<= 479) and desktop (>= 992) are unchanged. */
  /* breakpoint-exception: the 480–991 px band of the defect fix above. */
  @media screen and (min-width: 480px) and (max-width: 991px) {
    .box {
      padding-left: clamp(0px, calc((100% - 10rem) / 2), 4rem);
      padding-right: clamp(0px, calc((100% - 10rem) / 2), 4rem);
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-evenly;
      gap: 20px;
    }
  }
</style>
