---
// MessageForm: the lien-he page's "Hoặc để lại lời nhắn" block, an illustration next to the
// ContactForm (lien-he variant). Used by lien-he only (old `section_contact-form` with its
// image-and-form grid). Fades up on scroll.
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
import { fluidWidths } from "../../lib/image-widths";
import contactIllustration from "../../assets/images/frame-28135.avif";
---

<Section name="message-form" spacing="none" animate id="contact-form" class="message-band">
  <div class="layout">
    <div class="illustration">
      {/* width 443 as the old attribute: it caps the illustration where the cell is wider. */}
      <Image
        src={contactIllustration}
        alt=""
        width={443}
        widths={fluidWidths(contactIllustration)}
        sizes="(max-width: 479px) 90vw, (max-width: 767px) 443px, (max-width: 991px) 35vw, 400px"
      />
    </div>
    <div class="form-cell">
      <h3>Hoặc để lại lời nhắn</h3>
      <div class="note">PiMA sẽ phản hồi bạn sớm nhất có thể!</div>
      <ContactForm variant="lien-he" />
    </div>
  </div>
</Section>

<style>
  .message-band {
    background-color: var(--color-background-lime-light);
  }

  /* Five columns: the illustration takes two, the form three. */
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    gap: 20px;
    width: 100%;
    padding-top: 4rem;
  }

  .illustration {
    grid-column: span 2;
    align-self: end;
  }

  .form-cell {
    grid-column: span 3;
    margin-bottom: 20px;
  }

  /* 1rem below (the old spacer). */
  .note {
    margin-bottom: 1rem;
    font-size: var(--font-size-text-small);
  }

  @media screen and (max-width: 767px) {
    .layout {
      display: block;
      padding-bottom: 1rem;
    }
  }

  @media screen and (max-width: 479px) {
    .form-cell {
      padding-bottom: 20px;
    }
  }
</style>
