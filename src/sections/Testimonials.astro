---
// Testimonials: "Cảm nhận từ trại sinh và học viên" section, the cards from testimonials.ts
// in 3 / 2 / 1 columns. Used by index, trai-he-toan-hoc-pima and chi-tiet-trai-he (old
// `section_testimonials`). Fades up on scroll.
import { Image } from "astro:assets";
import Section from "../components/Section.astro";
import { testimonials } from "./testimonials";
---

<Section name="testimonials" spacing="small" tone="pale-lime" animate>
  <h2 class="title">Cảm nhận từ trại sinh và học viên</h2>
  <div class="cards">
    {
      testimonials.map((t) => (
        <div class="card-box" data-tone="white">
          <div class="quote">
            <em>"{t.quote}"</em>
          </div>
          <div class="client">
            <div>
              <Image src={t.avatar} alt={`Ảnh đại diện của ${t.name}`} width={48} densities={[1, 2]} class="avatar-img" />
            </div>
            <div>
              <div class="name">{t.name}</div>
              <div>
                {t.role.map((line, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    {line}
                  </Fragment>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .title {
    text-align: center;
  }

  .cards {
    column-count: 3;
    column-gap: var(--space-8);
    padding-top: var(--space-8);
  }

  .card-box {
    display: inline-block;
    width: 100%;
    margin-bottom: var(--space-8);
    padding: var(--space-8);
    overflow: hidden;
    border-radius: var(--radius);
  }

  .quote {
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .client {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .avatar-img {
    width: 3rem;
    min-width: 3rem;
    max-width: 100%;
    height: 3rem;
    min-height: 3rem;
    overflow: clip;
    border-radius: var(--radius-circle);
    object-fit: cover;
  }

  /* Names are extrabold Dark Green (docs/brand.md, Typography). */
  .name {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-extrabold);
  }

  @media screen and (max-width: 991px) {
    .cards {
      column-count: 2;
      padding-top: var(--space-6);
    }
  }

  @media screen and (max-width: 767px) {
    .cards {
      column-count: 1;
      padding-top: var(--space-5);
    }

    .card-box {
      padding: var(--space-6);
    }
  }
</style>
