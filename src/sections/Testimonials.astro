---
// Testimonials: "Cảm nhận từ trại sinh và học viên" section, the cards from testimonials.ts
// in 3 / 2 / 1 columns. Used by index, trai-he-toan-hoc-pima and chi-tiet-trai-he (old
// `section_testimonials`). Fades up on scroll.
import { Image } from "astro:assets";
import Section from "../components/Section.astro";
import { testimonials } from "./testimonials";
---

<Section name="testimonials" spacing="small" animate class="testimonials">
  <h2 class="title">Cảm nhận từ trại sinh và học viên</h2>
  <div class="cards">
    {
      testimonials.map((t) => (
        <div class="card-box">
          <div class="quote">
            <em>"{t.quote}"</em>
          </div>
          <div class="client">
            <div>
              <Image src={t.avatar} alt={`Ảnh đại diện của ${t.name}`} width={48} densities={[1, 2]} class="avatar-img" />
            </div>
            <div>
              <div class="name">{t.nameLook ? <strong data-look={t.nameLook}>{t.name}</strong> : t.name}</div>
              <div>
                {t.role.map((line, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    {line}
                  </Fragment>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .testimonials {
    background-color: var(--color-background-lime-pale);
  }

  .title {
    text-align: center;
  }

  .cards {
    column-count: 3;
    column-gap: 2rem;
    padding-top: 2rem;
  }

  .card-box {
    display: inline-block;
    width: 100%;
    margin-bottom: 2rem;
    padding: 2rem;
    overflow: hidden;
    border-radius: var(--radius-card-small);
    background-color: var(--color-background);
  }

  .quote {
    margin-bottom: 1rem;
    color: var(--color-text-strong);
  }

  .client {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .avatar-img {
    width: 3rem;
    min-width: 3rem;
    max-width: 100%;
    height: 3rem;
    min-height: 3rem;
    overflow: clip;
    border-radius: var(--radius-circle);
    object-fit: cover;
  }

  .name {
    color: var(--color-text-accent-alt);
    font-weight: var(--font-weight-semibold);
  }

  .name [data-look="bold"] {
    font-weight: var(--font-weight-bold);
  }

  .name [data-look="bolder-accent"] {
    color: var(--color-text-accent);
  }

  @media screen and (max-width: 991px) {
    .cards {
      column-count: 2;
      padding-top: 1.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .cards {
      column-count: 1;
      padding-top: 1.25rem;
    }

    .card-box {
      padding: 1.5rem;
    }
  }
</style>
