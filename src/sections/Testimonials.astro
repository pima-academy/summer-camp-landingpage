---
// Testimonials: "Cảm nhận của cựu trại sinh", one quote at a time in a single-slide slider:
// the quote at h3 size, then avatar, name and roles (testimonials.ts). Used by index and
// trai-he-toan-hoc-pima.
import { Image } from "astro:assets";
import Section from "../components/Section.astro";
import Slider from "../components/Slider.astro";
import { testimonials } from "./testimonials";
---

<Section name="testimonials" tone="pale-lime" width="medium" spacing="medium">
  <h2 class="title">Cảm nhận của cựu trại sinh</h2>
  <Slider layout="single" infinite label="Cảm nhận của cựu trại sinh" arrowStyle="plain">
    {
      testimonials.map((t) => (
        <div>
          <figure class="quote">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption class="person">
              <Image src={t.avatar} alt="" width={64} densities={[1, 2]} class="avatar-img" />
              <span class="who">
                <span class="name">{t.name}</span>
                {t.role.map((line) => (
                  <span class="role">{line}</span>
                ))}
              </span>
            </figcaption>
          </figure>
        </div>
      ))
    }
  </Slider>
</Section>

<style>
  .title {
    margin-top: 0;
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .quote {
    max-width: var(--width-small);
    margin: 0 auto;
    text-align: center;
  }

  .quote blockquote {
    margin: 0 0 var(--space-6);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }

  .person {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    text-align: left;
  }

  .avatar-img {
    flex: none;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
  }

  .who {
    display: flex;
    flex-direction: column;
  }

  /* Names are extrabold Dark Green (docs/brand.md, Typography): one style for all six. */
  .name {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-extrabold);
  }

  .role {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  @media screen and (max-width: 767px) {
    .quote blockquote {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }

    .person {
      align-items: flex-start;
    }
  }
</style>
