---
// Actions: "Hành động", PiMA's three lines of action as photo cards. Used by ve-chung-toi
// only (old `section_about-action` / `layout230_*`). Fades up on scroll.
import { Image } from "astro:assets";
import BrandName from "../../components/BrandName.astro";
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
import { fluidWidths } from "../../lib/image-widths";
import action1 from "../../assets/images/action-1.avif";
import action2 from "../../assets/images/action-2.avif";
import action3 from "../../assets/images/action-3.avif";

const actions = [
  { image: action3, title: "Ươm mầm tài năng", text: "Tìm kiếm, truyền cảm hứng và hỗ trợ các cá nhân có năng lực và đam mê toán học vươn tầm thế giới và trở thành các chuyên gia hàng đầu." },
  { image: action2, title: "Kết nối cộng đồng", text: "Xây dựng mạng lưới kết nối giáo dục, nghiên cứu và doanh nghiệp nhằm thúc đẩy việc hợp tác đào tạo và nghiên cứu ứng dụng của toán học tại Việt Nam." },
  { image: action1, title: "Ứng dụng Toán học vào thực tiễn", text: "Nghiên cứu các mô hình và thuật toán tối ưu cho trí tuệ nhân tạo, khoa học dữ liệu, tài chính, tin sinh học, và nhiều lĩnh vực khác." },
];
---

<Section name="actions" width="medium" spacing="large" animate>
  <div class="intro">
    <Kicker flush><BrandName /> academy</Kicker>
    <h2 class="title">Hành động</h2>
  </div>
  <div class="cards">
    {
      actions.map((item) => (
        <div class="card-box">
          <div class="photo">
            <Image
              src={item.image}
              widths={fluidWidths(item.image)}
              sizes="(max-width: 767px) 90vw, (max-width: 1137px) calc(30vw - 21px), 310px"
              alt=""
              class="photo-img"
            />
          </div>
          <div class="text">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* The old spacer under the heading is the bottom padding. */
  .intro {
    width: 100%;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
    padding-bottom: 2rem;
    text-align: center;
  }

  .title {
    margin-top: 0;
    margin-bottom: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    place-items: start center;
    gap: 4rem 3rem;
  }

  .card-box {
    width: 100%;
    overflow: clip;
    border-radius: var(--radius-panel);
    background-color: var(--color-background-surface);
    text-align: center;
  }

  .photo {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .photo-img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    overflow: clip;
  }

  .text {
    margin-bottom: 0.5rem;
    padding: 0 2rem 0.25rem;
  }

  @media screen and (max-width: 991px) {
    .intro {
      padding-bottom: 1.5rem;
    }

    .cards {
      column-gap: 2rem;
    }
  }

  @media screen and (max-width: 767px) {
    .intro {
      padding-bottom: 1.25rem;
    }

    .cards {
      grid-template-columns: 1fr;
      row-gap: 3rem;
    }
  }
</style>
