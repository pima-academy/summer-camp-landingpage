---
// VisionMission: "Tầm nhìn, sứ mệnh và hành động". A 4/8 grid: the heading left, vision and
// mission side by side as statements at h3 size; under a rule, the three actions as columns.
// No accordion, no photos. Wording from report ch. 02 as of October 2026, without "hàng đầu".
// Used by ve-chung-toi only; carries the footer anchor "Tầm nhìn & Sứ mệnh".
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
import { aboutAnchors } from "../../data/site";

const vision =
  "PiMA hướng đến việc trở thành một tổ chức giáo dục, nghiên cứu toán học và ứng dụng, nơi hội tụ và nuôi dưỡng các tài năng, giúp họ phát huy tối đa tiềm năng và đóng góp tích cực vào sự phát triển bền vững của xã hội.";
const mission =
  "PiMA được thành lập với sứ mệnh phát triển giáo dục toán học tại Việt Nam. Thông qua các chương trình giảng dạy tiên tiến, lấy người học làm trọng tâm, chúng tôi hướng tới việc giúp mọi người không chỉ hiểu sâu hơn về toán mà còn biết cách vận dụng nó để tạo ra những ứng dụng thực tiễn.";
const actions = [
  {
    title: "Ươm mầm tài năng",
    text: "Tìm kiếm, truyền cảm hứng và hỗ trợ các cá nhân có năng lực và đam mê toán học vươn tầm thế giới.",
  },
  {
    title: "Kết nối cộng đồng",
    text: "Xây dựng mạng lưới kết nối giáo dục, nghiên cứu và doanh nghiệp nhằm thúc đẩy việc hợp tác đào tạo và nghiên cứu ứng dụng của toán học tại Việt Nam.",
  },
  {
    title: "Ứng dụng Toán học vào thực tiễn",
    text: "Nghiên cứu các mô hình và thuật toán tối ưu cho trí tuệ nhân tạo, khoa học dữ liệu, tài chính, tin sinh học và nhiều lĩnh vực khác.",
  },
];
---

<Section name="vision-mission" width="large" spacing="medium" id={aboutAnchors.visionMission}>
  <div class="grid">
    <div>
      <Kicker flush>định hướng</Kicker>
      <h2 class="title">Tầm nhìn, sứ mệnh và hành động</h2>
    </div>
    <div class="statements">
      <div>
        <h3 class="label">Tầm nhìn</h3>
        <p class="statement">{vision}</p>
      </div>
      <div>
        <h3 class="label">Sứ mệnh</h3>
        <p class="statement">{mission}</p>
      </div>
    </div>
  </div>
  <div class="grid actions-row">
    <h3 class="label">Hành động</h3>
    <ul role="list" class="actions">
      {
        actions.map((a) => (
          <li>
            <h4>{a.title}</h4>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-12);
  }

  .title {
    margin-top: var(--space-4);
  }

  .statements {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
  }

  /* Small accent labels: headings to the outline, not to the eye. */
  .label {
    margin: 0 0 var(--space-3);
    color: var(--color-text-accent);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .statement {
    margin: 0;
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
  }

  .actions-row {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .actions h4 {
    margin: 0 0 var(--space-2);
  }

  .actions p {
    margin: 0;
  }

  @media screen and (max-width: 991px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media screen and (max-width: 767px) {
    .statements,
    .actions {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
