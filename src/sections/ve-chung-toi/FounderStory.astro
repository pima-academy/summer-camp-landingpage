---
// FounderStory: "Câu chuyện của nhà sáng lập" as prose (report ch. 09, text and photos in
// founder-story.ts). A 4/7 grid on a surface band: the heading, the founder's portrait and one
// line from the chapter stick on the left while four chapters read down a ≤ 40rem column on
// the right, with captioned photos between them. At ≤ 991 px the aside is a row (portrait
// beside the line), not sticky. Used by ve-chung-toi only; carries the footer anchor
// "Câu chuyện nhà sáng lập".
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { aboutAnchors } from "../../data/site";
import { fluidWidths } from "../../lib/image-widths";
import { chapters, portrait, quote } from "./founder-story";
---

<Section name="founder-story" tone="surface" width="large" spacing="medium" id={aboutAnchors.founderStory}>
  <div class="layout">
    <aside>
      <div class="aside">
        <h2 class="title">Câu chuyện của nhà sáng lập</h2>
        <figure class="portrait">
          <Image src={portrait.src} alt={portrait.alt} widths={fluidWidths(portrait.src)} sizes="(max-width: 767px) 7rem, (max-width: 991px) 12rem, 18rem" />
          <figcaption>{portrait.caption}</figcaption>
        </figure>
        <blockquote class="quote">“{quote}”</blockquote>
      </div>
    </aside>
    <div class="prose">
      {
        chapters.map((c) => (
          <>
            <h3>{c.title}</h3>
            {c.paragraphs.map((t) => (
              <p>{t}</p>
            ))}
            {c.photos && (
              <div class:list={["photos", { pair: c.photos.length === 2 }]}>
                {c.photos.map((ph) => (
                  <figure>
                    <Image src={ph.src} alt={ph.alt} widths={fluidWidths(ph.src)} sizes={c.photos!.length === 2 ? "(max-width: 767px) 90vw, 20rem" : "(max-width: 767px) 90vw, 40rem"} />
                    <figcaption>{ph.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-16);
  }

  /* Sticks below the fixed nav while the story scrolls. */
  .aside {
    position: sticky;
    top: var(--space-28);
  }

  .title {
    margin-top: 0;
  }

  figure {
    margin: 0;
  }

  figure img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .portrait {
    max-width: 18rem;
    margin-top: var(--space-8);
  }

  .portrait img {
    aspect-ratio: 1;
  }

  .quote {
    margin: var(--space-8) 0 0;
    padding-left: var(--space-4);
    border-left: var(--border-width-rule-accent) solid var(--color-border-rule-accent);
    color: var(--color-text-heading);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-h3);
  }

  .prose {
    max-width: 40rem;
  }

  .prose h3 {
    margin: var(--space-10) 0 var(--space-3);
  }

  .prose h3:first-child {
    margin-top: 0;
  }

  .prose p {
    margin: 0 0 var(--space-4);
  }

  .photos {
    margin: var(--space-8) 0;
  }

  .photos img {
    aspect-ratio: 3 / 2;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  @media screen and (max-width: 991px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .aside {
      position: static;
      display: grid;
      grid-template-columns: 12rem 1fr;
      column-gap: var(--space-6);
      align-items: start;
    }

    .title {
      grid-column: 1 / -1;
    }

    .portrait,
    .quote {
      margin-top: 0;
    }
  }

  @media screen and (max-width: 767px) {
    .aside {
      grid-template-columns: 7rem 1fr;
      column-gap: var(--space-4);
    }

    .quote {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }

    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
