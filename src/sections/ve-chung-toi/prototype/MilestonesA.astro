---
// PROTOTYPE A · Niên biểu (throwaway, #125): 4. "Các cột mốc đáng nhớ" as the page's one bold
// moment. A dark-green band; a ledger of the nine years with events, each year in Pale Lime
// display type in its own column, its events ruled on the right. Years without events (2020,
// 2022) are simply absent, as in the report.
import Kicker from "../../../components/Kicker.astro";
import Section from "../../../components/Section.astro";
import BrandName from "../../../components/BrandName.astro";
import { anchors, milestoneYears } from "./data";
---

<Section name="milestones" tone="dark-green" width="large" spacing="large" id={anchors.milestones}>
  <div class="head">
    <div>
      <Kicker flush>2016–2026</Kicker>
      <h2>Các cột mốc đáng nhớ</h2>
    </div>
    <p>Mười năm của <BrandName />: từ trại hè đầu tiên đến PiMA Academy.</p>
  </div>
  <ol role="list" class="ledger">
    {
      milestoneYears.map((y) => (
        <li class="year-row">
          <span class="year">{y.year}</span>
          <ul role="list" class="entries">
            {y.entries.map((e) => (
              <li>
                <span class="month">{e.month ?? y.year}</span>
                <span>
                  {e.text} {e.topic && <strong class="topic">{e.topic}</strong>}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }
  .head h2 {
    margin: var(--space-4) 0 0;
  }
  .head p {
    max-width: 24rem;
    margin: 0;
    color: var(--color-text-muted);
  }
  .ledger {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .year-row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-8);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border-accent);
  }
  .year-row:last-child {
    border-bottom: 1px solid var(--color-border-accent);
  }
  .year {
    color: var(--color-text-accent);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--letter-spacing-display);
    line-height: var(--line-height-display);
    font-variant-numeric: tabular-nums;
  }
  .entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
  }
  .entries li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
  }
  .month {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-extrabold);
  }
  .topic {
    font-style: italic;
    font-weight: var(--font-weight-bold);
  }
  @media screen and (max-width: 767px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .year-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .entries {
      padding-top: 0;
    }
    .entries li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
