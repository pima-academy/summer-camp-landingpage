---
// PROTOTYPE (throwaway, #125): 3. "Câu chuyện của nhà sáng lập", prose with photos (no longer a
// timeline), rewritten from report ch. 09. Surface band. The heading, the founder's portrait and
// one line from the chapter stick on the left while the story reads down the right; the photos
// sit between the chapters where they belong in time.
import { Image } from "astro:assets";
import Section from "../../../components/Section.astro";
import { fluidWidths } from "../../../lib/image-widths";
import { anchors, story } from "./data";

const p = story.photos;
// Photos after chapter i (0-based).
const after: Record<number, (typeof p)[keyof typeof p][]> = {
  0: [p.founders],
  2: [p.firstClass, p.firstCampers],
  3: [p.vnu],
};
---

<Section name="story" tone="surface" width="large" spacing="medium" id={anchors.story}>
  <div class="layout">
    <aside class="aside">
      <div class="sticky">
        <h2>Câu chuyện của nhà sáng lập</h2>
        <figure class="portrait">
          <Image src={p.founder.src} alt={p.founder.alt} widths={fluidWidths(p.founder.src)} sizes="(max-width: 991px) 12rem, 22rem" />
          <figcaption>{p.founder.caption}</figcaption>
        </figure>
        <blockquote class="quote">“{story.quote}”</blockquote>
      </div>
    </aside>
    <div class="prose">
      {
        story.chapters.map((c, i) => (
          <>
            <h3>{c.title}</h3>
            {c.paragraphs.map((t) => (
              <p>{t}</p>
            ))}
            {after[i] && (
              <div class:list={["photos", { pair: after[i].length === 2 }]}>
                {after[i].map((ph) => (
                  <figure>
                    <Image src={ph.src} alt={ph.alt} widths={fluidWidths(ph.src)} sizes="(max-width: 767px) 90vw, 40rem" />
                    <figcaption>{ph.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-16);
  }
  .sticky {
    position: sticky;
    top: var(--space-28);
  }
  .sticky h2 {
    margin-top: 0;
  }
  figure {
    margin: 0;
  }
  figure img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  figcaption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .portrait {
    max-width: 18rem;
    margin-top: var(--space-8);
  }
  .portrait img {
    aspect-ratio: 1;
  }
  .quote {
    margin: var(--space-8) 0 0;
    padding-left: var(--space-4);
    border-left: var(--border-width-rule-accent) solid var(--color-border-rule-accent);
    color: var(--color-text-heading);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-h3);
  }
  .prose {
    max-width: 40rem;
  }
  .prose h3 {
    margin: var(--space-10) 0 var(--space-3);
    color: var(--color-text-heading);
  }
  .prose h3:first-child {
    margin-top: 0;
  }
  .prose p {
    margin: 0 0 var(--space-4);
  }
  .photos {
    margin: var(--space-8) 0;
  }
  .photos img {
    aspect-ratio: 3 / 2;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media screen and (max-width: 991px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .sticky {
      position: static;
      display: grid;
      grid-template-columns: 12rem 1fr;
      column-gap: var(--space-6);
      align-items: start;
    }
    .sticky h2 {
      grid-column: 1 / -1;
    }
    .portrait,
    .quote {
      margin-top: 0;
    }
  }
  @media screen and (max-width: 767px) {
    .sticky {
      grid-template-columns: 7rem 1fr;
      column-gap: var(--space-4);
    }
    .quote {
      font-size: var(--font-size-body);
      line-height: var(--line-height-body);
    }
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
