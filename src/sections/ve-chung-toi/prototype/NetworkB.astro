---
// PROTOTYPE B · Mạng lưới (throwaway, #125): 5. "Mạng lưới nhân tài" as the page's one bold
// moment. A dark-green band: "250+" in Pale Lime display type with who and where beside it, then
// the 22 places set as one large run of text (the names are the picture, no logos), then the
// achievements in a ruled row, the other community figures and the two ch. 07 paragraphs, and
// the report as a white card.
import { Image } from "astro:assets";
import Kicker from "../../../components/Kicker.astro";
import Section from "../../../components/Section.astro";
import BrandName from "../../../components/BrandName.astro";
import { anchors, network, reportCover } from "./data";

const places = [...network.universities, ...network.companies];
const others = network.figures.slice(2);
---

<Section name="network" tone="dark-green" width="large" spacing="large" id={anchors.network}>
  <Kicker flush>cộng đồng <BrandName /></Kicker>
  <h2 class="title">Mạng lưới nhân tài</h2>
  <div class="hero">
    <span class="big">{network.headline.value}</span>
    <p class="who">
      {network.headline.label}, {network.headline.where}.
      <span class="muted">{network.source}</span>
    </p>
  </div>

  <div class="places">
    <h3 class="small-head">Đang học tập và làm việc tại</h3>
    <p class="names">
      {
        places.map((n, i) => (
          <>
            <span class="name">{n}</span>
            {i < places.length - 1 && <span class="sep" aria-hidden="true">/</span>}{" "}
          </>
        ))
      }
    </p>
  </div>

  <h3 class="small-head">Thành tích của các thành viên</h3>
  <ul role="list" class="row">
    {
      network.achievements.map((a) => (
        <li>
          <span class="value">{a.value}</span>
          <span>{a.label}</span>
        </li>
      ))
    }
  </ul>

  <div class="bottom">
    <div class="texts">
      <p>{network.mentors}</p>
      <p>{network.alumni}</p>
    </div>
    <div class="side">
      <ul role="list" class="others">
        {
          others.map((f) => (
            <li>
              <span class="value">{f.value}</span>
              <span>
                <span class="label">{f.label}</span>
                <span class="muted">{f.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <a href={network.report.href} class="report" data-tone="white">
        <Image src={reportCover} alt="" widths={[160, 320]} sizes="160px" class="report-cover" />
        <span class="report-text">
          <span class="report-title">{network.report.title}</span>
          <span class="report-cta">{network.report.cta}</span>
        </span>
      </a>
    </div>
  </div>
</Section>

<style>
  .title {
    margin: var(--space-4) 0 var(--space-10);
  }
  .hero {
    display: flex;
    align-items: flex-end;
    gap: var(--space-8);
    margin-bottom: var(--space-16);
  }
  .big {
    color: var(--color-text-accent);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-black);
    letter-spacing: var(--letter-spacing-display);
    line-height: var(--line-height-display);
    font-variant-numeric: tabular-nums;
  }
  .who {
    max-width: 22rem;
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-h3);
  }
  .muted {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-regular);
  }
  .small-head {
    margin: 0 0 var(--space-4);
    color: var(--color-text-accent);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }
  .places {
    padding-top: var(--space-6);
    margin-bottom: var(--space-16);
    border-top: 1px solid var(--color-border-accent);
  }
  .names {
    margin: 0;
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-h2);
  }
  .name {
    white-space: nowrap;
  }
  .sep {
    margin-left: var(--space-2);
    color: var(--color-text-accent);
    font-weight: var(--font-weight-regular);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0 0 var(--space-16);
    padding: 0;
    list-style: none;
  }
  .row li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-6);
    border-left: 1px solid var(--color-border-accent);
  }
  .row li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .value {
    color: var(--color-text-accent);
    font-size: var(--font-size-big-number);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-display);
    font-variant-numeric: tabular-nums;
  }
  .bottom {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-accent);
  }
  .texts p {
    margin: 0 0 var(--space-4);
  }
  .others {
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }
  .others li {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .label {
    display: block;
    font-weight: var(--font-weight-extrabold);
  }
  .others .muted {
    margin-top: 0;
  }
  .report {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
  }
  .report-cover {
    width: 4rem;
    height: auto;
  }
  .report-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .report-title {
    color: var(--color-text-heading);
    font-weight: var(--font-weight-extrabold);
  }
  .report-cta {
    color: var(--color-link);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
  }
  @media screen and (max-width: 991px) {
    .row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-8);
    }
    .row li:nth-child(4) {
      padding-left: 0;
      border-left: 0;
    }
    .bottom {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media screen and (max-width: 767px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .names {
      font-size: var(--font-size-h3);
      line-height: var(--line-height-h3);
    }
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .row li:nth-child(4) {
      padding-left: var(--space-6);
      border-left: 1px solid var(--color-border-accent);
    }
    .row li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .others li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
