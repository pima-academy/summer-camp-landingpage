---
// Header: the dark green title band "Về chúng tôi" with the "PiMA academy > giới thiệu"
// breadcrumb. Used by ve-chung-toi only (old `section_about-header`); carries the footer
// anchor "Giới thiệu". Fades up on scroll.
import BrandName from "../../components/BrandName.astro";
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
import { aboutAnchors } from "../../data/site";
---

<Section name="header" width="large" spacing="none" tone="dark-green" animate id={aboutAnchors.intro}>
  <div class="inner">
    <div class="crumb"><Kicker flush><BrandName /> academy &gt; giới thiệu</Kicker></div>
    <h1 class="title">Về chúng tôi</h1>
  </div>
</Section>

<style>
  /* Section's spacing="large", except at ≤ 767 px (see below). */
  .inner {
    position: relative;
    padding-top: var(--space-28);
    padding-bottom: var(--space-28);
  }

  .crumb {
    margin-bottom: var(--space-2);
  }

  .title {
    color: var(--color-text-heading);
  }

  @media screen and (max-width: 991px) {
    .inner {
      padding-top: var(--space-24);
      padding-bottom: var(--space-24);
    }
  }

  /* Defect fix, as in PageHeader: the old 4rem top padding at ≤ 767 px put the breadcrumb
     under the 72 px fixed nav. Keep the tablet top padding (6rem). */
  @media screen and (max-width: 767px) {
    .inner {
      padding-bottom: var(--space-16);
    }
  }
</style>
