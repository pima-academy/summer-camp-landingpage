---
// Header: the dark green title band "Về chúng tôi" with the "PiMA academy > giới thiệu"
// breadcrumb. Used by ve-chung-toi only (old `section_about-header`); carries the footer
// anchor "Giới thiệu". Fades up on scroll.
import BrandName from "../../components/BrandName.astro";
import Section from "../../components/Section.astro";
import { aboutAnchors } from "../../data/site";
---

<Section name="header" width="large" spacing="none" animate id={aboutAnchors.intro} class="header">
  <div class="inner">
    <div class="crumb"><BrandName /> academy &gt; giới thiệu</div>
    <h1 class="title">Về chúng tôi</h1>
  </div>
</Section>

<style>
  .header {
    background-color: var(--color-background-dark-green);
  }

  /* Section's spacing="large", except at ≤ 767 px (see below). */
  .inner {
    position: relative;
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  .crumb {
    margin-bottom: 0.5rem;
    color: var(--color-text-accent);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
  }

  .title {
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-bold);
  }

  @media screen and (max-width: 991px) {
    .inner {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }
  }

  /* Defect fix, as in PageHeader: the old 4rem top padding at ≤ 767 px put the breadcrumb
     under the 72 px fixed nav. Keep the tablet top padding (6rem). */
  @media screen and (max-width: 767px) {
    .inner {
      padding-bottom: 4rem;
    }
  }
</style>
