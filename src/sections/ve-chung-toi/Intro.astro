---
// Intro: what PiMA is, next to two overlapping photos. Used by ve-chung-toi only
// (old `section_about-intro` / `header126_*`).
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { fluidWidths } from "../../lib/image-widths";
import introPhoto from "../../assets/images/screenshot-5.avif";
import introExpert from "../../assets/images/screenshot-31.avif";
---

<Section name="intro" width="large" spacing="small">
  <div class="layout">
    <div>
      <p class="lead"><strong>PiMA (Projects in Mathematics and Applications)</strong> là một tổ chức tiên phong trong lĩnh vực giáo dục toán học và ứng dụng, được thành lập vào năm 2016 bởi các nhà toán học Việt Nam đến từ những trường đại học hàng đầu thế giới. PiMA hướng đến mục tiêu đưa toán học đến gần hơn với thực tiễn, đồng thời tạo cầu nối giữa tri thức học thuật và các ứng dụng trong khoa học, công nghệ, và đời sống.</p>
    </div>
    <div class="photos">
      <div class="photo-main">
        <Image
          src={introPhoto}
          widths={fluidWidths(introPhoto)}
          sizes="(max-width: 767px) 63vw, (max-width: 1422px) calc(31.5vw - 22px), 426px"
          loading="eager"
          alt="Thành viên PiMA đứng cạnh banner giới thiệu PiMA"
          class="photo-main-img"
        />
      </div>
      <div class="photo-side">
        <Image
          src={introExpert}
          widths={fluidWidths(introExpert)}
          sizes="(max-width: 767px) 45vw, (max-width: 1422px) calc(22.5vw - 16px), 304px"
          loading="eager"
          alt="Chuyên gia của PiMA trình bày tại một hội thảo"
          class="photo-side-img"
        />
      </div>
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-16);
  }

  .lead {
    margin-bottom: var(--space-4);
    color: var(--color-text);
    text-align: left;
  }

  /* The portrait photo, with the square one overlapping its right edge. */
  .photos {
    position: relative;
    display: flex;
    width: 100%;
  }

  .photo-main {
    margin-right: 30%;
    overflow: hidden;
  }

  .photo-side {
    position: absolute;
    inset: 10% 0% auto auto;
    width: 50%;
    overflow: hidden;
  }

  .photo-main-img,
  .photo-side-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    overflow: clip;
  }

  .photo-main-img {
    aspect-ratio: 2 / 3;
  }

  .photo-side-img {
    aspect-ratio: 1;
  }

  @media screen and (max-width: 767px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
