---
// MemberUniversities: "Thành viên của chúng tôi đến từ", a row of university logos
// (a second, hidden copy follows it). Used by ve-chung-toi only
// (old `section_about-member-uni` / `logo3_*`).
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import ucla from "../../assets/images/university-of-california-los-angeles-logo.avif";
import stonyBrook from "../../assets/images/large-blob.avif";
import nus from "../../assets/images/national-university-of-singapore-logo-wine.avif";
import ntu from "../../assets/images/nanyang-technological-university-logo-wine.avif";
import khtn from "../../assets/images/truong-dai-hoc-khoa-hoc-tu-nhien-dai-hoc-quoc-gia-thanh-pho-ho-chi-minh.avif";
import hcmut from "../../assets/images/hcmut-official-logo.avif";
import williamMary from "../../assets/images/vi-logo.avif";
import hust from "../../assets/images/logo-dai-hoc-bach-khoa-ha-noi.avif";

// `width` = rendered width at the 4.5rem (72 px) max-height. Stony Brook had a width="84"
// attribute on the old page (`fixed`: its box keeps that width); the others had none.
const universities = [
  { image: ucla, width: 190, alt: "Logo Đại học California, Los Angeles (UCLA)" },
  { image: stonyBrook, width: 84, alt: "Logo Đại học Stony Brook", fixed: true },
  { image: nus, width: 108, alt: "Logo Đại học Quốc gia Singapore (NUS)" },
  { image: ntu, width: 108, alt: "Logo Đại học Công nghệ Nanyang (NTU)" },
  { image: khtn, width: 88, alt: "Logo Trường Đại học Khoa học Tự nhiên, ĐHQG-HCM" },
  { image: hcmut, width: 71, alt: "Logo Trường Đại học Bách khoa, ĐHQG-HCM" },
  { image: williamMary, width: 116, alt: "Logo Đại học William & Mary" },
  { image: hust, width: 48, alt: "Logo Đại học Bách khoa Hà Nội" },
];
---

<Section name="member-universities" width="medium" spacing="small" class="universities">
  <div class="content">
    <div class="intro">
      <h2>Thành viên của chúng tôi đến từ</h2>
    </div>
    <div class="lists">
      {
        [0, 1].map((copy) => (
          <div
            class="list"
            aria-hidden={copy === 1 ? "true" : undefined}
          >
            {universities.map((u) => (
              <div class="cell">
                <Image
                  src={u.image}
                  width={u.width}
                  densities={[1, 2]}
                  alt={u.alt}
                  class="logo-img"
                  data-logo
                  data-fixed={u.fixed ? "" : undefined}
                />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .universities {
    overflow: clip;
  }

  .content {
    margin-bottom: var(--space-12);
  }

  /* The old spacer under the heading is the bottom padding. */
  .intro {
    width: 100%;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
    padding-bottom: var(--space-8);
    text-align: center;
  }

  .lists {
    display: flex;
    gap: var(--space-5);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(8, 12.5rem);
    justify-content: flex-end;
    place-items: center start;
    gap: var(--space-4) var(--space-6);
    margin-right: var(--space-8);
    overflow: visible;
    white-space: nowrap;
  }

  .cell {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    justify-self: center;
  }

  /* The old logos had no width attribute (except Stony Brook's 84): every source is taller
     than the 4.5rem (3rem at ≤ 767 px) max-height, so each box was max-height tall and
     followed the image's aspect ratio. Same box here, sized before the lazy image loads. */
  .logo-img {
    box-sizing: content-box;
    max-width: 100%;
    height: 4.5rem;
    max-height: 4.5rem;
    object-fit: contain;
  }

  .logo-img:not([data-fixed]) {
    width: auto;
  }

  @media screen and (max-width: 991px) {
    .content {
      margin-bottom: var(--space-10);
    }

    .intro {
      padding-bottom: var(--space-6);
    }
  }

  @media screen and (max-width: 767px) {
    .content {
      margin-bottom: var(--space-6);
    }

    .intro {
      padding-bottom: var(--space-5);
    }

    .list {
      grid-template-columns: repeat(8, 10rem);
      column-gap: var(--space-4);
      padding-top: var(--space-4);
    }

    .cell {
      padding: var(--space-3) var(--space-4);
    }

    .logo-img {
      height: 3rem;
      max-height: 3rem;
    }
  }

  @media screen and (max-width: 479px) {
    .list {
      justify-content: center;
    }
  }
</style>
