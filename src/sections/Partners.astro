---
// "Đối tác của PiMA" section (old `section_partners`, identical on index, ve-chung-toi
// and trai-he-toan-hoc-pima). Fades up on scroll.
import { Image } from "astro:assets";
import BrandName from "../components/BrandName.astro";
import { partnerLogos } from "./partners";

interface Props {
  /** Section id. The old markup used "doi-tac"; ve-chung-toi may pass its footer anchor instead. */
  id?: string;
}

const { id = "doi-tac" } = Astro.props;
---

<div id={id} data-animate="fade-up" class="section_partners">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-medium">
        <div class="text-align-center">
          <div class="max-width-large align-center">
            <h5 class="text-style-green text-style-allcaps">đối tác của <BrandName /></h5>
            <div class="margin-bottom margin-small">
              <h2>Chúng tôi được tin tưởng bởi các tổ chức hàng đầu</h2>
            </div>
            <p class="text-size-medium text-align-center">
              Từ các trường đại học danh tiếng đến doanh nghiệp công nghệ và viện nghiên cứu, PiMA tự hào đồng hành cùng
              những đối tác có chung sứ mệnh: nâng cao chất lượng giáo dục và ứng dụng Toán học vào thực tiễn.
            </p>
            <div class="margin-top margin-medium">
              {
                partnerLogos.map((logo) => (
                  <div class="logo-image-wrapper">
                    <Image src={logo.src} alt={logo.alt} width={logo.width} densities={[1, 2]} />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
