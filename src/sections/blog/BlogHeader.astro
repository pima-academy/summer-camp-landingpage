---
// BlogHeader: the title band of /blog/ (src/pages/blog/index.astro), the "PiMA academy" kicker
// over the "Blog" heading. Fades up on scroll. Not PageHeader: besides its breadcrumb ("PiMA
// academy", no "> chương trình"), it takes the large column to line up with PostGrid and a
// shorter bottom padding, since the grid follows with its own.
import BrandName from "../../components/BrandName.astro";
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";
---

<Section name="blog-header" width="large" spacing="none" tone="surface" animate>
  <div class="inner">
    <div class="crumb">
      <Kicker flush><BrandName /> academy</Kicker>
    </div>
    <h1 class="title">Blog</h1>
  </div>
</Section>

<style>
  /* Room for the fixed nav above, as PageHeader; the large column lines up with PostGrid. */
  .inner {
    padding-top: var(--space-28);
    padding-bottom: var(--space-16);
  }

  .crumb {
    margin-bottom: var(--space-2);
  }

  .title {
    margin-bottom: 0;
  }

  @media screen and (max-width: 991px) {
    .inner {
      padding-top: var(--space-24);
      padding-bottom: var(--space-12);
    }
  }
</style>
