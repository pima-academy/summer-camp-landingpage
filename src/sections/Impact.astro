---
// Impact: "Những con số nổi bật", the six cleared figures as one ruled row (6 / 3 / 2 columns)
// with their source line, and the impact report as a wide surface card (real cover, text in
// HTML, link to Issuu). Content in impact.ts. Used by index and trai-he-toan-hoc-pima.
import { Image } from "astro:assets";
import Kicker from "../components/Kicker.astro";
import Section from "../components/Section.astro";
import { figures, figuresSource, report } from "./impact";
---

<Section name="impact" width="large" spacing="medium">
  <div class="head">
    <div>
      <Kicker>tác động</Kicker>
      <h2 class="title">Những con số nổi bật</h2>
    </div>
    <p class="source">{figuresSource}</p>
  </div>
  <ul role="list" class="figures">
    {
      figures.map((f) => (
        <li>
          <span class="value">{f.value}</span>
          <span class="label">{f.label}</span>
          <span class="detail">{f.detail}</span>
        </li>
      ))
    }
  </ul>
  <a href={report.href} class="report" data-tone="surface">
    <Image src={report.cover} alt="" widths={[96, 192]} sizes="96px" class="report-cover" />
    <span class="report-text">
      <span class="report-title">{report.title}</span>
      <span>{report.text}</span>
      <span class="report-cta">{report.cta}</span>
    </span>
  </a>
</Section>

<style>
  /* Kicker and heading left, the source line right, on the heading's baseline side. */
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .title {
    margin: 0;
  }

  .source {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  /* One ruled row: a thin rule before every figure but the first of a row. */
  .figures {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  .figures li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .figures li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .value {
    color: var(--color-text-accent);
    font-size: var(--font-size-big-number);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-display);
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-weight: var(--font-weight-extrabold);
  }

  .detail {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  /* The report: the whole card is the link; its last line looks like one. */
  .report {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
  }

  .report-cover {
    width: 6rem;
    height: auto;
    box-shadow: var(--shadow-dropdown);
  }

  .report-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .report-title {
    color: var(--color-text-heading);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-h3);
  }

  .report-cta {
    color: var(--color-link);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
  }

  .report:hover .report-cta {
    color: var(--color-link-hover);
  }

  @media screen and (max-width: 991px) {
    .figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--space-8);
    }

    .figures li:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media screen and (max-width: 767px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .figures li:nth-child(3n + 1) {
      padding-left: var(--space-4);
      border-left: 1px solid var(--color-border);
    }

    .figures li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .report {
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-4);
    }
  }
</style>
