---
// Impact: "Tác động" section, the impact report link and six highlight numbers. Used by
// index, ve-chung-toi and trai-he-toan-hoc-pima (old `section_impact`). Fades up on scroll.
import { Image } from "astro:assets";
import report from "../assets/images/pima-impact-report.png";
import Kicker from "../components/Kicker.astro";
import Section from "../components/Section.astro";
import { fluidWidths } from "../lib/image-widths";

interface Props {
  /** Section id. The old markup used "tac-dong"; ve-chung-toi may pass its footer anchor instead. */
  id?: string;
}

const { id = "tac-dong" } = Astro.props;

const numbers = [
  { value: "1000+", label: "Người tham gia" },
  { value: "9", label: "Trại hè Toán học và Ứng dụng" },
  { value: "50+", label: "Dự án học thuật của học sinh được hoàn thành" },
  { value: "80+", label: "Bài giảng về Toán cao cấp và Ứng dụng" },
  { value: "6", label: "Workshop tại các trường THPT trọng điểm tại TP.HCM" },
  { value: "200+", label: "Trại sinh THPT tài năng được tuyển chọn" },
];
---

<Section name="impact" spacing="medium" animate id={id}>
  <div class="layout">
    <div>
      <Kicker>tác động</Kicker>
      <h2 class="title">Những con số<br />nổi bật</h2>
      <div class="report">
        <a href="https://issuu.com/pimavn/docs/pima_impact_report_2016-2024_vietnamese_version_" class="report-link">
          <Image
            src={report}
            alt="Báo cáo tác động PiMA 2016–2024"
            widths={fluidWidths(report)}
            sizes="(max-width: 479px) 100vw, (max-width: 991px) 30vw, 331px"
          />
        </a>
      </div>
    </div>
    <div class="numbers">
      {
        numbers.map(({ value, label }) => (
          <div>
            <h4 class="value">{value}</h4>
            <div>{label}</div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-4);
  }

  .title {
    margin-top: 0;
    margin-bottom: 0;
  }

  /* 1rem gap under the heading (the old spacer). */
  .report {
    padding-top: var(--space-4);
  }

  .report-link {
    display: inline-block;
    max-width: 100%;
  }

  .numbers {
    display: grid;
    grid-column: span 2;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-left: var(--space-16);
  }

  .value {
    margin-top: 0;
    margin-bottom: 0;
    color: var(--color-text-accent);
    font-size: var(--font-size-big-number);
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }

  @media screen and (max-width: 479px) {
    .layout {
      display: flex;
      flex-direction: column;
    }

    .numbers {
      padding-left: 0;
    }
  }
</style>
