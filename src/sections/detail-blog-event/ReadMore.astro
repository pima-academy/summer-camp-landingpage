---
/*
  ReadMore: "Đọc thêm" on the gap page /detail-blog-event/
  (src/gap-pages/detail-blog-event.astro). A template for one related-post card
  (image, tag, title; empty and `hidden`, as the old site's empty CMS bindings were),
  the empty-list box "No items found." and the Previous/Next pagination, all kept as
  on the old site. Replaces the old `section_blogpost-read-more` markup.
*/
import { Image } from "astro:assets";
import Icon from "../../components/Icon.astro";
import Section from "../../components/Section.astro";
import cardPlaceholder from "../../assets/images/placeholder-image-landscape.svg";
---

<Section name="read-more" width="small" spacing="small" tone="surface">
  <h2>Đọc thêm</h2>
  <div>
    <div role="list" class="cards">
      <div role="listitem" class="cell">
        <a href="#" class="card-link">
          <div class="media">
            <Image src={cardPlaceholder} alt="" class="cover" hidden />
            <div class="tag" data-tone="pale-lime" hidden></div>
          </div>
          <h4 class="card-title" hidden></h4>
        </a>
      </div>
    </div>
    <div class="empty">
      <div>No items found.</div>
    </div>
    <div role="navigation" aria-label="List" class="pagination">
      <a href="#" aria-label="Previous Page" class="page-link" data-tone="white">
        <Icon name="chevron-left" size="16" class="arrow-prev" />
        <div class="page-label">Previous</div>
      </a>
      <a href="#" aria-label="Next Page" class="page-link" data-tone="white">
        <div class="page-label">Next</div>
        <Icon name="chevron-right" size="16" class="arrow-next" />
      </a>
    </div>
  </div>
</Section>

<style>
  .cards {
    display: flow-root;
  }

  .cell {
    position: relative;
    float: left;
    width: 33.33333333%;
    min-height: 1px;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }

  .card-link {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }

  .media {
    position: relative;
    width: 100%;
    margin-bottom: var(--space-2);
    overflow: clip;
  }

  .cover {
    width: 100%;
    max-width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .tag {
    display: inline-flex;
    position: absolute;
    inset: 2% auto auto 5%;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 2px solid transparent;
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: var(--font-size-small);
    letter-spacing: var(--letter-spacing-tag);
    text-transform: uppercase;
  }

  .card-title {
    margin-bottom: var(--space-1);
    color: var(--color-text);
  }

  /* An empty Webflow CMS list, kept from the old site; dev only like the whole gap page. */
  .empty {
    padding: var(--space-3);
    background-color: var(--color-background-empty-list);
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .page-link {
    display: block;
    margin-left: var(--space-3);
    margin-right: var(--space-3);
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: var(--font-size-small);
  }

  .page-label {
    display: inline-block;
    max-width: 100%;
  }

  .arrow-prev {
    margin-right: var(--space-1);
  }

  .arrow-next {
    margin-left: var(--space-1);
  }

  @media screen and (max-width: 767px) {
    .cell {
      width: 100%;
    }
  }

  /* Empty CMS bindings (old `w-dyn-bind-empty`); after the rules above so it wins. */
  [hidden] {
    display: none;
  }
</style>
