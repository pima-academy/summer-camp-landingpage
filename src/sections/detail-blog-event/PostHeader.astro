---
/*
  PostHeader: the post itself on the gap page /detail-blog-event/
  (src/gap-pages/detail-blog-event.astro), a template for one post or event: image,
  tag, title, "Ngày đăng:" date and body. Everything but the "Ngày đăng:" label is an
  empty, `hidden` binding, as on the old site. Replaces the old `section_blogpost-header`
  markup.

  The post image was Webflow's CDN placeholder (140 x 140, hidden by `w-dyn-bind-empty`);
  the local Webflow placeholder SVG stands in for it.
*/
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import postPlaceholder from "../../assets/images/6191a88a1c0e39463c2bf022-placeholder-image.svg";
---

<Section name="post-header" width="small" spacing="none">
  <div class="inner">
    <Image src={postPlaceholder} alt="" width={140} densities={[1, 2]} hidden />
    <div class="tag-row">
      <div class="tag" hidden></div>
    </div>
    <h1 class="title" hidden></h1>
    <div class="date">
      <div>Ngày đăng:</div>
      <div hidden></div>
    </div>
    <div class="body">
      <div hidden></div>
    </div>
  </div>
</Section>

<style>
  .inner {
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .tag-row {
    margin-bottom: 0.25rem;
    padding-top: 2rem;
  }

  .tag {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    padding: 0.15em 0.75em;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    background-color: var(--color-background-pale-lime);
    color: var(--color-text);
    font-size: var(--font-size-tag);
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .title {
    font-size: var(--font-size-heading-style-h2);
    font-weight: var(--font-weight-heading-style);
    line-height: var(--line-height-heading-style-h2);
  }

  .date {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 4px;
  }

  .body {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  @media screen and (max-width: 991px) {
    .tag-row {
      padding-top: 1.5rem;
    }

    .body {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }
  }

  @media screen and (max-width: 767px) {
    .tag-row {
      padding-top: 1.25rem;
    }

    .body {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }
  }

  /* Empty CMS bindings (old `w-dyn-bind-empty`); after the rules above so it wins. */
  [hidden] {
    display: none;
  }
</style>
