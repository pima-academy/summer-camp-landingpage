---
// Press: "Báo chí nói về PiMA", a slider of press quotes (press.ts), one at a time with 5 s
// autoplay: the newspaper's logo, linking to the article, above its quote in typographic
// quotes. Used by index only.
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import Slider from "../../components/Slider.astro";
import { pressQuotes } from "./press";
---

<Section name="press" width="medium" spacing="small">
  <h2 class="heading">Báo chí nói về PiMA</h2>
  <Slider layout="single" autoplay={5000} infinite label="Báo chí nói về PiMA">
    {
      pressQuotes.map((item) => (
        <div>
          <figure class="quote">
            <a href={item.href} target="_blank" class="logo-link">
              <Image src={item.logo} alt={item.alt} width={112} densities={[1, 2]} class="logo" data-logo />
            </a>
            <blockquote>“{item.quote}”</blockquote>
          </figure>
        </div>
      ))
    }
  </Slider>
</Section>

<style>
  .heading {
    margin-top: 0;
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .quote {
    max-width: var(--width-small);
    margin: 0 auto;
    text-align: center;
  }

  .logo-link {
    display: inline-block;
  }

  /* A logo: square corners (base CSS, data-logo) and the whole of it in its box, never cropped. */
  .logo {
    display: block;
    width: 7rem;
    height: 3rem;
    object-fit: contain;
  }

  .quote blockquote {
    margin: var(--space-4) 0 0;
  }
</style>
