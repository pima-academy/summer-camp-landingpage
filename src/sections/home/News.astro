---
// News: "Thông tin mới nhất", the news list as the old site left it: one empty post card
// (blank space where its cover image goes), the "No items found." line and a button to all
// news. Used by index only (old `section_news`), inside a ContentGap, so it never reaches the
// build. The old card's cover image, date tag, title and summary were empty CMS fields; they
// come back with the content. Fades up on scroll.
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
---

<Section name="news" width="medium" spacing="medium" animate>
  <h2 class="heading">Thông tin mới nhất</h2>
  <div role="list" class="posts">
    <div role="listitem" class="post">
      <div class="cover"></div>
      <div class="post-body"></div>
    </div>
  </div>
  <div class="empty">No items found.</div>
  <div class="actions">
    <Button href="/su-kien-blog/" variant="secondary" target="_blank">Tất cả tin tức</Button>
  </div>
</Section>

<style>
  .heading {
    margin-top: 0;
    margin-bottom: 0;
    text-align: center;
  }

  .posts {
    padding-top: 2rem;
  }

  /* A third of the row (old Webflow grid column `w-col-4`). */
  .post {
    width: 33.33333333%;
    padding-left: 10px;
    padding-right: 10px;
  }

  .cover {
    height: 12rem;
  }

  /* The card's padding plus the old 1rem spacer under the (empty) text. */
  .post-body {
    padding-top: 1.25rem;
    padding-bottom: 1rem;
  }

  .empty {
    padding: 10px;
    background-color: var(--color-background-empty-list);
  }

  /* Old `.button-group.is-center`, after a spacer. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    padding-top: 2rem;
  }

  @media screen and (max-width: 991px) {
    .posts,
    .actions {
      padding-top: 1.5rem;
    }

    .post-body {
      padding-top: 3rem;
      padding-bottom: 2rem;
    }
  }

  @media screen and (max-width: 767px) {
    .posts,
    .actions {
      padding-top: 1.25rem;
    }

    .post {
      width: 100%;
    }

    .post-body {
      padding-top: 2.5rem;
      padding-bottom: 1.5rem;
    }
  }

  @media screen and (max-width: 479px) {
    .post {
      margin-bottom: 1rem;
    }

    .post-body {
      padding-top: 1.125rem;
      padding-bottom: 0.5rem;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
