---
// FoundingStory: "Câu chuyện nhà sáng lập", a dark green panel (the dark-green tone on a card) with a short text, a link to
// ve-chung-toi and the founder's photo. Used by index only (old `section_founding-story`).
// Fades up on scroll.
import { Image } from "astro:assets";
import founder from "../../assets/images/pima-founder.png";
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
---

<Section name="founding-story" width="medium" spacing="medium" animate>
  <div class="panel" data-tone="dark-green">
    <div class="story">
      <!-- Not a Kicker: lime, regular weight, h4 size (old `h4 text-style-lime text-style-allcaps`). -->
      <p class="eyebrow">Câu chuyện nhà sáng lập</p>
      <h3 class="heading">Các chương trình của chúng tôi</h3>
      <p class="lead">
        Từ các trường đại học danh tiếng đến doanh nghiệp công nghệ và viện nghiên cứu, PiMA tự hào đồng hành cùng những
        đối tác có chung sứ mệnh: nâng cao chất lượng giáo dục và ứng dụng Toán học vào thực tiễn.
      </p>
      <div class="actions">
        <Button href="/ve-chung-toi/" variant="on-dark" target="_blank">Câu chuyện về PiMA</Button>
      </div>
    </div>
    <div>
      <Image src={founder} alt="Nhà sáng lập PiMA" width={257} densities={[1, 2]} />
    </div>
  </div>
</Section>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-columns: 1fr;
    gap: 16px;
    place-items: center;
    padding: 2rem;
    border-radius: var(--radius-panel);
  }

  .story {
    width: 100%;
    max-width: 56rem;
    text-align: left;
  }

  .eyebrow {
    margin-top: 10px;
    margin-bottom: 0.5em;
    color: var(--color-text-accent);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-h4);
    line-height: var(--line-height-h4);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .heading {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .lead {
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  /* Old `.button-group`, 1rem below the text. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
  }

  @media screen and (max-width: 479px) {
    .panel {
      display: flex;
      flex-direction: column;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
