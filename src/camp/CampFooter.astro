---
// Footer of the 2025/2026 camp pages: the old Webflow footer of trai-he-toan-hoc-2025
// (company name, phone/email/address, no "Về PiMA" / "Sản phẩm" columns), split off from
// the site Footer's former `variant="camp"` (#60). The `w-node-*` ids are kept: the
// frozen stylesheet places the grid cells by id.
import { Image } from "astro:assets";
import logo from "../assets/images/logo-1.avif";
import mailIcon from "../assets/images/mail.png";
import mapPinIcon from "../assets/images/map-pin.png";
import phoneIcon from "../assets/images/phone.png";
import BrandName from "../components/BrandName.astro";
import { contact } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="background-color-dark">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-vertical padding-xxlarge">
          <div class="padding-bottom padding-xxlarge">
            <div class="w-layout-grid footer3_top-wrapper">
              <div id="w-node-_28a166f2-cbf9-5100-bc58-0e831f150a10-57c668ac" class="footer3_left-wrapper">
                <div class="margin-bottom">
                  <a href="/" class="footer3_logo-link w-nav-brand" aria-label="PiMA, trang chủ">
                    <Image src={logo} alt="" width={91} densities={[1, 2]} class="footer3_logo" />
                  </a>
                </div>
                <div class="margin-bottom">
                  <div class="footer3_details-wrapper">
                    <div class="spacer-small"></div>
                    <div class="margin-bottom margin-tiny">
                      <div class="text-size-small text-weight-semibold text-style-white text-style-allcaps">
                        Công ty Cổ phần <BrandName /> Academy
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div id="w-node-_28a166f2-cbf9-5100-bc58-0e831f150a1a-57c668ac" class="footer_content_right">
                <div id="w-node-_28a166f2-cbf9-5100-bc58-0e831f150a37-57c668ac" class="footer_form-info">
                  <h4 class="text-style-allcaps text-style-green">Liên hệ</h4>
                  <div class="footer_contact">
                    <div class="footer_icon-wrapper">
                      <Image src={phoneIcon} alt="" width={24} />
                    </div>
                    <div>
                      <div class="text-style-gray text-weight-bold">Số điện thoại</div>
                      <div class="text-style-gray">{contact.phone}</div>
                    </div>
                  </div>
                  <div class="spacer-small"></div>
                  <div class="footer_contact">
                    <div class="footer_icon-wrapper">
                      <Image src={mailIcon} alt="" width={24} />
                    </div>
                    <div>
                      <div class="text-style-gray text-weight-bold">Email</div>
                      <a href={contact.emailHref} class="text-style-gray">
                        {contact.email}
                      </a>
                    </div>
                  </div>
                  <div class="spacer-small"></div>
                  <div class="footer_contact">
                    <div class="footer_icon-wrapper">
                      <Image src={mapPinIcon} alt="" width={31} />
                    </div>
                    <div>
                      <div class="text-style-gray text-weight-bold">Địa chỉ</div>
                      <div class="text-style-gray">{contact.address}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="divider-horizontal"></div>
          <div class="border-top">
            <div class="padding-top padding-medium">
              <div class="footer3_bottom-wrapper">
                <div class="footer3_credit-text text-style-gray">© {year} PiMA Academy. All rights reserved.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
