---
// Layout of the frozen 2025/2026 camp pages: the shared <head> (src/layouts/Head.astro),
// no Nav, the page, CampFooter and the decorative animations. Loads only the frozen CSS
// (./styles/camp.css), never the site's global.css.
import Head, { type Props as HeadProps } from "../layouts/Head.astro";
import CampFooter from "./CampFooter.astro";
import "./styles/camp.css";

type Props = HeadProps;
---

<!doctype html>
<html lang="vi">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <CampFooter />
    <script>
      import { initAnimations } from "./animate";
      initAnimations();
    </script>
  </body>
</html>
