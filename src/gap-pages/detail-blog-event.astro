---
/*
  Gap page /detail-blog-event/ (old `detail_blog-event.html`): the Webflow CMS
  template of one post or event. Empty bindings, the "Đọc thêm" list and its
  Previous/Next pagination are kept as they were, as a template for future posts.
  Dev only; see src/pages/[...gap].astro.

  The post image was Webflow's CDN placeholder (140 x 140, hidden by
  `w-dyn-bind-empty`); the local Webflow placeholder SVG stands in for it.
*/
import { Image } from "astro:assets";
import ContactSection from "../components/ContactSection.astro";
import postPlaceholder from "../assets/images/6191a88a1c0e39463c2bf022-placeholder-image.svg";
import cardPlaceholder from "../assets/images/placeholder-image-landscape.svg";
---

<section class="section_blogpost-header">
  <div class="padding-global">
    <div class="container-small">
      <div class="padding-section-tiny">
        <Image src={postPlaceholder} alt="" width={140} densities={[1, 2]} class="w-dyn-bind-empty" />
        <div class="spacer-medium"></div>
        <div class="margin-bottom margin-xxsmall">
          <div class="tag-2 is-text w-dyn-bind-empty"></div>
        </div>
        <h1 class="heading-style-h2 w-dyn-bind-empty"></h1>
        <div class="div-block-15">
          <div>Ngày đăng:</div>
          <div class="w-dyn-bind-empty"></div>
        </div>
        <div class="spacer-large"></div>
        <div class="w-dyn-bind-empty w-richtext"></div>
        <div class="spacer-large"></div>
      </div>
    </div>
  </div>
</section>
<section class="section_blogpost-read-more">
  <div class="padding-global">
    <div class="container-small">
      <div class="padding-section-small">
        <div class="read-more-component">
          <h2 class="heading-style-h4">Đọc thêm</h2>
          <div class="w-dyn-list">
            <div role="list" class="w-dyn-items w-row">
              <div role="listitem" class="w-dyn-item w-col w-col-4">
                <a href="#" class="blog5_item-link w-inline-block">
                  <div class="margin-bottom margin-xsmall">
                    <div class="blog5_image-wrapper">
                      <Image src={cardPlaceholder} alt="" class="blog5_image w-dyn-bind-empty" />
                      <div class="tag-2 is-text is-absolute w-dyn-bind-empty"></div>
                    </div>
                  </div>
                  <div class="margin-bottom margin-xxsmall">
                    <h4 class="heading-custom2 w-dyn-bind-empty"></h4>
                  </div>
                </a>
              </div>
            </div>
            <div class="w-dyn-empty">
              <div>No items found.</div>
            </div>
            <div role="navigation" aria-label="List" class="w-pagination-wrapper">
              <a href="#" aria-label="Previous Page" class="w-pagination-previous previous-2"><svg class="w-pagination-previous-icon" height="12px" width="12px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" transform="translate(0, 1)">
                  <path fill="none" stroke="currentColor" fill-rule="evenodd" d="M8 10L4 6l4-4"></path>
                </svg>
                <div class="w-inline-block">Previous</div>
              </a>
              <a href="#" aria-label="Next Page" class="w-pagination-next next-3">
                <div class="w-inline-block">Next</div><svg class="w-pagination-next-icon" height="12px" width="12px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" transform="translate(0, 1)">
                  <path fill="none" stroke="currentColor" fill-rule="evenodd" d="M4 2l4 4-4 4"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<ContactSection />
<div class="spacer-medium"></div>
