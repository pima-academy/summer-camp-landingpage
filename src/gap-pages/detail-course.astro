---
/*
  Gap page /detail-course/ (old `detail_course.html`): the Webflow CMS template
  of one course. Placeholder text, sample mentors/testimonials and empty
  bindings are kept as they were, as a template for future courses.
  Dev only; see src/pages/[...gap].astro.

  Both image lightboxes were empty on the old site: inline content gaps whose
  fallback keeps the box without the click.
*/
import { Image } from "astro:assets";
import ContactSection from "../components/ContactSection.astro";
import ContentGap from "../components/ContentGap.astro";
import Slider from "../components/Slider.astro";
import { fluidWidths } from "../lib/image-widths";
import cover from "../assets/images/dan-cristian-padure-h3kuhyuce9a-unsplash.avif";
import partner from "../assets/images/partner-logo-04-big.avif";
import avatar from "../assets/images/artboard-3-4x.avif";
import blankAvatar from "../assets/images/blank-avatar.png";

// The cover and partner images carry `w-dyn-bind-empty` (display: none) and load lazily, so they are
// never fetched. `sizes` is the content column (`container-custom`): 351/738/960 px at 390/820/1440;
// the partner image's grid cell is at most that wide.
const coverSizes = "(max-width: 1066px) 90vw, 960px";
const partnerSizes = coverSizes;
---

<section id="course1" class="section_course-detail" data-animate="fade-up">
  <div class="padding-global">
    <div class="container-custom">
      <div class="padding-section-medium">
        <div class="course-description-component">
          <ContentGap name="detail-course: cover image lightbox" inline>
            <a href="#" class="course-description-cover w-inline-block w-dyn-bind-empty w-lightbox">
              <div class="gallery1_image-wrapper"><Image src={cover} alt="" widths={fluidWidths(cover)} sizes={coverSizes} class="gallery1_image-2 w-dyn-bind-empty" /></div>
            </a>
            <Fragment slot="fallback">
              <div class="course-description-cover w-inline-block w-dyn-bind-empty">
                <div class="gallery1_image-wrapper"><Image src={cover} alt="" widths={fluidWidths(cover)} sizes={coverSizes} class="gallery1_image-2 w-dyn-bind-empty" /></div>
              </div>
            </Fragment>
          </ContentGap>
          <div class="margin-bottom">
            <div class="max-width-large">
              <div class="margin-bottom margin-small">
