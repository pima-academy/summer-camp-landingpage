---
// The <head> contents of BaseLayout (every site page): meta, canonical, Open Graph, icons and
// the JS-ready class (the nav dropdown and the accordion style their no-JS fallback under
// `html:not(.js-ready)`). No CSS here: BaseLayout imports global.css.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
// 1200 × 630, the horizontal logo on white (scripts/make-icons.mjs).
import ogFallback from "../assets/images/og-fallback.png";

export interface Props {
  /** Page <title> and og:title. */
  title: string;
  /** Meta description and og:description. */
  description: string;
  /** The page's hero photo, used for og:image (1200 px wide JPEG). Without it: og-fallback.png. */
  hero?: ImageMetadata;
  /** Adds `meta robots noindex` and drops canonical/og:url (404 page: served at any missing URL). */
  noindex?: boolean;
}

const { title, description, hero, noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://pimavn.com");
const canonical = new URL(Astro.url.pathname, site).href;

// Width only, so the image keeps its aspect ratio (no crop). Capped at the
// source width: the image service never upscales, and og:image:width must match.
const ogSrc = hero ?? ogFallback;
const og = await getImage({
  src: ogSrc,
  width: Math.min(1200, ogSrc.width),
  format: hero ? "jpg" : "png",
});
const ogImage = new URL(og.src, site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="vi_VN" />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(og.attributes.width)} />
<meta property="og:image:height" content={String(og.attributes.height)} />
{/* Icons: the brand symbol alone, generated by scripts/make-icons.mjs. */}
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
{
  /*
    JS-ready class: this script adds `js-ready` to <html> before first paint.
    The nav dropdown and the accordion collapse only under `html.js-ready`, so
    all content stays reachable without JS. The script at the end of each
    layout's <body> runs the timeline dots.
  */
}
<script is:inline>
  document.documentElement.classList.add("js-ready");
</script>
