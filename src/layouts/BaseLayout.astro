---
// Layout of every site page: the shared <head>, Nav, the page, Footer and the founder
// timeline's scroll-driven dots (src/lib/timeline-dots.ts).
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import Head, { type Props as HeadProps } from "./Head.astro";
import "../styles/global.css";

type Props = HeadProps;
---

<!doctype html>
<html lang="vi">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initTimelineDots } from "../lib/timeline-dots";
      initTimelineDots();
    </script>
  </body>
</html>
