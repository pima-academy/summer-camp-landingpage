---
// Layout of every site page: the shared <head>, Nav, the page, Footer and the decorative
// animations. The frozen 2025/2026 camp pages use src/camp/CampLayout.astro instead.
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Head, { type Props as HeadProps } from "./Head.astro";
import "../styles/global.css";

type Props = HeadProps;
---

<!doctype html>
<html lang="vi">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initAnimations } from "../lib/animate";
      initAnimations();
    </script>
  </body>
</html>
