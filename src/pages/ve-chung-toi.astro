---
// "Về chúng tôi" (old site/ve-chung-toi.html). The six "Về PiMA" footer anchors
// (`aboutAnchors` in site.ts) sit on the matching sections.
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../sections/ContactSection.astro";
import Impact from "../sections/Impact.astro";
import Milestone from "../sections/Milestone.astro";
import Partners from "../sections/Partners.astro";
import Philosophy from "../sections/Philosophy.astro";
import ProgramsOverview from "../sections/ProgramsOverview.astro";
import Team from "../sections/Team.astro";
import Actions from "../sections/ve-chung-toi/Actions.astro";
import FounderStory from "../sections/ve-chung-toi/FounderStory.astro";
import FuturePlans from "../sections/ve-chung-toi/FuturePlans.astro";
import Header from "../sections/ve-chung-toi/Header.astro";
import Intro from "../sections/ve-chung-toi/Intro.astro";
import MemberUniversities from "../sections/ve-chung-toi/MemberUniversities.astro";
import VisionMission from "../sections/ve-chung-toi/VisionMission.astro";
import { aboutAnchors } from "../data/site";
import introPhoto from "../assets/images/screenshot-5.avif";
---

<BaseLayout
  title="Về chúng tôi - PiMA Academy"
  description="PiMA (Projects in Mathematics and Applications) là tổ chức giáo dục toán học và ứng dụng do các nhà toán học Việt Nam thành lập năm 2016: tầm nhìn, sứ mệnh, câu chuyện nhà sáng lập và kế hoạch tương lai."
  hero={introPhoto}
>
  <Header />
  <Intro />
  <VisionMission />
  <ProgramsOverview />
  <Impact id={aboutAnchors.impact} />
  <Actions />
  <Milestone />
  <Partners id={aboutAnchors.partners} />
  <Philosophy />
  <Team />
  <MemberUniversities />
  <FounderStory />
  <FuturePlans />
  <ContactSection />
</BaseLayout>
