---
// Home page (/): BaseLayout, the SEO data and the ordered list of its sections (spec #131,
// "Home"). Its own sections live in src/sections/home/, the shared ones in src/sections/.
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../sections/ContactSection.astro";
import Impact from "../sections/Impact.astro";
import Partners from "../sections/Partners.astro";
import Testimonials from "../sections/Testimonials.astro";
import BlogTeaser from "../sections/home/BlogTeaser.astro";
import Hero from "../sections/home/Hero.astro";
import Press from "../sections/home/Press.astro";
import ProgramsOverview from "../sections/home/ProgramsOverview.astro";
// The hero has no photo: og:image is the camp card's 2025 group photo.
import ogPhoto from "../assets/camp-archive/2025/cover-tphcm.jpg";
---

<BaseLayout
  title="PiMA Academy - Học viện Toán học và Ứng dụng"
  description="PiMA là tổ chức giáo dục toán học và ứng dụng, được các nhà toán học Việt Nam thành lập năm 2016: trại hè cho học sinh THPT, các khóa học trực tuyến và bài viết về toán ứng dụng."
  hero={ogPhoto}
>
  <Hero />
  <Impact />
  <ProgramsOverview />
  <Testimonials />
  <Partners />
  <Press />
  <BlogTeaser />
  <ContactSection />
</BaseLayout>
