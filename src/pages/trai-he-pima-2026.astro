---
// trai-he-pima-2026 (old site/trai-he-pima-2026.html), camp chrome, orphan page.
// The 2025 information on this page (dates, apply buttons, "PiMA 2025" form) is migrated
// as-is: content work for PiMA (spec #15, "Content work, migrated as-is").
// Fade-ups follow the 2025 page's IX2 map (spec: 2026 gets the 2025 animations).
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CampHeaderPhotos from "../components/CampHeaderPhotos.astro";
import CampMentors from "../components/CampMentors.astro";
import CampTeamPhoto from "../components/CampTeamPhoto.astro";
