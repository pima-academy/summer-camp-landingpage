import VideoLightbox from "../components/VideoLightbox.astro";
import { campHeaderPhotos2026 } from "../components/camp-header-photos";
import { advisors, organizers } from "../components/camp-mentors";
import { mentorLogos2026 } from "../components/mentor-logos";
import { contact, social } from "../data/site";
import { campPageIds, wNodeId } from "../lib/w-node";

import logoHorizontal from "../assets/images/logo-horizontal.png";
import img6734 from "../assets/images/img-6734.jpg";
import poster from "../assets/images/poster-optimized-4000.png";
import bookOpen from "../assets/images/book-open.png";
import ovalLoveTwo from "../assets/images/oval-love-two.png";
import gift from "../assets/images/gift.png";
import mapDraw from "../assets/images/map-draw.png";
import facebookIcon from "../assets/images/facebook.png";
import mailIcon from "../assets/images/mail-1.png";
import phoneIcon from "../assets/images/phone-telephone.png";

const PAGE_ID = campPageIds[2026];

const apply = "https://qual.pimavn.com/apply";
