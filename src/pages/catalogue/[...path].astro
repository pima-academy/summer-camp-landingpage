---
/*
  Dev-only catalogue page, served at /catalogue/ by `npm run dev`: every primitive of
  src/components/ (files whose header comment starts with "Primitive:") in every variant,
  inside the site chrome. Use it to see what exists before building a section, and to
  check a primitive change by eye.

  Like the gap-page route, getStaticPaths returns no path outside dev, so the page is
  never built or listed in the sitemap. scripts/catalogue.test.mjs fails when a
  primitive, one of its variant values or one of its boolean props is missing here.

  Adding a primitive: give it a "Primitive: …" header comment and add a block below
  showing each variant, with its prop value written as a literal (variant="lime").
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandName from "../../components/BrandName.astro";
import Button from "../../components/Button.astro";
import Kicker from "../../components/Kicker.astro";
import Section from "../../components/Section.astro";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { path: undefined } }] : [];
}

const widths = ["small", "medium", "large"] as const;
const spacings = ["none", "small", "medium", "large"] as const;
const tones = ["white", "surface", "pale-lime", "dark-green"] as const;
---

<BaseLayout title="Catalogue" description="Every primitive in every variant (dev only)." noindex>
  <Section name="catalogue-intro" spacing="small">
    <h1>Catalogue</h1>
    <p>
      Every primitive in <code>src/components/</code> in every variant (dev only). Section frames below: the band is
      gray, the content column pale lime.
    </p>
  </Section>

  <Section name="catalogue-section-widths" spacing="small" class="title">
    <h2>Section: width</h2>
    <p>Each with <code>spacing="medium"</code> (the default).</p>
  </Section>
  {
    widths.map((width) => (
      <Section name={`catalogue-width-${width}`} width={width} class="demo">
        <div class="content">width="{width}"</div>
      </Section>
    ))
  }

  <Section name="catalogue-section-spacings" spacing="small" class="title">
    <h2>Section: spacing</h2>
    <p>Each with <code>width="medium"</code> (the default).</p>
  </Section>
  {
    spacings.map((spacing) => (
      <Section name={`catalogue-spacing-${spacing}`} spacing={spacing} class="demo">
        <div class="content">spacing="{spacing}"</div>
      </Section>
    ))
  }
  <Section name="catalogue-animate" animate class="demo">
    <div class="content">animate (fades up on first scroll into view)</div>
  </Section>

  <Section name="catalogue-section-tones" spacing="small" class="title">
    <h2>Section: tone</h2>
    <p>
      Background and the text colours on it. Each shows an h2, an h3, body text, muted text, accent text, a link, a
      kicker and the buttons meant for that tone.
    </p>
  </Section>
  {
    tones.map((tone) => (
      <Section name={`catalogue-tone-${tone}`} tone={tone} spacing="small">
        <Kicker>kicker on {tone}</Kicker>
        <h2>tone="{tone}"</h2>
        <h3>An h3 heading</h3>
        <p>
          Body text. <span class="muted">Muted text.</span> <span class="accent">Accent text: dates, names.</span>{" "}
          <a href="#">A link</a>.
        </p>
        <div class="row">
          {tone === "dark-green" ? (
            <Button href="#">on-dark</Button>
          ) : (
            <>
              <Button href="#" variant="primary">primary</Button>
              <Button href="#" variant="secondary">secondary</Button>
            </>
          )}
          <Button href="#" variant="link">link</Button>
        </div>
      </Section>
    ))
  }

  <Section name="catalogue-buttons" spacing="small">
    <h2>Button</h2>
    <div class="row">
      <Button href="#" variant="primary">variant="primary"</Button>
      <Button href="#" variant="secondary">variant="secondary"</Button>
      <Button href="#" variant="link">variant="link"</Button>
    </div>
  </Section>
  <Section name="catalogue-buttons-on-dark" spacing="small" tone="dark-green">
    <div class="row">
      <Button href="#" variant="on-dark">variant="on-dark"</Button>
      <Button href="#" variant="link">variant="link" on dark green</Button>
    </div>
  </Section>

  <Section name="catalogue-kicker" spacing="small">
    <h2>Kicker</h2>
    <div class="framed">
      <Kicker>đối tác của <BrandName /></Kicker>
      <h2>Kicker with the old h5 margins</h2>
    </div>
    <div class="framed">
      <Kicker flush>trại hè toán học (flush)</Kicker>
      <h2>Kicker flush: no margins</h2>
    </div>
  </Section>

  <Section name="catalogue-type" spacing="small">
    <h2>Type roles</h2>
    <p>Base CSS styles each heading level by its role (docs/brand.md, Typography); sections set no heading size.</p>
    <div class="framed">
      <h1>h1: Khám phá những biên giới mới</h1>
      <h2>h2: Những con số nổi bật</h2>
      <h3>h3: Kiến thức nền tảng &amp; ứng dụng</h3>
      <h4>h4 takes the h3 role</h4>
      <h5>h5: a bold label at body size</h5>
      <p>Body: Nunito Sans regular, Vietnamese diacritics Ồ Ộ Ẫ ặ ữ.</p>
      <p class="small">Small text: captions, form fields, tags, the footer credit.</p>
      <p class="number">0123456789</p>
    </div>
  </Section>

  <Section name="catalogue-brand-name" spacing="small">
    <h2>BrandName</h2>
    <p class="upper">uppercased text: về <BrandName /> academy</p>
    <p>plain text: <BrandName /> Academy</p>
  </Section>
</BaseLayout>

<style>
  .title {
    padding-top: 2rem;
  }

  .demo {
    background-color: var(--color-background-surface);
  }

  .demo + .demo {
    margin-top: 2px;
  }

  .content {
    padding: 1rem;
    background-color: var(--color-background-pale-lime);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .accent {
    color: var(--color-text-accent);
  }

  .framed {
    margin-top: 1rem;
    outline: 1px dashed var(--color-text-muted);
  }

  .small {
    font-size: var(--font-size-small);
  }

  .number {
    color: var(--color-text-accent);
    font-size: var(--font-size-big-number);
    font-weight: var(--font-weight-black);
    font-variant-numeric: tabular-nums;
  }

  .upper {
    text-transform: uppercase;
  }
</style>
