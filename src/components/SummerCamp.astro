---
/*
  SummerCamp: "Trại hè toán học" section (old `section_summer-camp`), shared by
  index and trai-he-toan-hoc-pima. No props. Photo slider: 6 s autoplay, not
  infinite. Each photo's lightbox was empty on the old site, so the link is an
  inline content gap; production shows the photo without the click.
*/
import { Image } from "astro:assets";
import { isCurrent } from "../lib/current-link";
import ContentGap from "./ContentGap.astro";
import Slider from "./Slider.astro";
import { summerCampPhotos } from "./summer-camp-photos";

const campHref = "/trai-he-toan-hoc-pima/";
const campCurrent = isCurrent(campHref, Astro.url.pathname);
// Fluid widths capped at the source width, which is included when under 2000 px.
const widths = (w: number) => [...[500, 800, 1080, 1600, 2000].filter((x) => x < w), ...(w <= 2000 ? [w] : [])];
const sizes = "(max-width: 479px) 39vw, (max-width: 991px) 26vw, 309px";
---

<div class="section_summer-camp" data-animate="fade-up">
  <div class="padding-global">
    <div class="container-medium">
      <div class="padding-section-medium">
        <div class="summer-camp-components">
          <div class="text-align-center">
            <div class="max-width-large align-center">
              <h5 class="text-style-green text-style-allcaps is-no-margin">trại hè toán học</h5>
              <div class="spacer-small"></div>
              <div class="margin-bottom margin-small">
                <h2 class="heading-3">Nơi Toán học gặp thực tiễn</h2>
              </div>
              <div class="spacer-small"></div>
              <p class="text-size-medium text-align-center">
                Một chương trình học thuật hoàn toàn miễn phí dành cho học sinh THPT trên toàn quốc, nơi bạn được học
                Toán theo cách mới: thực tiễn, sáng tạo và truyền cảm hứng. Trong 8 ngày, bạn sẽ cùng các mentor từ các
                đại học hàng đầu thế giới khám phá kiến thức Toán cao cấp, làm dự án nghiên cứu thực tế và kết nối với
                những người bạn cùng đam mê trên khắp cả nước.
              </p>
            </div>
          </div>
          <div class="spacer-medium"></div>
          <div class="gallery22_component">
            <Slider
              class="gallery22_slider"
              maskClass="gallery22_mask"
              navClass="gallery22_slide-nav"
              arrows="bottom"
              autoplay={6000}
              label="Ảnh trại hè toán học"
            >
              {
                summerCampPhotos.map(({ image, alt }) => (
                  <div class="gallery22_slide w-slide">
                    <ContentGap name="SummerCamp: photo lightbox" inline>
                      <a href="#" class="gallery22_lightbox-link w-inline-block w-lightbox">
                        <div class="gallery22_image-wrapper">
                          <Image src={image} alt={alt} widths={widths(image.width)} sizes={sizes} class="gallery22_image" />
                        </div>
                      </a>
                      {/* Same box as the link (inline-block, full width), so the slide keeps its height. */}
                      <div slot="fallback" class="gallery22_lightbox-link w-inline-block">
                        <div class="gallery22_image-wrapper">
                          <Image src={image} alt={alt} widths={widths(image.width)} sizes={sizes} class="gallery22_image" />
                        </div>
                      </div>
                    </ContentGap>
                  </div>
                ))
              }
            </Slider>
          </div>
          <div class="spacer-medium"></div>
          <div class="button-group is-center">
            <a
              href={campHref}
              class:list={["button is-lime is-black w-button", { "w--current": campCurrent }]}
              aria-current={campCurrent ? "page" : undefined}>Tìm hiểu thêm về trại hè</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
