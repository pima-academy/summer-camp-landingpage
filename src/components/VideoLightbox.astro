---
/*
  VideoLightbox: the clickable thumbnail of `section_layout11` (2025/2026 camp
  pages) and the native <dialog> it opens with the YouTube video.

  Place it where the old `a.layout11_lightbox` was (a cell of
  `.layout11_content`), passing that link's `w-node-*` id so the grid rule
  still applies:

    <VideoLightbox videoId="8DKLYsikxTs" image={poster}
      id="w-node-_64e8d45c-0150-2a2d-6940-55dbfd058f0c-485dbad8" />

  Nothing is loaded from YouTube until the visitor clicks: the
  youtube-nocookie.com iframe is created when the dialog opens and removed when
  it closes (which also stops the video). Without JS the thumbnail is a plain
  link to the video on youtube.com.
*/
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** YouTube video id, e.g. "8DKLYsikxTs". */
  videoId: string;
  /** Thumbnail image. */
  image: ImageMetadata;
  /** Thumbnail alt text. The old pages had none. */
  alt?: string;
  /** Accessible name of the thumbnail link (the link holds only the image). */
  label?: string;
  /** The old link's `w-node-*` id (grid placement rule in the stylesheet). */
  id?: string;
  /** `sizes` of the thumbnail; default measured on the old 2025/2026 pages. */
  sizes?: string;
}

const {
  videoId,
  image,
  alt = "",
  label = "Xem video",
  id,
  sizes = "(max-width: 767px) 90vw, (max-width: 1440px) 42vw, 600px",
} = Astro.props;

const widths = [
  ...[500, 800, 1080, 1600, 2000].filter((w) => w < image.width),
  ...(image.width <= 2000 ? [image.width] : []),
];
---

<a
  href={`https://www.youtube.com/watch?v=${videoId}`}
  id={id}
  class="layout11_lightbox w-inline-block w-lightbox"
  aria-label={label}
  aria-haspopup="dialog"
  data-video-lightbox-open
  data-video-id={videoId}
>
  <Image src={image} alt={alt} widths={widths} sizes={sizes} class="layout11_lightbox-image" />
</a>
<dialog class="video-lightbox" aria-label="Video" data-video-lightbox>
  <button type="button" class="video-lightbox_close" aria-label="Đóng video"></button>
  <div class="video-lightbox_frame"></div>
</dialog>

<style>
  /* Mirrors the Webflow lightbox overlay of the old site (webflow.css
     .w-lightbox-*): 90% black backdrop fading in over 300 ms, the video at
     940 px max centred in the viewport (96vw x 96vh from 768 px up), close x
     68 x 44 px in the top-right corner. */
  .video-lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.9);
    color: #fff;
    opacity: 0;
    transition:
      opacity 0.3s,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }
  .video-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
  }
  @starting-style {
    .video-lightbox[open] {
      opacity: 0;
    }
  }
  .video-lightbox::backdrop {
    background: none;
  }
  :global(html:has(.video-lightbox[open])) {
    overflow: hidden;
  }

  .video-lightbox_frame {
    width: min(940px, 100vw);
    aspect-ratio: 16 / 9;
  }
  .video-lightbox_frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-lightbox_close {
    position: absolute;
    top: 0;
    right: 0;
    width: 68px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent
      url("data:image/svg+xml;base64,")
      center / 18px no-repeat;
    cursor: pointer;
    transition: opacity 0.3s;
  }
  .video-lightbox_close:hover {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .video-lightbox_frame {
      width: min(940px, 96vw, 96vh * 16 / 9);
    }
    .video-lightbox_close {
      top: 2vh;
      opacity: 0.8;
    }
    .video-lightbox_close:hover {
      opacity: 1;
    }
  }
</style>

<script>
  // One handler set per VideoLightbox on the page. The iframe exists only
  // while the dialog is open, so YouTube is contacted only after a click and
  // closing stops the video.
  for (const thumb of document.querySelectorAll<HTMLAnchorElement>("[data-video-lightbox-open]")) {
    const dialog = thumb.nextElementSibling;
    if (!(dialog instanceof HTMLDialogElement)) continue;
    const frame = dialog.querySelector(".video-lightbox_frame")!;
    const videoId = thumb.dataset.videoId!;

    thumb.addEventListener("click", (event) => {
      // Ctrl/Cmd/Shift-click keeps the link behaviour (video on youtube.com).
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}`;
      iframe.title = "YouTube embed";
      iframe.allow = "autoplay; fullscreen; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      dialog.showModal();
    });

    dialog.querySelector(".video-lightbox_close")!.addEventListener("click", () => dialog.close());
    // The dialog fills the viewport; a click that lands on the dialog itself
    // (not on the video or the x) is a click on the dark backdrop.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    // Esc, x and backdrop all end here.
    dialog.addEventListener("close", () => {
      frame.replaceChildren();
      thumb.focus();
    });
  }
</script>
