---
// Widget: Accordion, the ve-chung-toi "Xuất phát điểm / Tầm nhìn / Sứ mệnh" panels
// (replaces the old `.layout351_*` markup and Webflow interactions a-27/a-28).
//
//   <Accordion>
//     <AccordionPanel number="01" title="Xuất phát điểm" open>…</AccordionPanel>
//     <AccordionPanel number="02" title="Tầm nhìn">…</AccordionPanel>
//     <AccordionPanel number="03" title="Sứ mệnh">…</AccordionPanel>
//   </Accordion>
//
// One panel is always open: its button has `aria-expanded="true"` (AccordionPanel styles
// the panel from it). Clicking a closed panel's button opens it and closes the others;
// clicking the open one does nothing. Closed bodies are `inert`.
// - ≥ 992 px: the open panel is 100% wide, the others 5rem (CSS width transition).
// - ≤ 991 px: the open panel's body has auto height, the others 0 (the
//   script animates between pixel heights, then hands back to CSS).
// - 500 ms ease both ways; no transition with prefers-reduced-motion.
// - Without JS (`html` lacks `js-ready`) every panel's text is shown: stacked
//   open panels on desktop, all bodies expanded below 992 px.
---

<div class="accordion" data-accordion>
  <slot />
</div>

<style>
  .accordion {
    display: flex;
    width: 100%;
    height: 90vh;
    overflow: hidden;
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-panel);
  }

  /* breakpoint-exception: desktop only (the complement of 991 px), where panels open sideways. */
  @media screen and (min-width: 992px) {
    /* Without JS (no `js-ready` on <html>) every panel shows, stacked. */
    :global(html:not(.js-ready)) .accordion {
      flex-direction: column;
      height: auto;
    }
  }

  @media screen and (max-width: 991px) {
    .accordion {
      flex-direction: column;
      height: auto;
      border-color: var(--color-border);
    }
  }
</style>

<script>
  const DURATION = 500;

  for (const root of document.querySelectorAll<HTMLElement>("[data-accordion]")) {
    const panels = [...root.querySelectorAll<HTMLElement>(":scope > [data-accordion-panel]")];
    const parts = panels.map((panel) => {
      const button = panel.querySelector<HTMLButtonElement>(":scope > button[aria-controls]")!;
      return { button, content: document.getElementById(button.getAttribute("aria-controls")!)! };
    });
    const timers = new Map<HTMLElement, number>();
    const isOpen = (p: (typeof parts)[number]) => p.button.getAttribute("aria-expanded") === "true";

    const setOpen = (open: (typeof parts)[number]) => {
      // Start heights, read before any state change (only matter below 992 px,
      // where height is what animates; above, the CSS width transition runs).
      const start = parts.map(({ content }) => content.getBoundingClientRect().height);

      for (const p of parts) {
        p.button.setAttribute("aria-expanded", String(p === open));
        p.content.inert = p !== open;
      }

      const animate =
        matchMedia("(max-width: 991px)").matches &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!animate) return;

      parts.forEach(({ content }, i) => {
        clearTimeout(timers.get(content));
        content.style.transition = "none";
        content.style.height = `${start[i]}px`;
      });
      void root.offsetHeight;
      for (const p of parts) {
        const { content } = p;
        content.style.transition = "";
        content.style.height = p === open ? `${content.scrollHeight}px` : "0px";
        // Hand back to CSS (auto / 0) once the transition is over.
        timers.set(
          content,
          window.setTimeout(() => {
            content.style.height = "";
          }, DURATION + 50),
        );
      }
    };

    for (const p of parts) {
      p.content.inert = !isOpen(p);
      p.button.addEventListener("click", () => {
        if (!isOpen(p)) setOpen(p);
      });
    }
  }
</script>
