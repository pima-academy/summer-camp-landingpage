---
/*
  ContentGap: marks a content gap (a section, link, image or page that is empty
  or broken only because its content does not exist yet).

  - Production build (`import.meta.env.PROD`): renders the `fallback` slot if
    given, else nothing. Visitors never see the original.
  - `npm run dev`: renders the original (default slot) inside a dashed frame
    labelled "CONTENT GAP: <name>". The frame is an outline and the label an
    overlay, so the page layout does not move.

  `grep -r "<ContentGap" src` lists every gap. When the content arrives, whoever
  adds it removes this wrapper in the same commit. Nothing detects filled data
  automatically.

  Usage:
    <ContentGap name="index: Đội ngũ list">…section…</ContentGap>
    <ContentGap name="khoa-hoc: Xem chi tiết link" inline>
      <a href="#">Xem chi tiết</a>
      <Fragment slot="fallback">Xem chi tiết</Fragment>
    </ContentGap>
*/
interface Props {
  /** "<page>: <what>", shown in the dev label. */
  name: string;
  /** Wrap in a <span> (inside text, links, nav items) instead of a <div>. */
  inline?: boolean;
  /** Page-level marker (used by the gap-page route): the label sticks to the viewport. */
  page?: boolean;
}

const { name, inline = false, page = false } = Astro.props;
const Tag = inline ? "span" : "div";
---

{
  import.meta.env.DEV ? (
    <Tag class:list={["content-gap", { "content-gap--page": page }]} data-content-gap={name}>
      {/* Dev only: an is:inline style is rendered here and never reaches the build CSS. */}
      <style is:inline>
        .content-gap {
          position: relative;
          outline: 3px dashed #e5007e;
          outline-offset: -3px;
        }
        .content-gap::before {
          content: "CONTENT GAP: " attr(data-content-gap);
          position: absolute;
          top: 0;
          left: 0;
          z-index: 9999;
          padding: 2px 6px;
          background: #e5007e;
          color: #fff;
          font: 700 11px/1.3 monospace;
          white-space: nowrap;
          pointer-events: none;
        }
        span.content-gap::before {
          top: auto;
          bottom: 100%;
          padding: 0 4px;
          font-size: 10px;
        }
        .content-gap--page::before {
          position: fixed;
          top: auto;
          bottom: 8px;
          left: 8px;
          padding: 6px 10px;
          font-size: 14px;
        }
      </style>
      <slot />
    </Tag>
  ) : (
    <slot name="fallback" />
  )
}
