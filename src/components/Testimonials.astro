---
// "Cảm nhận từ trại sinh và học viên" section (old `section_testimonials`, identical on
// index, trai-he-toan-hoc-pima and chi-tiet-trai-he). Fades up on scroll.
import { Image } from "astro:assets";
import { testimonials } from "./testimonials";
---

<div data-animate="fade-up" class="section_testimonials">
  <div class="padding-global">
    <div class="container-medium">
      <div class="padding-section-small">
        <h2 class="text-align-center">Cảm nhận từ trại sinh và học viên</h2>
        <div class="spacer-medium"></div>
        <div class="testimonial18_component">
          <div class="testimonial18_list">
            {
              testimonials.map((t) => (
                <div class="testimonial18_card">
                  <div class="margin-bottom margin-small" />
                  <div class="text-size-medium">
                    <em>"{t.quote}"</em>
                  </div>
                  <div class="margin-top margin-small">
                    <div class="testimonial18_client">
                      <div class="testimonial18_client-image-wrapper">
                        <Image
                          src={t.avatar}
                          alt={`Ảnh đại diện của ${t.name}`}
                          width={48}
                          densities={[1, 2]}
                          class="testimonial18_customer-image"
                        />
                      </div>
                      <div class="testimonial18_client-info">
                        <div class="text-weight-semibold">
                          {t.nameClass ? <strong class={t.nameClass}>{t.name}</strong> : t.name}
                        </div>
                        <div class={t.roleClass}>
                          {t.role.map((line, i) => (
                            <Fragment>
                              {i > 0 && <br />}
                              {line}
                            </Fragment>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
