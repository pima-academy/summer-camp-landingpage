---
// "Tác động" section (old `section_impact`, identical on index, ve-chung-toi and
// trai-he-toan-hoc-pima): impact report link + highlight numbers. Fades up on scroll.
// The `w-node-*` ids are kept: the stylesheet places the grid cells by id.
import { Image } from "astro:assets";
import report from "../assets/images/pima-impact-report.png";
import { fluidWidths } from "../lib/image-widths";

interface Props {
  /** Section id. The old markup used "tac-dong"; ve-chung-toi may pass its footer anchor instead. */
  id?: string;
}

const { id = "tac-dong" } = Astro.props;
---

<div id={id} data-animate="fade-up" class="section_impact">
  <div class="padding-global">
    <div class="container-medium">
      <div class="padding-section-medium">
        <div class="impact_content-wrapper">
          <div id="w-node-_2295c943-ebf5-0ead-92f0-947c3edad9a6-3edad9a1" class="impact_content-left">
            <h5 class="text-style-allcaps text-style-green">tác động</h5>
            <h2 class="heading-2">Những con số<br />nổi bật</h2>
            <div class="spacer-small"></div>
            <div class="impact-report_image-wrapper">
              <a href="https://issuu.com/pimavn/docs/pima_impact_report_2016-2024_vietnamese_version_" class="w-inline-block">
                <Image
                  src={report}
                  alt="Báo cáo tác động PiMA 2016–2024"
                  widths={fluidWidths(report)}
                  sizes="(max-width: 479px) 100vw, (max-width: 991px) 30vw, 331px"
                />
              </a>
            </div>
          </div>
          <div id="w-node-_2295c943-ebf5-0ead-92f0-947c3edad9ae-3edad9a1" class="impact_content-right">
            <div class="impact_highlight-numbers">
              <h4 class="text-style-h4">1000+</h4>
              <div>Người tham gia</div>
            </div>
            <div class="impact_highlight-numbers">
              <h4 class="text-style-h4">9</h4>
              <div>Trại hè Toán học và Ứng dụng</div>
            </div>
            <div class="impact_highlight-numbers">
              <h4 class="text-style-h4">50+</h4>
              <div>Dự án học thuật của học sinh được hoàn thành</div>
            </div>
            <div class="impact_highlight-numbers">
              <h4 class="text-style-h4">80+</h4>
              <div>Bài giảng về Toán cao cấp và Ứng dụng</div>
            </div>
            <div class="impact_highlight-numbers">
              <h4 class="text-style-h4">6</h4>
              <div>Workshop tại các trường THPT trọng điểm tại TP.HCM</div>
            </div>
            <div class="impact_highlight-numbers">
              <h4 class="text-style-h4">200+</h4>
              <div>Trại sinh THPT tài năng được tuyển chọn</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* The old <img> had no size attributes; <Image> sets the source's width/height. When the
     CSS shrinks the width, let the height follow (aspect ratio) as before. */
  .impact-report_image-wrapper :global(img) {
    height: auto;
  }
</style>
