---
/*
  Widget: Marquee, a seamless infinite loop of its slot. Used by TrustBar (home,
  ve-chung-toi, khoa-hoc, trai-he-toan-hoc-pima, lien-he).

    <Marquee class="claims" duration={20} copies={3}>…items…</Marquee>

  The slot is ONE period of content; the component renders it `copies` times (the
  extra copies aria-hidden + inert) inside a track that the animation `marquee-x` /
  `marquee-y` (animations.css) moves by one copy per `duration`.

  The track is the element that carries `class` and any other attribute, so the
  caller's scoped CSS styles it: the gap between items (each copy inherits the
  track's gap and align-items) and anything responsive. A zero-size end marker
  closes the track so that track length = copies × (copy + gap): -100%/copies is
  exactly one period, whatever the gap at the current breakpoint.
  Use enough copies that (copies - 1) periods cover the visible window at every width.
  No motion with `prefers-reduced-motion: reduce` (first frame stays).
*/
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** "x": right-to-left row. "y": bottom-to-top column. */
  direction?: "x" | "y";
  /** Seconds per period (one copy of the slot). */
  duration: number;
  /** How many times the slot is rendered (>= 2). */
  copies?: number;
}

const { direction = "x", duration, copies = 2, class: className, ...attrs } = Astro.props;
const count = Math.max(2, copies);
const html = await Astro.slots.render("default");
const extra = Array.from({ length: count - 1 });
---

<div
  class:list={["track", className]}
  data-marquee={direction}
  style={`--marquee-duration: ${duration}s; --marquee-copies: ${count}`}
  {...attrs}
>
  <div class="copy" set:html={html} />
  {extra.map(() => <div class="copy" aria-hidden="true" inert set:html={html} />)}
  <span class="end" aria-hidden="true"></span>
</div>

<style>
  .track {
    display: flex;
  }

  [data-marquee="x"] {
    flex-direction: row;
    width: max-content;
  }

  [data-marquee="y"] {
    flex-direction: column;
  }

  .copy {
    display: flex;
    flex: none;
    gap: inherit;
    align-items: inherit;
  }

  [data-marquee="y"] > .copy {
    flex-direction: column;
  }

  .end {
    flex: none;
    width: 0;
    height: 0;
  }
</style>
