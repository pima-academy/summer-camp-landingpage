---
// "Mentor trại hè PiMA đến từ các trường đại học hàng đầu" logo row of the 2025/2026 camp
// pages (old `section_logo3`), inside the old fade-up wrapper <section>.
//   import { mentorLogos2025 } from "../components/mentor-logos";
//   <MentorLogos lists={mentorLogos2025} page={campPageIds[2025]} />
// Marquee: one period = both `.logo3_list`s once; 60 s per period keeps the old IX2 pace
// (it moved -112rem, about one list, per 30 s).
import { Image } from "astro:assets";
import { wNodeId } from "../lib/w-node";
import Marquee from "./Marquee.astro";
import type { MentorLogo } from "./mentor-logos";

interface Props {
  lists: MentorLogo[][];
  /** Webflow page id the old `w-node-*` ids end with. */
  page: string;
}

const { lists, page } = Astro.props;
---

<section data-animate="fade-up">
  <section class="section_logo3">
    <div class="padding-global">
      <div class="container-large">
        <div class="margin-bottom margin-large">
          <div class="text-align-center">
            <div class="max-width-large align-center">
              <h2 class="heading-style-h3">Mentor trại hè PiMA đến từ các trường đại học hàng đầu</h2>
              <div class="spacer-medium"></div>
            </div>
          </div>
          <Marquee class="logo3_component" duration={60}>
            {
              lists.map((list) => (
                <div class="logo3_list">
                  {list.map((logo) => (
                    <div id={wNodeId(logo.node, page)} class="logo3_wrapper">
                      {logo.width ? (
                        <Image
                          src={logo.image}
                          alt={logo.alt}
                          width={logo.width}
                          densities={[1, 2]}
                          class="logo3_logo is-fixed-width"
                        />
                      ) : (
                        <Image src={logo.image} alt={logo.alt} height={72} densities={[1, 2]} class="logo3_logo" />
                      )}
                    </div>
                  ))}
                </div>
              ))
            }
          </Marquee>
        </div>
      </div>
    </div>
  </section>
</section>

<style>
  /* The old logos had no width/height attributes (Stony Brook: width 84 only), and every
     source is taller than `.logo3_logo`'s max-height (4.5rem, 3rem below 768 px): each box
     was max-height tall and followed the logo's aspect ratio. <Image> writes both
     attributes, so set that height here and let the width follow; the box is then sized
     before the lazy image loads. */
  .logo3_wrapper :global(img.logo3_logo) {
    height: 4.5rem;
  }
  .logo3_wrapper :global(img.logo3_logo:not(.is-fixed-width)) {
    width: auto;
  }
  @media screen and (max-width: 767px) {
    .logo3_wrapper :global(img.logo3_logo) {
      height: 3rem;
    }
  }
</style>
