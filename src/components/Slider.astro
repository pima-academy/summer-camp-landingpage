---
/*
  Slider: the Webflow slider (`w-slider`) without webflow.js. One component for
  every slider on the site; only the classes, timing and slides differ.

  The slides go in the default slot, each an element with the `w-slide` class:

    <Slider class="gallery25_slider" maskClass="gallery25_mask" navClass="gallery25_slide-nav"
            arrows="bottom-left" autoplay={6000} infinite label="Hoạt động của đội ngũ">
      <div class="gallery25_slide w-slide">…</div>
      …
    </Slider>

  Behaviour (script below, same as webflow.js): 500 ms ease slide, arrows,
  dots (`w-slider-dot`, `w-active`), swipe, keyboard-operable arrows and dots,
  autoplay paused while hovered or focused and off under prefers-reduced-motion.
  Without JS the first slide shows; arrows and dots do nothing / are absent.
*/
interface Props {
  /** Instance class on the `w-slider` element, e.g. "gallery25_slider". */
  class: string;
  /** Instance class on the `w-slider-mask` element, e.g. "gallery25_mask". */
  maskClass: string;
  /** Instance class on the `w-slider-nav` element, e.g. "gallery25_slide-nav". */
  navClass: string;
  /**
   * Arrow placement, the old modifier classes:
   * "bottom-left" = is-bottom-left-previous/-next, "bottom" = is-bottom-previous/-next,
   * "centre" = is-centre-previous/-next + hide-mobile-landscape.
   */
  arrows: "bottom-left" | "bottom" | "centre";
  /** Base class of both arrows: "slider-arrow" (default) or "slider-arrow-2" (detail_course). */
  arrowClass?: "slider-arrow" | "slider-arrow-2";
  /** Autoplay delay in ms (old `data-delay`). Omit for no autoplay. */
  autoplay?: number;
  /** Wrap from the last slide to the first in the same direction (old `data-infinite`). */
  infinite?: boolean;
  /** Vietnamese accessible name of the slider region. */
  label: string;
}

const { class: className, maskClass, navClass, arrows, arrowClass = "slider-arrow", autoplay, infinite = false, label } =
  Astro.props;

const placement = {
  "bottom-left": ["is-bottom-left-previous", "is-bottom-left-next"],
  bottom: ["is-bottom-previous", "is-bottom-next"],
  centre: ["is-centre-previous hide-mobile-landscape", "is-centre-next hide-mobile-landscape"],
}[arrows];
---

<div
  class:list={[className, "w-slider"]}
  role="region"
  aria-label={label}
  data-slider
  data-autoplay={autoplay}
  data-infinite={infinite ? "" : undefined}
>
  <div class:list={[maskClass, "w-slider-mask"]}>
    <slot />
    <div aria-live="off" aria-atomic="true" class="w-slider-aria-label"></div>
  </div>
  <div class:list={[arrowClass, placement[0], "w-slider-arrow-left"]}>
    <div class="slider-arrow-icon_default w-embed">
      <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M3.31066 8.75001L9.03033 14.4697L7.96967 15.5303L0.439339 8.00001L7.96967 0.469676L9.03033 1.53034L3.31066 7.25001L15.5 7.25L15.5 8.75L3.31066 8.75001Z"
          fill="currentColor"></path>
      </svg>
    </div>
  </div>
  <div class:list={[arrowClass, placement[1], "w-slider-arrow-right"]}>
    <div class="slider-arrow-icon_default w-embed">
      <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12.6893 7.25L6.96967 1.53033L8.03033 0.469666L15.5607 8L8.03033 15.5303L6.96967 14.4697L12.6893 8.75H0.5V7.25H12.6893Z"
          fill="currentColor"></path>
      </svg>
    </div>
  </div>
  <div class:list={[navClass, "w-slider-nav w-slider-nav-invert w-round"]}></div>
</div>

<script>
  import { initialState, step, type SlideMove, type SliderState } from "../lib/slider-step";

  const TRANSITION = "transform 500ms ease";
  const SWIPE_MIN_PX = 30;
  const FOCUSABLE = 'a[href], area[href], [role="button"], input, select, textarea, button, iframe, object, embed, [tabindex]';
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function setup(root: HTMLElement, n: number) {
    const mask = root.querySelector<HTMLElement>(":scope > .w-slider-mask")!;
    const left = root.querySelector<HTMLElement>(":scope > .w-slider-arrow-left")!;
    const right = root.querySelector<HTMLElement>(":scope > .w-slider-arrow-right")!;
    const nav = root.querySelector<HTMLElement>(":scope > .w-slider-nav")!;
    const live = mask.querySelector<HTMLElement>(":scope > .w-slider-aria-label")!;
    const slides = [...mask.querySelectorAll<HTMLElement>(":scope > .w-slide")];
    const count = slides.length;
    const infinite = root.hasAttribute("data-infinite");
    const delay = Number(root.dataset.autoplay) || 0;
    let state: SliderState = initialState;

    // Slides are inline-blocks in a nowrap mask: whitespace between them would
    // add a gap and break the 100%-per-slide offsets (webflow.js removed it too).
    for (const node of [...mask.childNodes]) if (node.nodeType === Node.TEXT_NODE) node.remove();
    mask.id ||= `w-slider-mask-${n}`;
    mask.style.touchAction = "pan-y";

    slides.forEach((slide, k) => {
      slide.setAttribute("role", "group");
      slide.setAttribute("aria-label", `${k + 1} / ${count}`);
    });

    for (const [arrow, name, delta] of [
      [left, "Mục trước", -1],
      [right, "Mục tiếp theo", 1],
    ] as const) {
      arrow.setAttribute("role", "button");
      arrow.setAttribute("tabindex", "0");
      arrow.setAttribute("aria-controls", mask.id);
      arrow.setAttribute("aria-label", name);
      arrow.addEventListener("click", () => go(state.index + delta));
      arrow.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          go(state.index + delta);
        }
      });
    }

    const dots = slides.map((_, k) => {
      const dot = document.createElement("div");
      dot.className = "w-slider-dot";
      dot.setAttribute("role", "button");
      dot.setAttribute("aria-label", `Hiện mục ${k + 1} / ${count}`);
      dot.style.marginLeft = dot.style.marginRight = "3px"; // old data-nav-spacing="3"
      dot.addEventListener("click", () => go(k));
      dot.addEventListener("keydown", (e) => {
        const focus = (i: number) => dots[Math.max(0, Math.min(count - 1, i))].focus();
        if (e.key === "Enter" || e.key === " ") go(k);
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") focus(k - 1);
        else if (e.key === "ArrowRight" || e.key === "ArrowDown") focus(k + 1);
        else if (e.key === "Home") focus(0);
        else if (e.key === "End") focus(count - 1);
        else return;
        e.preventDefault();
      });
      return dot;
    });
    nav.replaceChildren(...dots);

    function mark() {
      slides.forEach((slide, k) => {
        const hidden = k !== state.index;
        if (hidden) slide.setAttribute("aria-hidden", "true");
        else slide.removeAttribute("aria-hidden");
        for (const el of slide.querySelectorAll(FOCUSABLE)) {
          if (hidden) el.setAttribute("tabindex", "-1");
          else el.removeAttribute("tabindex");
        }
      });
      dots.forEach((dot, k) => {
        const active = k === state.index;
        dot.classList.toggle("w-active", active);
        dot.setAttribute("aria-pressed", String(active));
        dot.setAttribute("tabindex", active ? "0" : "-1");
      });
    }

    function move(moves: SlideMove[]) {
      const jumps = moves.some((m) => m.from !== undefined);
      moves.forEach((m, k) => {
        if (m.from === undefined) return;
        slides[k].style.transition = "none";
        slides[k].style.transform = `translateX(${m.from * 100}%)`;
      });
      if (jumps) void mask.offsetWidth; // commit the jumps before animating
      moves.forEach((m, k) => {
        slides[k].style.transition = TRANSITION;
        slides[k].style.transform = `translateX(${m.to * 100}%)`;
      });
    }

    function go(target: number) {
      const result = step(state, target, count, infinite);
      if (result.moves.length === 0) return;
      state = result.state;
      move(result.moves);
      mark();
      live.textContent = `Mục ${state.index + 1} / ${count}.`;
    }

    mark();

    // Swipe (touch, pen or mouse drag) on the mask: left = next, right = previous.
    let start: { x: number; y: number; id: number } | null = null;
    let swiped = false;
    mask.addEventListener("pointerdown", (e) => {
      if (e.button === 0) start = { x: e.clientX, y: e.clientY, id: e.pointerId };
    });
    mask.addEventListener("pointerup", (e) => {
      if (!start || start.id !== e.pointerId) return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      if (Math.abs(dx) >= SWIPE_MIN_PX && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
        go(state.index + (dx < 0 ? 1 : -1));
      }
    });
    mask.addEventListener("pointercancel", () => (start = null));
    mask.addEventListener("dragstart", (e) => e.preventDefault());
    // A swipe that ends on a link must not follow it.
    mask.addEventListener(
      "click",
      (e) => {
        if (!swiped) return;
        swiped = false;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );
    mask.addEventListener("pointerdown", () => (swiped = false));

    if (!delay) return;

    // Autoplay: paused while hovered or focused, stopped by a press until the
    // pointer leaves, never running under prefers-reduced-motion.
    let timer: number | undefined;
    const hover = { mouse: false, keyboard: false };
    const stop = () => {
      window.clearTimeout(timer);
      timer = undefined;
    };
    const play = () => {
      stop();
      if (reducedMotion.matches || hover.mouse || hover.keyboard) return;
      timer = window.setTimeout(() => {
        go(state.index + 1);
        play();
      }, delay);
    };
    const engaged = (on: boolean) => {
      live.setAttribute("aria-live", on ? "polite" : "off");
      if (on) stop();
      else play();
    };
    root.addEventListener("mouseenter", () => {
      hover.mouse = true;
      engaged(true);
    });
    root.addEventListener("mouseleave", () => {
      hover.mouse = false;
      if (!hover.keyboard) engaged(false);
    });
    root.addEventListener("focusin", () => {
      hover.keyboard = true;
      engaged(true);
    });
    root.addEventListener("focusout", (e) => {
      if (root.contains(e.relatedTarget as Node | null)) return;
      hover.keyboard = false;
      if (!hover.mouse) engaged(false);
    });
    root.addEventListener("pointerdown", stop);
    reducedMotion.addEventListener("change", play);
    play();
  }

  document.querySelectorAll<HTMLElement>("[data-slider]").forEach(setup);
</script>
