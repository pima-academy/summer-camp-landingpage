---
/*
  Widget: Slider, a row of slides moved one at a time by arrows, dots, swipe,
  keyboard and optional autoplay. Every slider on the site uses it (home: Team,
  SummerCamp and the press slider; chi-tiet-trai-he's gallery; gap page detail-course).

  The slides go in the default slot, one element per slide, no class needed:

    <Slider layout="wide" autoplay={6000} infinite label="Các chuyên gia đồng hành">
      <div>…</div>
      …
    </Slider>

  `layout` sets the slide width, the gutter between slides and where the arrows and
  dots sit (the four looks of the old Webflow sliders):

    single  one slide fills the row, 4rem side gutters (none ≤ 767 px); arrows at
            the sides (hidden ≤ 767 px), dots centred below (old testimonial7)
    half    slides half the row (full ≤ 767 px), 1rem side gutters; arrows at the
            sides (hidden ≤ 767 px), dots centred below (old gallery16)
    third   slides a third of the row (half ≤ 767 px), 2rem right gutter; arrows
            bottom right, dots bottom left (old gallery22)
    wide    slides 80 % of the row (50 % ≤ 991, 80 % ≤ 767, 95 % ≤ 479 px), 2rem
            right gutter, 5 % side padding ≤ 991 px; arrows bottom left, dots
            bottom right (old gallery25)

  `arrowStyle` "filled" (default): white 2.5rem arrows that tint on hover. "plain":
  bare 3rem round arrows in the text colour (old slider-arrow-2).

  Behaviour (script below, same as webflow.js): 500 ms ease slide, arrows, dots,
  swipe, keyboard-operable arrows and dots, autoplay paused while hovered or
  focused and off under prefers-reduced-motion. Without JS the first slide shows;
  arrows and dots do nothing / are absent.

  State is ARIA, and the CSS reads it: each slide is a group named "k / n" and
  every slide but the shown one is aria-hidden; the current dot (a button named
  "Hiện mục k / n") has aria-current="true".
*/
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Slide width, gutters and arrow and dot placement (see above). */
  layout: "single" | "half" | "third" | "wide";
  /** Look of the two arrows. */
  arrowStyle?: "filled" | "plain";
  /** Autoplay delay in ms. Omit for no autoplay. */
  autoplay?: number;
  /** Wrap from the last slide to the first in the same direction. */
  infinite?: boolean;
  /** Vietnamese accessible name of the slider region. */
  label: string;
}

const { layout, arrowStyle = "filled", autoplay, infinite = false, label, class: className, ...attrs } = Astro.props;
---

<div
  class:list={["slider", className]}
  role="region"
  aria-label={label}
  data-slider
  data-layout={layout}
  data-autoplay={autoplay}
  data-infinite={infinite ? "" : undefined}
  {...attrs}
>
  <div class="live" aria-live="off" aria-atomic="true"></div>
  <div class="mask">
    <slot />
  </div>
  <div class="arrow prev" data-style={arrowStyle}>
    <div class="glyph">
      <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M3.31066 8.75001L9.03033 14.4697L7.96967 15.5303L0.439339 8.00001L7.96967 0.469676L9.03033 1.53034L3.31066 7.25001L15.5 7.25L15.5 8.75L3.31066 8.75001Z"
          fill="currentColor"></path>
      </svg>
    </div>
  </div>
  <div class="arrow next" data-style={arrowStyle}>
    <div class="glyph">
      <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12.6893 7.25L6.96967 1.53033L8.03033 0.469666L15.5607 8L8.03033 15.5303L6.96967 14.4697L12.6893 8.75H0.5V7.25H12.6893Z"
          fill="currentColor"></path>
      </svg>
    </div>
  </div>
  <div class="dots"></div>
</div>

<style>
  .slider {
    position: relative;
    clear: both;
    padding-bottom: 4rem;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }

  .slider[data-layout="half"],
  .slider[data-layout="wide"] {
    overflow: hidden;
  }

  .slider[data-layout="third"] {
    padding-bottom: 5rem;
  }

  /* Visually hidden live region: announces "Mục k / n." while the slider is engaged. */
  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    border: 0;
  }

  .mask {
    position: relative;
    z-index: 1;
    display: block;
    height: 100%;
    overflow: hidden;
    white-space: nowrap;
  }

  [data-layout="half"] > .mask {
    width: 50%;
    overflow: visible;
  }

  [data-layout="third"] > .mask {
    width: 33.33%;
    overflow: visible;
  }

  [data-layout="wide"] > .mask {
    width: 80%;
    overflow: visible;
  }

  /* The slides are the caller's elements (the slot), outside this file's scope. */
  .mask > :global(*) {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 100%;
    height: 100%;
    white-space: normal;
    text-align: left;
  }

  /* Slide gutters (the caller's slide elements). */
  [data-layout="single"] > .mask > :global(*) {
    padding-left: 4rem;
    padding-right: 4rem;
  }

  /* Slide gutters (the caller's slide elements). */
  [data-layout="half"] > .mask > :global(*) {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  /* Slide gutters (the caller's slide elements). */
  [data-layout="third"] > .mask > :global(*),
  [data-layout="wide"] > .mask > :global(*) {
    padding-right: 2rem;
  }

  .arrow {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: auto;
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .prev {
    z-index: 3;
    right: auto;
  }

  .next {
    z-index: 4;
    left: auto;
  }

  .arrow[data-style="filled"] {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background-color: var(--color-background);
    color: color-mix(in srgb, currentColor 70%, transparent);
    transition-property: color, background-color;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease, ease;
  }

  .arrow[data-style="filled"]:hover {
    background-color: color-mix(in srgb, currentColor 10%, transparent);
  }

  .arrow[data-style="plain"] {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-circle);
  }

  /* Arrows at the sides, centred on the slides (above the dots' 4rem). */
  [data-layout="single"] > .arrow,
  [data-layout="half"] > .arrow {
    bottom: 4rem;
  }

  [data-layout="single"] > .arrow[data-style="filled"],
  [data-layout="half"] > .arrow[data-style="filled"] {
    border-radius: var(--radius);
  }

  [data-layout="third"] > .arrow,
  [data-layout="wide"] > .arrow {
    top: auto;
    bottom: 0;
  }

  [data-layout="third"] > .prev {
    left: auto;
    right: 4rem;
  }

  [data-layout="third"] > .next {
    right: 0;
  }

  [data-layout="wide"] > .prev {
    left: 0;
  }

  [data-layout="wide"] > .next {
    left: 4rem;
    right: auto;
  }

  .glyph {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 1rem;
    height: 1rem;
  }

  .dots {
    position: absolute;
    z-index: 2;
    inset: auto 0 0 0;
    height: 1.75rem;
    margin: auto;
    padding-top: 10px;
    font-size: var(--font-size-slider-nav);
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }

  [data-layout="third"] > .dots {
    right: auto;
  }

  [data-layout="wide"] > .dots {
    left: auto;
    right: 4rem;
  }

  /* The dots are created by the script below, so they carry no scope attribute. */
  .dots > :global(*) {
    position: relative;
    display: inline-block;
    width: 1em;
    height: 1em;
    margin: 0 3px 0.5em;
    border-radius: var(--radius-circle);
    background-color: var(--color-background-slider-dot);
    cursor: pointer;
    transition:
      background-color 100ms,
      color 100ms;
  }

  /* Script-made dots (see above). */
  .dots > :global([aria-current="true"]) {
    background-color: var(--color-background-slider-dot-current);
  }

  /* Script-made dots (see above). */
  .dots > :global(:focus) {
    box-shadow: var(--shadow-slider-dot-focus);
  }

  /* Script-made dots (see above). */
  .dots > :global([aria-current="true"]:focus) {
    box-shadow: none;
  }

  @media screen and (max-width: 991px) {
    .slider[data-layout="wide"] {
      padding-left: 5%;
      padding-right: 5%;
    }

    [data-layout="wide"] > .mask {
      width: 50%;
    }

    /* The old rule was `left: auto`, i.e. the static position: the slider's 5 % padding. */
    [data-layout="wide"] > .prev {
      left: 5%;
    }

    [data-layout="wide"] > .next {
      left: calc(5% + 4rem);
    }

    [data-layout="wide"] > .dots {
      right: 2rem;
    }
  }

  @media screen and (max-width: 767px) {
    .slider[data-layout="single"],
    .slider[data-layout="half"] {
      padding-bottom: 3rem;
    }

    [data-layout="single"] > .arrow,
    [data-layout="half"] > .arrow {
      display: none;
    }

    [data-layout="half"] > .mask {
      width: 100%;
    }

    [data-layout="third"] > .mask {
      width: 50%;
    }

    [data-layout="wide"] > .mask {
      width: 80%;
    }

    /* Slide gutters (the caller's slide elements). */
    [data-layout="single"] > .mask > :global(*) {
      padding-left: 0;
      padding-right: 0;
    }

    /* Slide gutters (the caller's slide elements). */
    [data-layout="half"] > .mask > :global(*) {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    /* Slide gutters (the caller's slide elements). */
    [data-layout="third"] > .mask > :global(*),
    [data-layout="wide"] > .mask > :global(*) {
      padding-right: 1.5rem;
    }

    [data-layout="wide"] > .dots {
      right: 5%;
    }
  }

  @media screen and (max-width: 479px) {
    [data-layout="wide"] > .mask {
      width: 95%;
    }

    [data-layout="wide"] > .next {
      left: 24%;
    }
  }
</style>

<script>
  import { initialState, step, type SlideMove, type SliderState } from "../lib/slider-step";

  const TRANSITION = "transform 500ms ease";
  const SWIPE_MIN_PX = 30;
  const FOCUSABLE = 'a[href], area[href], [role="button"], input, select, textarea, button, iframe, object, embed, [tabindex]';
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function setup(root: HTMLElement, n: number) {
    const mask = root.querySelector<HTMLElement>(":scope > .mask")!;
    const left = root.querySelector<HTMLElement>(":scope > .prev")!;
    const right = root.querySelector<HTMLElement>(":scope > .next")!;
    const nav = root.querySelector<HTMLElement>(":scope > .dots")!;
    const live = root.querySelector<HTMLElement>(":scope > .live")!;
    const slides = [...mask.children] as HTMLElement[];
    const count = slides.length;
    const infinite = root.hasAttribute("data-infinite");
    const delay = Number(root.dataset.autoplay) || 0;
    let state: SliderState = initialState;

    // Slides are inline-blocks in a nowrap mask: whitespace between them would
    // add a gap and break the 100%-per-slide offsets (webflow.js removed it too).
    for (const node of [...mask.childNodes]) if (node.nodeType === Node.TEXT_NODE) node.remove();
    mask.id ||= `slider-mask-${n}`;
    mask.style.touchAction = "pan-y";

    slides.forEach((slide, k) => {
      slide.setAttribute("role", "group");
      slide.setAttribute("aria-label", `${k + 1} / ${count}`);
    });

    for (const [arrow, name, delta] of [
      [left, "Mục trước", -1],
      [right, "Mục tiếp theo", 1],
    ] as const) {
      arrow.setAttribute("role", "button");
      arrow.setAttribute("tabindex", "0");
      arrow.setAttribute("aria-controls", mask.id);
      arrow.setAttribute("aria-label", name);
      arrow.addEventListener("click", () => go(state.index + delta));
      arrow.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          go(state.index + delta);
        }
      });
    }

    const dots = slides.map((_, k) => {
      const dot = document.createElement("div");
      dot.setAttribute("role", "button");
      dot.setAttribute("aria-label", `Hiện mục ${k + 1} / ${count}`);
      dot.setAttribute("aria-controls", mask.id);
      dot.addEventListener("click", () => go(k));
      dot.addEventListener("keydown", (e) => {
        const focus = (i: number) => dots[Math.max(0, Math.min(count - 1, i))].focus();
        if (e.key === "Enter" || e.key === " ") go(k);
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") focus(k - 1);
        else if (e.key === "ArrowRight" || e.key === "ArrowDown") focus(k + 1);
        else if (e.key === "Home") focus(0);
        else if (e.key === "End") focus(count - 1);
        else return;
        e.preventDefault();
      });
      return dot;
    });
    nav.replaceChildren(...dots);

    function mark() {
      slides.forEach((slide, k) => {
        const hidden = k !== state.index;
        if (hidden) slide.setAttribute("aria-hidden", "true");
        else slide.removeAttribute("aria-hidden");
        for (const el of slide.querySelectorAll(FOCUSABLE)) {
          if (hidden) el.setAttribute("tabindex", "-1");
          else el.removeAttribute("tabindex");
        }
      });
      dots.forEach((dot, k) => {
        const current = k === state.index;
        if (current) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
        dot.setAttribute("tabindex", current ? "0" : "-1");
      });
    }

    function move(moves: SlideMove[]) {
      const jumps = moves.some((m) => m.from !== undefined);
      moves.forEach((m, k) => {
        if (m.from === undefined) return;
        slides[k].style.transition = "none";
        slides[k].style.transform = `translateX(${m.from * 100}%)`;
      });
      if (jumps) void mask.offsetWidth; // commit the jumps before animating
      moves.forEach((m, k) => {
        slides[k].style.transition = TRANSITION;
        slides[k].style.transform = `translateX(${m.to * 100}%)`;
      });
    }

    function go(target: number) {
      const result = step(state, target, count, infinite);
      if (result.moves.length === 0) return;
      state = result.state;
      move(result.moves);
      mark();
      live.textContent = `Mục ${state.index + 1} / ${count}.`;
    }

    mark();

    // Swipe (touch, pen or mouse drag) on the mask: left = next, right = previous.
    let start: { x: number; y: number; id: number } | null = null;
    let swiped = false;
    mask.addEventListener("pointerdown", (e) => {
      if (e.button === 0) start = { x: e.clientX, y: e.clientY, id: e.pointerId };
    });
    mask.addEventListener("pointerup", (e) => {
      if (!start || start.id !== e.pointerId) return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      if (Math.abs(dx) >= SWIPE_MIN_PX && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
        go(state.index + (dx < 0 ? 1 : -1));
      }
    });
    mask.addEventListener("pointercancel", () => (start = null));
    mask.addEventListener("dragstart", (e) => e.preventDefault());
    // A swipe that ends on a link must not follow it.
    mask.addEventListener(
      "click",
      (e) => {
        if (!swiped) return;
        swiped = false;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );
    mask.addEventListener("pointerdown", () => (swiped = false));

    if (!delay) return;

    // Autoplay: paused while hovered or focused, stopped by a press until the
    // pointer leaves, never running under prefers-reduced-motion.
    let timer: number | undefined;
    const hover = { mouse: false, keyboard: false };
    const stop = () => {
      window.clearTimeout(timer);
      timer = undefined;
    };
    const play = () => {
      stop();
      if (reducedMotion.matches || hover.mouse || hover.keyboard) return;
      timer = window.setTimeout(() => {
        go(state.index + 1);
        play();
      }, delay);
    };
    const engaged = (on: boolean) => {
      live.setAttribute("aria-live", on ? "polite" : "off");
      if (on) stop();
      else play();
    };
    root.addEventListener("mouseenter", () => {
      hover.mouse = true;
      engaged(true);
    });
    root.addEventListener("mouseleave", () => {
      hover.mouse = false;
      if (!hover.keyboard) engaged(false);
    });
    root.addEventListener("focusin", () => {
      hover.keyboard = true;
      engaged(true);
    });
    root.addEventListener("focusout", (e) => {
      if (root.contains(e.relatedTarget as Node | null)) return;
      hover.keyboard = false;
      if (!hover.mouse) engaged(false);
    });
    root.addEventListener("pointerdown", stop);
    reducedMotion.addEventListener("change", play);
    play();
  }

  document.querySelectorAll<HTMLElement>("[data-slider]").forEach(setup);
</script>
