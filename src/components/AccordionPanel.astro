---
// Widget: one panel of <Accordion> (ve-chung-toi "Xuất phát điểm / Tầm nhìn / Sứ mệnh").
// Only valid as a direct child of <Accordion>, whose script opens and closes it.
//   <AccordionPanel number="01" title="Xuất phát điểm" open>…content…</AccordionPanel>
// The default slot is the panel text. State: `aria-expanded` on the panel's button (the
// script keeps it in sync); the panel and its body are styled from it.
interface Props {
  /** Label shown at the top of the column ("01"). */
  number: string;
  /** Vertical column title; also the button's accessible name. */
  title: string;
  /** The panel open at start (exactly one per accordion, normally the first). */
  open?: boolean;
}

const { number, title, open = false } = Astro.props;
const id = `accordion-panel-${Math.random().toString(36).slice(2, 10)}`;
---

<div class="panel" data-accordion-panel>
  <button
    type="button"
    class="tab"
    id={`${id}-button`}
    aria-expanded={open ? "true" : "false"}
    aria-controls={id}
    aria-label={title}
  >
    <span class="number">{number}</span>
    <span class="title">{title}</span>
  </button>
  <div class="body" id={id} role="region" aria-labelledby={`${id}-button`}>
    <div class="inner">
      <slot />
    </div>
  </div>
</div>

<style>
  /* Closed: a 5rem column with the vertical title; open: the full width. */
  .panel {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    width: 5rem;
    min-width: 5rem;
    height: 90vh;
    overflow: hidden;
    border: 1px solid var(--color-border-accent);
  }

  .panel:has(> .tab[aria-expanded="true"]) {
    width: 100%;
    border-color: var(--color-border);
  }

  /* The title button, reset to look like a plain column. */
  .tab {
    appearance: none;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    width: 5rem;
    min-width: 5rem;
    height: 90vh;
    margin: 0;
    padding: var(--space-8) 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  /* overflow: hidden on the panel would clip an outside focus ring. */
  .tab:focus-visible {
    outline: 0.125rem solid var(--color-focus-ring);
    outline-offset: -0.25rem;
  }

  .number {
    white-space: nowrap;
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-h3);
    font-variant-numeric: tabular-nums;
    line-height: var(--line-height-h3);
  }

  .title {
    margin: var(--space-5) auto var(--space-3);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-h3);
    line-height: var(--line-height-h3);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .body {
    min-width: 200vw;
    height: 100%;
    overflow: auto;
  }

  .inner {
    display: flex;
    flex: none;
    flex-direction: column;
    width: 40rem;
    height: 100%;
    padding: var(--space-16) var(--space-12);
  }

  /* breakpoint-exception: desktop only (the complement of 991 px), where panels open sideways. */
  @media screen and (min-width: 992px) {
    .panel {
      transition: width 500ms ease;
    }

    /* Without JS (no `js-ready` on <html>) every panel shows, stacked at full width. */
    :global(html:not(.js-ready)) .panel {
      width: 100%;
    }
  }

  /* Below 992 px the panels stack; the open one's body has its height, the others none. */
  @media screen and (max-width: 991px) {
    .panel {
      flex-direction: column;
      width: 100%;
      min-width: auto;
      height: auto;
      border-color: var(--color-border);
    }

    .tab {
      flex-direction: row;
      justify-content: center;
      width: 100%;
      min-width: 100%;
      height: 5rem;
    }

    .number {
      position: absolute;
      left: var(--space-10);
    }

    .title {
      display: none;
    }

    .body {
      width: 100%;
      min-width: auto;
      height: auto;
      overflow: hidden;
      transition: height 500ms ease;
    }

    /* With JS, closed panel bodies collapse; without it every panel stays open. */
    :global(html.js-ready) .tab[aria-expanded="false"] + .body {
      height: 0;
    }

    .inner {
      width: auto;
      padding: var(--space-2) var(--space-10) var(--space-8);
    }
  }

  @media screen and (max-width: 767px) {
    .tab {
      height: 4rem;
    }

    .number {
      left: var(--space-6);
    }

    .inner {
      padding: var(--space-4) var(--space-6) var(--space-8);
    }
  }

  @media screen and (max-width: 479px) {
    .inner {
      padding: 0 var(--space-4) var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No width or height animation. */
    .panel,
    .body {
      transition: none;
    }
  }
</style>
