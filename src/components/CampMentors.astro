---
// A people grid of the 2025/2026 camp pages (old `section_team16`, used twice per page:
// "Ban tổ chức" and "Cố vấn chuyên môn"), inside the old fade-up wrapper <section>.
//   import { organizers, advisors } from "../components/camp-mentors";
//   <CampMentors heading="Ban tổ chức" mentors={organizers} />
// The old markup put the first card's spacer inside the image wrapper and the others'
// above the name; kept as is.
import { Image } from "astro:assets";
import type { CampMentor } from "./camp-mentors";

interface Props {
  heading: string;
  mentors: CampMentor[];
}

const { heading, mentors } = Astro.props;
---

<section data-animate="fade-up">
  <section class="section_team16">
    <div class="padding-global">
      <div class="container-medium">
        <div class="padding-section-small">
          <div class="team16_component">
            <div class="margin-bottom">
              <div class="max-width-large">
                <div class="margin-bottom margin-small">
                  <h2 class="heading-style-h3 text-align-center">{heading}</h2>
                </div>
              </div>
              <div class="spacer-medium"></div>
            </div>
            <div class="team11_list-wrapper">
              <div class="w-layout-grid team11_list">
                {
                  mentors.map((m, i) => (
                    <div class="team11_item">
                      <div class="margin-bottom margin-small">
                        <div class="team1_image-wrapper">
                          <Image
                            src={m.photo}
                            alt={`Ảnh chân dung ${m.name}`}
                            width={128}
                            densities={[1, 2]}
                            class="team11_image"
                          />
                          {i === 0 && <div class="spacer-small" />}
                        </div>
                      </div>
                      <div class="margin-bottom margin-xsmall">
                        {i > 0 && <div class="spacer-small" />}
                        <div class="team11_title-wrapper">
                          <div class="text-size-medium text-weight-bold">{m.name}</div>
                          <div class="text-size-medium text-align-center">{m.affiliation}</div>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>
