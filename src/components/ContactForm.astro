---
/*
  Widget: ContactForm, the contact form wired to the Apps Script endpoint in site.ts
  (backend contract: apps-script/Code.gs). One version, inside ContactSection's white card on
  every page that has the block.

  Name and email side by side, phone and organisation side by side (one column ≤ 479 px),
  the message a multi-line box across both. Optional fields read "(không bắt buộc)"; no
  placeholders. Fields 48 px tall, --radius corners, a visible focus ring.

  State is the wrapper's `data-state`, set by the script below and read by the CSS:
    (none)   the form
    sending  the form, its button reading "Đang gửi…"
    done     "Đã gửi lời nhắn" (role="status") instead of the form; "Gửi lời nhắn khác"
             empties the form and shows it again
    fail     the form, values kept, and the error message (role="alert") above the button
  Without JS the browser posts the form straight to the endpoint.
*/
import { contact, contactFormEndpoint } from "../data/site";
---

<div class="contact-form" data-contact-form>
  {/* action + method: without JS the browser posts straight to the Apps Script. */}
  <form class="form" action={contactFormEndpoint || undefined} method="post">
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <div class="fields">
      <div class="field">
        <label for="contact-name">Họ và tên</label>
        <input id="contact-name" name="name" type="text" maxlength="256" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" maxlength="256" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="contact-phone">Số điện thoại <span class="optional">(không bắt buộc)</span></label>
        <input id="contact-phone" name="phone" type="tel" maxlength="256" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="contact-organization">Đơn vị hoặc tổ chức <span class="optional">(không bắt buộc)</span></label>
        <input id="contact-organization" name="organization" type="text" maxlength="256" autocomplete="organization" />
      </div>
      <div class="field wide">
        <label for="contact-message">Nội dung</label>
        <textarea id="contact-message" name="message" rows="5" maxlength="5000" required></textarea>
      </div>
    </div>
    {/* Honeypot: hidden from people and screen readers; Code.gs drops any submission that fills it. */}
    <div class="honeypot" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="fail" role="alert">
      Chưa gửi được lời nhắn. Bạn vui lòng thử lại, hoặc gửi email cho PiMA tại <a href={contact.emailHref}
        >{contact.email}</a
      >.
    </div>
    <input type="submit" data-wait="Đang gửi…" class="button" value="Gửi lời nhắn" />
  </form>
  <div class="done" role="status">
    <h3>Đã gửi lời nhắn</h3>
    <p>Cảm ơn bạn đã liên hệ với PiMA.</p>
    <button type="button" class="button again">Gửi lời nhắn khác</button>
  </div>
</div>

<style>
  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wide {
    grid-column: 1 / -1;
  }

  label {
    font-weight: var(--font-weight-semibold);
  }

  .optional {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-regular);
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-field);
    border-radius: var(--radius);
    background-color: var(--color-background);
    color: var(--color-text);
    font: inherit;
    line-height: var(--line-height-field);
  }

  /* 48 px, the two columns of fields line up (#46). */
  .field input {
    height: 3rem;
  }

  .field textarea {
    min-height: 3rem;
    resize: vertical;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-border-field-focus);
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 1px;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .button {
    display: inline-block;
    margin-top: var(--space-8);
    padding: var(--space-3) var(--space-8);
    border: 0;
    border-radius: var(--radius);
    background-color: var(--color-button-primary);
    color: var(--color-button-primary-text);
    font: inherit;
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    -webkit-appearance: button;
  }

  .button:hover {
    background-color: var(--color-button-primary-hover);
    color: var(--color-button-primary-hover-text);
  }

  [data-state="sending"] .button {
    cursor: progress;
  }

  .fail,
  .done {
    display: none;
  }

  .fail {
    margin-top: var(--space-6);
    padding: var(--space-4);
    border-radius: var(--radius);
    background-color: var(--color-background-form-error);
  }

  [data-state="fail"] .fail,
  [data-state="done"] .done {
    display: block;
  }

  [data-state="done"] .form {
    display: none;
  }

  .done h3 {
    margin: 0 0 var(--space-3);
  }

  .done p {
    margin: 0;
  }

  @media screen and (max-width: 479px) {
    .fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  // Sends the form as a CORS simple request (POST, form-urlencoded, no custom
  // headers) to the form's `action` (site.ts endpoint) and sets the wrapper's
  // data-state: "sending" ("Đang gửi…" on the button), then "done" on success or
  // "fail" on any error or an empty endpoint (form and values kept). Native
  // validation runs first: `submit` fires only when valid. "Gửi lời nhắn khác"
  // empties the form and shows it again.
  const TIMEOUT_MS = 30000;

  async function send(endpoint: string, body: URLSearchParams): Promise<boolean> {
    if (!endpoint) return false;
    try {
      const response = await fetch(endpoint, { method: "POST", body, signal: AbortSignal.timeout(TIMEOUT_MS) });
      if (!response.ok) return false;
      const result = await response.json();
      return result?.ok === true;
    } catch {
      return false;
    }
  }

  for (const wrapper of document.querySelectorAll<HTMLElement>("[data-contact-form]")) {
    const form = wrapper.querySelector("form")!;
    const button = form.querySelector<HTMLInputElement>('input[type="submit"]')!;
    const label = button.value;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      // A state, not `disabled`: a disabled button would change its look while sending.
      if (wrapper.dataset.state === "sending") return;
      wrapper.dataset.state = "sending";
      button.value = button.dataset.wait ?? label;

      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      body.set("page", location.pathname);
      const ok = await send(form.getAttribute("action") ?? "", body);

      button.value = label;
      wrapper.dataset.state = ok ? "done" : "fail";
    });

    wrapper.querySelector(".again")!.addEventListener("click", () => {
      form.reset();
      delete wrapper.dataset.state;
      form.querySelector<HTMLInputElement>('[name="name"]')!.focus();
    });
  }
</script>
