---
/*
  Widget: ContactForm, the contact form wired to the Apps Script endpoint in site.ts
  (backend contract: apps-script/Code.gs).

    variant "section" (default): the form inside ContactSection (index, ve-chung-toi,
      khoa-hoc, trai-he-toan-hoc-pima): multi-line "Nội dung", name and phone fields
      38px tall, email and organization 44px (as the old site had it).
    variant "lien-he": lien-he's form: single-line "Nội dung", every field 44px.

  State is the wrapper's `data-state`, set by the script below and read by the CSS:
    (none)   the form
    sending  the form, its button reading "Đang gửi…"
    done     the success message (role="status") instead of the form
    fail     the form, values kept, and the error message (role="alert") under it
  Without JS the browser posts the form straight to the endpoint.
*/
import { contact, contactFormEndpoint } from "../data/site";

interface Props {
  variant?: "section" | "lien-he";
}

const { variant = "section" } = Astro.props;
const isSection = variant === "section";

// Field heights: the section form alternates 38px and 44px fields; lien-he's are all 44px.
const field = (tallInSection: boolean) => ["field", { tall: !isSection || tallInSection }];
---

<div class="contact-form" data-contact-form>
  {/* action + method: without JS the browser posts straight to the Apps Script. */}
  <form class="form" action={contactFormEndpoint || undefined} method="post">
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <div class="fields">
      <div>
        <label for="contact-name">Họ và tên (*)</label><input
          class:list={field(false)}
          maxlength="256"
          name="name"
          placeholder="Nhập họ và tên của bạn"
          type="text"
          id="contact-name"
          autocomplete="name"
          required
        />
      </div>
      <div>
        <label for="contact-email">Email (*)</label><input
          class:list={field(true)}
          maxlength="256"
          name="email"
          placeholder="Nhập email của bạn"
          type="email"
          id="contact-email"
          autocomplete="email"
          required
        />
      </div>
      <div>
        <label for="contact-phone">Số điện thoại</label><input
          class:list={field(false)}
          maxlength="256"
          name="phone"
          placeholder="Nhập số điện thoại của bạn"
          type="tel"
          id="contact-phone"
          autocomplete="tel"
        />
      </div>
      <div>
        <label for="contact-organization">Đơn vị/Tổ chức</label><input
          class:list={field(true)}
          maxlength="256"
          name="organization"
          placeholder="Nhập tên đơn vị công tác"
          type="text"
          id="contact-organization"
          autocomplete="organization"
        />
      </div>
      <div class="message">
        <label for="contact-message">Nội dung liên hệ (*)</label>{
          isSection ? (
            <textarea
              required
              placeholder="Nhập nội dung"
              maxlength="5000"
              id="contact-message"
              name="message"
              class="field area"
            />
          ) : (
            <input
              class:list={field(true)}
              maxlength="256"
              name="message"
              placeholder="Nhập nội dung lời nhắn"
              type="text"
              id="contact-message"
              required
            />
          )
        }
      </div>
    </div>
    {/* Honeypot: hidden from people and screen readers; Code.gs drops any submission that fills it. */}
    <div class="honeypot" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="actions">
      <input type="submit" data-wait="Đang gửi…" class="submit" value="Gửi yêu cầu" />
    </div>
  </form>
  <div class="done" role="status">
    <div>Lời nhắn của bạn đã được gửi đi!</div>
  </div>
  <div class="fail" role="alert">
    <div>
      Chưa gửi được lời nhắn. Bạn vui lòng thử lại, hoặc liên hệ PiMA qua email <a href={contact.emailHref}
        >{contact.email}</a
      > hoặc số điện thoại <a href={contact.phoneHref} class="nowrap">{contact.phone}</a>.
    </div>
  </div>
</div>

<style>
  .contact-form {
    margin: 0 0 15px;
  }

  .fields {
    display: grid;
    grid-template-rows: auto auto;
    grid-template-columns: 1fr 1fr;
    grid-auto-columns: 1fr;
    gap: 16px;
  }

  .message {
    grid-column: span 2;
  }

  .field {
    display: block;
    width: 100%;
    height: 38px;
    margin-bottom: 10px;
    padding: 8px 12px;
    border: 1px solid var(--color-border-field);
    border-radius: var(--radius);
    background-color: var(--color-background);
    color: var(--color-text);
    font-size: var(--font-size-small);
    line-height: var(--line-height-field);
    vertical-align: middle;
  }

  .field::placeholder {
    color: var(--color-text-placeholder);
  }

  .field:focus {
    border-color: var(--color-border-field-focus);
    outline: 0;
  }

  .tall {
    min-height: 44px;
  }

  .area {
    height: auto;
    border-radius: var(--radius);
    overflow: visible;
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .actions {
    margin-top: 2rem;
    text-align: left;
  }

  .submit {
    display: inline-block;
    padding: 9px 2rem;
    border: 0;
    border-radius: var(--radius);
    background-color: var(--color-button-primary);
    color: var(--color-button-primary-text);
    font-weight: var(--font-weight-bold);
    line-height: inherit;
    text-decoration: none;
    cursor: pointer;
    -webkit-appearance: button;
  }

  .done,
  .fail {
    display: none;
  }

  .done {
    padding: 20px;
    background-color: var(--color-background-pale-lime);
    text-align: center;
  }

  .fail {
    margin-top: 10px;
    padding: 10px;
    background-color: var(--color-background-form-error);
  }

  [data-state="done"] > .form {
    display: none;
  }

  [data-state="done"] > .done,
  [data-state="fail"] > .fail {
    display: block;
  }

  .nowrap {
    white-space: nowrap;
  }

  @media screen and (max-width: 479px) {
    .fields {
      display: block;
    }
  }
</style>

<script>
  // Sends the form as a CORS simple request (POST, form-urlencoded, no custom
  // headers) to the form's `action` (site.ts endpoint) and sets the wrapper's
  // data-state: "sending" ("Đang gửi…" on the button), then "done" on success or
  // "fail" on any error or an empty endpoint (form and values kept). Native
  // validation runs first: `submit` fires only when valid.
  const TIMEOUT_MS = 30000;

  async function send(endpoint: string, body: URLSearchParams): Promise<boolean> {
    if (!endpoint) return false;
    try {
      const response = await fetch(endpoint, { method: "POST", body, signal: AbortSignal.timeout(TIMEOUT_MS) });
      if (!response.ok) return false;
      const result = await response.json();
      return result?.ok === true;
    } catch {
      return false;
    }
  }

  for (const wrapper of document.querySelectorAll<HTMLElement>("[data-contact-form]")) {
    const form = wrapper.querySelector("form")!;
    const button = form.querySelector<HTMLInputElement>('input[type="submit"]')!;
    const label = button.value;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      // A state, not `disabled`: a disabled button would change its look while sending.
      if (wrapper.dataset.state === "sending") return;
      wrapper.dataset.state = "sending";
      button.value = button.dataset.wait ?? label;

      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      body.set("page", location.pathname);
      const ok = await send(form.getAttribute("action") ?? "", body);

      button.value = label;
      wrapper.dataset.state = ok ? "done" : "fail";
    });
  }
</script>
