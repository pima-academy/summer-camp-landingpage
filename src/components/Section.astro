---
/*
  Primitive: Section, the outer frame of every section (a full-width band of a page).
  Every file in src/sections/ renders its content through it.

  Renders <section data-section="<name>"> with the page gutter (5 % each side), a
  centred content column of the given `width` and the vertical padding of the given
  `spacing`. It replaces the old `padding-global > container-* > padding-section-*`
  wrapper and reproduces its values:

    width   small 48rem | medium 64rem (default) | large 80rem max width
            (medium adds 1rem side padding at ≤ 767 px, none at ≤ 479 px)
    spacing none 0 | small 3rem (2rem ≤ 767) | medium 5rem (4rem ≤ 991, 3rem ≤ 767)
            (default) | large 7rem (6rem ≤ 991, 4rem ≤ 767), top and bottom

  `spacing="none"` is for sections whose content sets its own vertical padding.

  The section's background (and anything else about the band) is set in the section
  file's own CSS through `class`, which lands on the <section>:

    <Section name="founding-story" spacing="medium" animate class="story">…</Section>
    <style>.story { background-color: var(--color-background-dark-green); }</style>

  `name` is the section file's name in kebab case (FoundingStory.astro → "founding-story");
  scripts/sections.test.mjs checks it. Tests find sections by `data-section`.
*/
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  /** The section file's name in kebab case. */
  name: string;
  /** Max width of the content column. */
  width?: "small" | "medium" | "large";
  /** Vertical padding of the content column. */
  spacing?: "none" | "small" | "medium" | "large";
  /** Fade the section up the first time it scrolls into view (src/lib/animate.ts). */
  animate?: boolean;
}

const { name, width = "medium", spacing = "medium", animate = false, class: className, ...attrs } = Astro.props;
---

<section data-section={name} data-animate={animate ? "fade-up" : undefined} class:list={["band", className]} {...attrs}>
  <div class="column" data-width={width} data-spacing={spacing}>
    <slot />
  </div>
</section>

<style>
  .band {
    padding-left: 5%;
    padding-right: 5%;
  }

  .column {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .column[data-width="small"] {
    max-width: 48rem;
  }

  .column[data-width="medium"] {
    max-width: 64rem;
  }

  .column[data-width="large"] {
    max-width: 80rem;
  }

  .column[data-spacing="small"] {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .column[data-spacing="medium"] {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .column[data-spacing="large"] {
    padding-top: 7rem;
    padding-bottom: 7rem;
  }

  @media screen and (max-width: 991px) {
    .column[data-spacing="medium"] {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .column[data-spacing="large"] {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }
  }

  @media screen and (max-width: 767px) {
    .column[data-width="medium"] {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .column[data-spacing="small"] {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .column[data-spacing="medium"] {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .column[data-spacing="large"] {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }

  @media screen and (max-width: 479px) {
    .column[data-width="medium"] {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
